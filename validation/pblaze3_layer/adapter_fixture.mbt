///|
priv struct AdapterMemory {
  address : UInt64
  words : Array[UInt32]
} derive(FromJson)

///|
priv struct AdapterFixture {
  schema : String
  source_program : String
  program_words : Array[UInt32]
  assets : Array[AdapterMemory]
  outputs : Array[AdapterMemory]
} derive(FromJson)

///|
fn adapter_range(memory : AdapterMemory) -> Unit raise {
  assert_true(memory.words.length() > 0 && memory.words.length() <= 4096)
  assert_true(memory.address % 4UL == 0UL && memory.address < 0x80000000UL)
  assert_true(
    memory.words.length().to_uint64() * 4UL <= 0x80000000UL - memory.address,
  )
}

///|
/// Execute a serialized external-adapter fixture against the unchanged actual
/// core/controller/AXI composition. No LunaFlux package or schema enters RTL.
pub fn run_adapter_fixture(text : String) -> String raise {
  exercise_adapter(bench(), text)
}

///|
pub fn adapter_replay_bundle(
  text : String,
) -> ReadOnlyArray[@projection.Artifact] raise {
  let b = bench(recording=true)
  let result = exercise_adapter(b, text)
  let files = bench_bundle(
      b, text, "LunaFlux adapter-generated FP32 vectors and BF16-weight ordered GEMV; actual core/controller/AXI; no physical or full-model claim",
    )
    .iter()
    .to_array()
  files.push({ path: "adapter-result.json", content: result, })
  ReadOnlyArray::from_array(files)
}

///|
fn exercise_adapter(b : Bench, text : String) -> String raise {
  assert_true(text.length() <= 1048576)
  let fixture : AdapterFixture = @json.from_json(@json.parse(text))
  assert_eq(fixture.schema, "lunachip.adapter-fixture/v1")
  assert_eq(fixture.source_program.length(), 64)
  let words = fixture.program_words
  assert_true(
    words.length() >= 32 &&
    words.length() <= 2048 * 16 &&
    words.length() % 16 == 0,
  )
  assert_true(fixture.assets.length() > 0 && fixture.assets.length() <= 32)
  assert_true(fixture.outputs.length() > 0 && fixture.outputs.length() <= 32)
  for i in 0..<(words.length() / 16) {
    assert_true(words[i * 16] <= 15U)
    assert_eq(words[i * 16] == 0U, i == words.length() / 16 - 1)
  }
  for asset in fixture.assets {
    adapter_range(asset)
    for i, word in asset.words {
      b.memory[asset.address + i.to_uint64() * 4UL] = word.to_uint64()
    }
  }
  let guards : Array[(UInt64, UInt64)] = []
  for output in fixture.outputs {
    adapter_range(output)
    for i in 0..<output.words.length() {
      b.memory[output.address + i.to_uint64() * 4UL] = 0x7fc00000UL
    }
    let end = output.address + output.words.length().to_uint64() * 4UL
    if output.address >= 4UL {
      guards.push((output.address - 4UL, b.word(output.address - 4UL)))
    }
    if end < 0x80000000UL {
      guards.push((end, b.word(end)))
    }
  }
  b.upload(words)
  let previous = b.read(0x38UL)
  b.write(0x10UL, 1UL)
  b.complete(polls=100000)
  assert_eq(b.read(0x38UL), previous + 1UL)
  assert_eq(b.read(0x14UL), (words.length() / 16).to_uint64())
  let mut checked = 0
  for output in fixture.outputs {
    for i, expected in output.words {
      assert_eq(
        b.word(output.address + i.to_uint64() * 4UL),
        expected.to_uint64(),
      )
      checked += 1
    }
  }
  for (address, expected) in guards {
    assert_eq(b.word(address), expected)
  }
  let result : Json = {
    "schema": "lunachip.adapter-simulation/v1",
    "status": "PASS",
    "source_program": fixture.source_program,
    "descriptors": words.length() / 16,
    "checked_fp32_words": checked,
    "preserved_guard_words": guards.length(),
    "simulation_edges": b.cycle,
    "axi_read_beats": b.reads,
    "axi_write_beats": b.writes,
    "scope": "Actual LunaWave core/controller/AXI with seeded backpressure; exact adapter-generated bytes and FP32 outputs. No physical FPGA or full-model inference claim.",
  }
  result.stringify(indent=2) + "\n"
}

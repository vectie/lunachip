import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
}

fn quote(s : String) -> String { "'" + s.replace_all(old="'",new="'\"'\"'") + "'" }

fn fields(lite : Bool) -> Array[(String, Int, Bool)] {
  let result : Array[(String, Int, Bool)] = []
  for prefix in ["AW", "AR"] {
    result.push((prefix + "ADDR", 32, true))
    result.push((prefix + "VALID", 1, true))
    result.push((prefix + "READY", 1, false))
    result.push((prefix + "PROT", 3, true))
    if !lite {
      for (suffix,width) in [("ID",5),("LEN",8),("SIZE",3),("BURST",2),("LOCK",1),("CACHE",4),("QOS",4)] {
        result.push((prefix+suffix,width,true))
      }
    }
  }
  for item in [("WVALID",1,true),("WREADY",1,false),("WDATA",if lite {32} else {128},true),("WSTRB",if lite {4} else {16},true),("BVALID",1,false),("BREADY",1,true),("BRESP",2,false),("RVALID",1,false),("RREADY",1,true),("RRESP",2,false),("RDATA",if lite {32} else {128},false)] {result.push(item)}
  if !lite { for item in [("WLAST",1,true),("BID",5,false),("RID",5,false),("RLAST",1,false)] {result.push(item)} }
  result
}

fn source(lite : Bool) -> String {
  let kind = if lite { "lite" } else { "full" }
  let protocol = if lite { "AXI4LITE" } else { "AXI4" }
  let channels = fields(lite)
  let out = StringBuilder()
  for mode in ["master", "slave", "monitor"] {
    out.write_string("module \{kind}_\{mode}(\n")
    out.write_string("(* X_INTERFACE_INFO = \"xilinx.com:signal:clock:1.0 clk CLK\", X_INTERFACE_PARAMETER = \"XIL_INTERFACENAME clk, ASSOCIATED_BUSIF AXI, FREQ_HZ 200000000\" *) input wire clk,\n")
    for index,(name,width,from_master) in channels {
      let direction = if mode == "monitor" { "input" } else if (mode == "master") == from_master { "output" } else { "input" }
      let extra = if index == 0 {", X_INTERFACE_MODE = \"\{mode}\", X_INTERFACE_PARAMETER = \"XIL_INTERFACENAME AXI, PROTOCOL \{protocol}, ADDR_WIDTH 32, DATA_WIDTH \{if lite {32} else {128}}, ID_WIDTH \{if lite {0} else {5}}\""} else {""}
      let range = if width == 1 {""} else {"[\{width-1}:0] "}
      out.write_string("(* X_INTERFACE_INFO = \"xilinx.com:interface:aximm:1.0 AXI \{name}\"\{extra} *) \{direction} wire \{range}\{name},\n")
    }
    let width = channels.fold(init=0,(sum,f)=>sum+f.1)
    out.write_string("output wire [\{width-1}:0] captured);\n")
    out.write_string("assign captured = {"+channels.rev().map(f=>f.0).join(",")+"};\n")
    if mode != "monitor" {
      for (name,width,from_master) in channels {
        if (mode == "master") == from_master {out.write_string("assign \{name} = \{width}'d0;\n")}
      }
    }
    out.write_string("endmodule\n")
  }
  out.to_string()
}


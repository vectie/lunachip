import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
}
fn quote(text : String) -> String { "'" + text.replace_all(old="'", new="'\"'\"'") + "'" }
async fn main {
  let source = @fs.read_file("/tmp/lunachip-pblaze3-smoke-20261-20261026-a3/build.tcl").text()
  let guard_source = source.split("# Vivado 2025.2 post-generate_target assertion.").next().unwrap().to_owned()
  guard guard_source.contains("proc pblaze_assert_cache_logs") && guard_source.contains("$token eq $key") else { fail("missing exact-token cache helper") }
  let body =
    #|if {[catch {
    #|set previous /work/builds/pblaze3-work-20261026-v20261-build-a1
    #|set cache $previous/project/pblaze3.cache/ip
    #|set count [pblaze_assert_cache_logs $cache $previous stdout]
    #|if {$count != 8} {error "expected 8 actual cache entries, found $count"}
    #|puts "REVIEW_EXACT_CACHE_POSITIVE_COUNT=$count"
    #|set source [lindex [lsort [glob $cache/2026.1/*/*/*/*.dcp]] 0]
    #|set key [file tail [file dirname $source]]
    #|set truncated [string range $key 0 end-1]
    #|set ip [file rootname [file tail $source]]
    #|set fixture /work/builds/pblaze3-review-cacheguard-exact-20261026-a1
    #|if {[file exists $fixture]} {error {fixture path already exists}}
    #|file mkdir $fixture/$truncated
    #|set channel [open $fixture/$truncated/$ip.dcp {WRONLY CREAT EXCL}]
    #|puts $channel {Negative-control placeholder only; not a Vivado checkpoint.}
    #|close $channel
    #|if {![catch {pblaze_assert_cache_logs $fixture $previous stdout} reason]} {error {truncated producer key accepted}}
    #|puts "REVIEW_EXACT_CACHE_NEGATIVE_PREFIX full=$key truncated=$truncated reason=$reason"
    #|if {![string match {cache key has no original successful producer:*} $reason]} {error {wrong truncated-key failure}}
    #|puts REVIEW_EXACT_CACHE_GUARD_PASS
    #|exit 0
    #|} failure]} {puts "REVIEW_EXACT_CACHE_GUARD_ERROR=$failure"; exit 1}
    #|
  let script = guard_source + "\n" + body
  @fs.write_file("/tmp/pblaze3-review-cache-guard-exact-a1.tcl", script, create_mode=CreateNew)
  @fs.write_file("/tmp/pblaze3-review-cache-guard-exact-helper.tcl", guard_source, create_mode=CreateNew)
  let relay = ["ssh", "-i", "/data/lunachip-prx100/vm/id_ed25519", "-o", "UserKnownHostsFile=/data/lunachip-prx100/vm/known_hosts", "-p", "22240", "builder@127.0.0.1", "/usr/bin/tclsh"].map(quote).join(" ")
  let result = @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-p", "32123", "HwHiAiUser@106.39.18.146", relay], stdin=Text(script)).output(timeout_ms=60000)
  @fs.write_file("/tmp/pblaze3-review-cache-guard-exact-a1.stdout", result.stdout(), create_mode=CreateNew)
  @fs.write_file("/tmp/pblaze3-review-cache-guard-exact-a1.stderr", result.stderr(), create_mode=CreateNew)
  println(result.stdout())
  result.check()
}

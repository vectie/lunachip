import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.1/crypto",
}
fn digest(bytes : Bytes) -> String { @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) }
fn supervisor_part(text : String) -> String {
  let pieces = text.split("SUPERVISOR_CLOCK=")
  let _ = pieces.next()
  pieces.next().unwrap().to_owned()
}
async fn main {
  let root = "/Users/kq/Workspace/lunachip/docs/evidence/pblaze3-supervisor-review-20261026-2026-1-a2"
  let prior = "/Users/kq/Workspace/lunachip/docs/evidence/pblaze3-supervisor-review-20261026-2026-1-a1"
  guard !@fs.exists(root) else { fail("fresh evidence archive required") }
  assert_eq(supervisor_part(@fs.read_file(prior + "/structure.txt").text()), supervisor_part(@fs.read_file("/tmp/pblaze3-review-supervisor-a10-synthesis-a1-structure.txt").text()))
  guard @fs.read_file("/tmp/pblaze3-review-supervisor-a10-synthesis-a1.stdout").text().contains("REVIEW_FRESH_SUPERVISOR_STRUCTURE_CAPTURED") else { fail("actual accelerator probe did not complete") }
  assert_eq(@fs.read_file(prior + "/probe.mbtx").binary(), @fs.read_file("/tmp/pblaze3-supervisor-review.mbtx").binary())
  let sources = [
    ("review.md", "/tmp/pblaze3-supervisor-accelerator-review.md"),
    ("probe.tcl", "/tmp/pblaze3-review-supervisor-a10-synthesis-a1.tcl"),
    ("probe.stdout", "/tmp/pblaze3-review-supervisor-a10-synthesis-a1.stdout"),
    ("probe.stderr", "/tmp/pblaze3-review-supervisor-a10-synthesis-a1.stderr"),
    ("structure.txt", "/tmp/pblaze3-review-supervisor-a10-synthesis-a1-structure.txt"),
    ("applied-constraints.xdc", "/tmp/pblaze3-review-supervisor-a10-synthesis-a1-applied-constraints.xdc"),
    ("retain.mbtx", "/tmp/pblaze3-supervisor-accelerator-retain.mbtx"),
  ]
  @fs.mkdir(root, recursive=true)
  let sums = StringBuilder()
  let files : Array[Json] = []
  for (name, source) in sources {
    let bytes = @fs.read_file(source).binary()
    @fs.write_file(root + "/" + name, bytes, create_mode=CreateNew)
    assert_eq(@fs.read_file(root + "/" + name).binary(), bytes)
    let hash = digest(bytes)
    sums.write_string(hash + "  " + name + "\n")
    files.push({"path": name, "source": source, "sha256": hash, "bytes": bytes.length()})
  }
  let manifest : Json = {
    "schema": "lunachip.pblaze3-supervisor-review/v1",
    "scope": "Fresh a10 linked synthesis mapped reset structure; no routed or physical-board acceptance",
    "build": "20261026-v20261-build-a10",
    "inputs": "artifacts/pblaze3-ready-inputs-20261026-2026-1-a5",
    "tool": {"version": "2026.1", "sw_build": "6511674", "ip_build": "6504888"},
    "results": {"mapped_supervisor": "PASS byte-identical supervisor snapshot to independently reviewed fresh a9", "fresh_synthesis_boundary": "PASS exact10 with dead-only extras", "independent_clock": "PASS20.000ns generated from primary20.000ns", "routed_timing_cdc": "PENDING"},
    "shared_evidence": {"path": prior, "manifest_sha256": digest(@fs.read_file(prior + "/manifest.json").binary()), "probe_driver_sha256": digest(@fs.read_file(prior + "/probe.mbtx").binary())},
    "files": files,
  }
  let manifest_text = manifest.stringify(indent=2) + "\n"
  @fs.write_file(root + "/manifest.json", manifest_text, create_mode=CreateNew)
  sums.write_string(digest(@utf8.encode(manifest_text)) + "  manifest.json\n")
  @fs.write_file(root + "/SHA256SUMS", sums.to_string(), create_mode=CreateNew)
  let seal = digest(@utf8.encode(sums.to_string()))
  @fs.write_file(root + "/SEAL.sha256", seal + "  SHA256SUMS\n", create_mode=CreateNew)
  println("ARCHIVE=" + root)
  println("MANIFEST_SHA256=" + digest(@utf8.encode(manifest_text)))
  println("SHA256SUMS_SHA256=" + seal)
}

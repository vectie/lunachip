import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.1/crypto",
}
fn digest(bytes : Bytes) -> String { @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) }
async fn main {
  let root = "/Users/kq/Workspace/lunachip/docs/evidence/pblaze3-supervisor-review-20261026-2026-1-a1"
  guard !@fs.exists(root) else { fail("fresh evidence archive required") }
  let ready = "/Users/kq/Workspace/lunachip/artifacts/pblaze3-ready-inputs-20261026-2026-1-a5/smoke"
  let normalized = @fs.read_file(ready + "/pblaze3_transport_reset_core.sv").text()
  let ordinary = @fs.read_file(ready + "/pblaze3_transport_reset_core-ordinary.sv").text()
  assert_eq(normalized.replace_all(old="  input wire logic ", new="  input logic "), ordinary)
  let actual = @fs.read_file("/tmp/pblaze3-review-supervisor-a9-synthesis-a1.stdout").text()
  guard actual.contains("REVIEW_FRESH_SUPERVISOR_STRUCTURE_CAPTURED") else { fail("fresh actual-tool probe did not complete") }
  let sources = [
    ("review.md", "/tmp/pblaze3-supervisor-synthesis-review.md"),
    ("probe.mbtx", "/tmp/pblaze3-supervisor-review.mbtx"),
    ("probe.tcl", "/tmp/pblaze3-review-supervisor-a9-synthesis-a1.tcl"),
    ("probe.stdout", "/tmp/pblaze3-review-supervisor-a9-synthesis-a1.stdout"),
    ("probe.stderr", "/tmp/pblaze3-review-supervisor-a9-synthesis-a1.stderr"),
    ("structure.txt", "/tmp/pblaze3-review-supervisor-a9-synthesis-a1-structure.txt"),
    ("applied-constraints.xdc", "/tmp/pblaze3-review-supervisor-a9-synthesis-a1-applied-constraints.xdc"),
    ("fetch.mbtx", "/tmp/pblaze3-routed-fetch.mbtx"),
    ("retain.mbtx", "/tmp/pblaze3-supervisor-synthesis-retain.mbtx"),
  ]
  let identities : Array[Json] = []
  for source in [ready + "/pblaze3_transport_reset_core.sv", ready + "/pblaze3_transport_reset_core-ordinary.sv", ready + "/pblaze3_transport_reset.sv", ready + "/reset-boundary.xdc", ready + "/build.tcl", "/tmp/pblaze3-reset-boundary-guard.tcl"] {
    let bytes = @fs.read_file(source).binary()
    identities.push({"path": source, "sha256": digest(bytes), "bytes": bytes.length(), "retained_here": false})
  }
  @fs.mkdir(root, recursive=true)
  let sums = StringBuilder()
  let files : Array[Json] = []
  for (name, source) in sources {
    let bytes = @fs.read_file(source).binary()
    @fs.write_file(root + "/" + name, bytes, create_mode=CreateNew)
    assert_eq(@fs.read_file(root + "/" + name).binary(), bytes)
    let hash = digest(bytes)
    sums.write_string(hash + "  " + name + "\n")
    files.push({"path": name, "source": source, "sha256": hash, "bytes": bytes.length()})
  }
  let manifest : Json = {
    "schema": "lunachip.pblaze3-supervisor-review/v1",
    "scope": "Fresh a9 linked synthesis mapped reset structure; no routed or physical-board acceptance",
    "build": "20261026-v20261-build-a9",
    "inputs": "artifacts/pblaze3-ready-inputs-20261026-2026-1-a5",
    "tool": {"version": "2026.1", "sw_build": "6511674", "ip_build": "6504888"},
    "results": {"mapped_supervisor": "PASS", "fresh_synthesis_boundary": "PASS exact10 with dead-only extras", "independent_clock": "PASS20.000ns generated from primary20.000ns", "ordinary_source_normalization": "PASS exact inverse", "routed_timing_cdc": "PENDING", "accelerator_a10": "PENDING"},
    "files": files,
    "source_identities": identities,
  }
  let manifest_text = manifest.stringify(indent=2) + "\n"
  @fs.write_file(root + "/manifest.json", manifest_text, create_mode=CreateNew)
  sums.write_string(digest(@utf8.encode(manifest_text)) + "  manifest.json\n")
  @fs.write_file(root + "/SHA256SUMS", sums.to_string(), create_mode=CreateNew)
  let seal = digest(@utf8.encode(sums.to_string()))
  @fs.write_file(root + "/SEAL.sha256", seal + "  SHA256SUMS\n", create_mode=CreateNew)
  println("ARCHIVE=" + root)
  println("MANIFEST_SHA256=" + digest(@utf8.encode(manifest_text)))
  println("SHA256SUMS_SHA256=" + seal)
}

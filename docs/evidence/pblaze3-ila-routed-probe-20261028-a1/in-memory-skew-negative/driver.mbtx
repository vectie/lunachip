    #|exit 0
    #|
  @fs.write_file(root + "/probe.tcl", tcl, create_mode=CreateNew)
  @fs.write_file(root + "/driver.mbtx", @fs.read_file("/tmp/pblaze3-ila-skew-negative-20261028.mbtx"), create_mode=CreateNew)
  let guest = ["/tools/amd-2026.1/2026.1/Vivado/bin/vivado", "-mode", "tcl", "-nojournal", "-nolog"].map(quote).join(" ")
  let relay = ["ssh", "-i", "/data/lunachip-prx100/vm/id_ed25519", "-o", "BatchMode=yes", "-o", "UserKnownHostsFile=/data/lunachip-prx100/vm/known_hosts", "-p", "22240", "builder@127.0.0.1", guest].map(quote).join(" ")
  let result = @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-p", "32123", "HwHiAiUser@106.39.18.146", relay], stdin=Text(tcl)).output(timeout_ms=180000)
  @fs.write_file(root + "/stdout.log", result.stdout(), create_mode=CreateNew)

import {
  "moonbitlang/async@0.22.4", "moonbitlang/async@0.22.4/fs", "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/json", "moonbitlang/core/encoding/utf8", "moonbitlang/x@0.5.1/crypto",
}
fn hash(bytes : Bytes) -> String { @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) }
fn cdc_rows(text : String) -> Array[String] {
  let rows : Array[String] = []
  let mut source = ""
  let mut dest = ""
  let mut kind = ""
  for line in text.split("\n") {
    if line.has_prefix("Source Clock:") { source = line.to_owned() }
    if line.has_prefix("Destination Clock:") { dest = line.to_owned() }
    if line.has_prefix("CDC Type:") { kind = line.to_owned() }
    let words = line.split(" ").filter(x => x != "").to_array()
    if words.length() > 1 && words[1].has_prefix("CDC-") {
      rows.push(source + "|" + dest + "|" + kind + "|" + words[1:].map(x => x.to_owned()).join(" "))
    }
  }
  rows.sort()
  rows
}
async fn main {
  let archive = "/Users/kq/Workspace/lunachip/artifacts/pblaze3-ila-finalized-mig-20261028-a1"
  let outputs = archive + "/build/outputs"
  let probe = "/tmp/pblaze3-ila-routed-flags-mig-reroute-a1"
  let out = "/Users/kq/Workspace/lunachip/docs/evidence/pblaze3-ila-mig-final-review-20261028-a1"
  guard !@fs.exists(out) else { fail("fresh archive required") }
  @shell.Cmd("shasum", ["-a", "256", "-c", "SHA256SUMS"], cwd=archive).output().check()
  @shell.Cmd("shasum", ["-a", "256", "-c", "SEAL.sha256"], cwd=archive).output().check()
  assert_eq(@fs.read_file(probe + "/exit.txt").text(), "0\n")
  let log = @fs.read_file(probe + "/stdout.log").text()
  let dcp = "3c4b2da78c051bb3ab4cc296c7ddd611670142460b7745baa401bb7624500cab"
  for needle in ["DCP_BEFORE=" + dcp,"DCP_AFTER=" + dcp,"LOCAL_FLAG_MAPPING_REVIEW=PASS","TRANSPORT_RESET_BOUNDARY_PASS phase=routed","RAW_OSCILLATOR_CLOCK=PASS","DIAGNOSTIC_PHYSICAL=PASS"] { assert_eq(log.split(needle).count(), 2) }
  assert_eq(@fs.read_file(probe + "/routed.ltx").binary(), @fs.read_file(outputs + "/pblaze3.ltx").binary())
  assert_eq(@fs.read_file(probe + "/diagnostic.json").binary(), @fs.read_file(archive + "/diagnostic.json").binary())
  assert_eq(hash(@fs.read_file(probe + "/diagnostic.json").binary()), "e622701817972823f98afdbd192173c40f7e79c9690304e2356df30e7cdd07a3")
  let final_cdc = cdc_rows(@fs.read_file(outputs + "/cdc.rpt").text())
  assert_eq(final_cdc, cdc_rows(@fs.read_file(probe + "/cdc.rpt").text()))
  let delta = @shell.Cmd("moon", ["run", "/tmp/pblaze3-ila-cdc-delta-20261028.mbtx", "docs/evidence/pblaze3-single-mig-ila-routed-review-20261028-a1/cdc.rpt", outputs + "/cdc.rpt"]).output()
  delta.check()
  assert_eq(delta.stdout().split("ADDED_ROWS=1\n").count(), 2)
  assert_eq(delta.stdout().split("\nREMOVED ").count(), 2)
  for line in delta.stdout().split("\n") {
    if line.has_prefix("ADDED ") || line.has_prefix("REMOVED ") {
      assert_true(line.contains("Source Clock: clk_in1_50M | Destination Clock: clk_pll_i | CDC Type: User Ignored | CDC-3 Info 1-bit synchronized with ASYNC_REG property 2 False Path pblaze3_i/ila_mig200/inst/<hidden>"))
    }
  }
  let baseline = @shell.Cmd("moon", ["run", "/tmp/pblaze3-ila-cdc-delta-20261028.mbtx", "artifacts/pblaze3-finalized-smoke-20261026-a1/probes/smoke-finalization/outputs/cdc.rpt", outputs + "/cdc.rpt"]).output()
  baseline.check()
  assert_eq(baseline.stdout().split("REMOVED ").count(), 1)
  assert_eq(baseline.stdout().split("ADDED_ROWS=70\n").count(), 2)
  assert_eq(final_cdc.length(), 122)
  let before = @fs.read_file(outputs + "/constraints-before.xdc").text()
  let after = @fs.read_file(outputs + "/applied-constraints.xdc").text()
  assert_eq(before.replace_all(old="# Command Used: write_xdc -force constraints-before.xdc", new="# Command Used: write_xdc -force applied-constraints.xdc"), after)
  let final_log = @fs.read_file(archive + "/build/vivado.stdout").text()
  assert_eq(final_log.split("\n").filter(line => line.has_prefix("WARNING:")).count(), 10)
  assert_false(final_log.split("\n").any(line => line.has_prefix("ERROR:") || line.has_prefix("CRITICAL WARNING:")))
  let physical = @fs.read_file(outputs + "/diagnostic-routed.txt").text()
  assert_eq(physical.split("\n").filter(x => x == "PBLAZE3_ILA_ROUTED_GUARD_COMPLETE").count(), 1)
  assert_true(@fs.read_file(outputs + "/BUILD_COMPLETE").binary().length() > 0)
  let inspect = @shell.Cmd("moon", ["run", "scripts/pblaze3-ila-check.mbtx", "inspect", archive + "/diagnostic.json", outputs + "/pblaze3.ltx"]).output()
  inspect.check()
  let refs : Array[Json] = []
  for path in [archive + "/SHA256SUMS",archive + "/SEAL.sha256",archive + "/build/vivado.stdout",archive + "/diagnostic.json"] { refs.push({"path":path,"sha256":hash(@fs.read_file(path).binary())}) }
  for name in ["pblaze3.bit","pblaze3.ltx","timing.rpt","bus-skew.rpt","pulse-width.rpt","cdc.rpt","drc.rpt","check-timing.rpt","diagnostic-routed.txt","reset-boundary-properties.txt","child-run-gates.txt","BUILD_COMPLETE","checkpoint-identities.sha256","constraints-before.xdc","applied-constraints.xdc"] { refs.push({"path":outputs + "/" + name,"sha256":hash(@fs.read_file(outputs + "/" + name).binary())}) }
  let readme =
    #|Independent final MIG-ILA review, 2026-10-28
    #|
    #|No new finalization blocker. The finalized archive inventory and seal were independently verified. This fresh routed probe used the accepted Explore-reroute candidate 3c4b2da78c051bb3ab4cc296c7ddd611670142460b7745baa401bb7624500cab; its bytes remained unchanged. Original timing-failed attempts remain immutable. The final bitstream/LTX/reports are referenced, not duplicated. Hardware was not accessed and module native cache was not used.
    #|
    #|Every actual constraint command is unchanged: constraints-before.xdc and applied-constraints.xdc differ only in the generated write_xdc output-filename comment. Final timing has WNS +0.024ns, WHS +0.015ns, WPWS 0 and zero failing endpoints. All 14 bus-skew constraints pass; minimum slack +3.436ns. No unclocked or unconstrained internal endpoints. The pre-existing external DDR DQS/PERST, DDR reset and LED timing caveats remain. Six ordinary DRC warnings remain PDCN-1569 x4 (three debug hub, one XDMA), REQP-1709 x1 (MIG PLL), RTSTAT-10 x1; there is no DRC Error or Critical Warning. Final process has ten ordinary warnings and no Error/Critical Warning. BUILD_COMPLETE and exact diagnostic routed completion marker are present.
    #|
    #|Fresh mapped proof passes exact raw50 oscillator IBUF/BUFG and hub clock ancestry, native UI 5ns ILA clock, exact one ILA UUID 83EA9068240D535FACE3158A36430D1E, depth1024, input pipeline1, probes53/147/8/50/137; independent reset supervisor20ns ancestry and guarded original reset roles plus strictly proven replicas. Flag bits50/51/52 retain exact source-to-monitor-to-ILA mappings and physical driver/reset properties. Calibrated and UI AXI reset-n are UI FDRE outputs; UI reset is a UI FDPE with asynchronous PRE from vendor ref_dll_lock. Consequently UI-reset assertion remains sampled asynchronous telemetry, with no guarantee of capturing every pulse or a coherent transaction-state snapshot. The UI clock can stop; raw50 status fallback remains necessary.
    #|
    #|All122 final CDC rows exactly match the fresh probe as multisets including clock pairs/type/severity/depth/exception/endpoints, ignoring row numbering/whitespace. Against the original failed route,121 rows match; one vendor-hidden ILA CDC3 Info row retains raw50-to-UI, depth2, False Path and its destination text, but source text renders with additional hidden hierarchy. Its underlying hidden identity cannot be independently equated. The exact difference is retained in original-route-cdc-delta.txt. All52 production rows still match exactly, with70 vendor debug-only additions. CDC totals remain Info3=61, Warning6=2, Warning8=3, Info9=15, Critical10=2, Critical12=4, Critical13=2, Warning15=33. Vendor ILA control vector synchronizers and one hidden combinational synchronizer are not independently proven CDC-clean. The timing recovery added no new CDC category or timing exception. Hardware Manager communication and capture remain pending.
    #|
    #|Fresh LTX bytes exactly match the final sealed LTX. Original a7 diagnostic pin e622701817972823f98afdbd192173c40f7e79c9690304e2356df30e7cdd07a3 is used throughout; the a8 limitations-only metadata delta is not silently substituted. Current LTX checker inspect passes. Root's separately retained binder performs the final image/layout/LTX/report association. Full digital correctness and real-board operation are distinct from this physical/debug review.
    #|
  @fs.mkdir(out)
  let sums : Array[String] = []
  for name in @fs.readdir(probe, sort=true) {
    let bytes = @fs.read_file(probe + "/" + name).binary()
    @fs.write_file(out + "/" + name, bytes, create_mode=CreateNew)
    sums.push(hash(bytes) + "  " + name)
  }
  let manifest : Json = {"schema":"lunachip.pblaze3-ila-mig-final-review/v1","result":"no new physical/debug finalization blocker","dcp_sha256":dcp,"hardware_execution":false,"native_module_cache_use":false,"references":refs}
  for (name, bytes) in [("README.md",@utf8.encode(readme)),("manifest.json",@utf8.encode(manifest.stringify(indent=2)+"\n")),("checker-result.json",@utf8.encode(inspect.stdout())),("checker-stderr.log",@utf8.encode(inspect.stderr())),("original-route-cdc-delta.txt",@utf8.encode(delta.stdout())),("production-cdc-delta.txt",@utf8.encode(baseline.stdout())),("cdc-delta.mbtx",@fs.read_file("/tmp/pblaze3-ila-cdc-delta-20261028.mbtx").binary()),("review.mbtx",@fs.read_file("/tmp/pblaze3-mig-final-review-retain-20261028.mbtx").binary())] {
    @fs.write_file(out + "/" + name, bytes, create_mode=CreateNew)
    sums.push(hash(bytes) + "  " + name)
  }
  let inventory = sums.join("\n") + "\n"
  @fs.write_file(out + "/SHA256SUMS", inventory, create_mode=CreateNew)
  @fs.write_file(out + "/SEAL.sha256", hash(@utf8.encode(inventory)) + "  SHA256SUMS\n", create_mode=CreateNew)
  for row in sums {
    let parts = row.split("  ").to_array()
    assert_eq(hash(@fs.read_file(out + "/" + parts[1].to_owned()).binary()),parts[0].to_owned())
  }
  println("ARCHIVE=" + out)
  println("FILES=" + sums.length().to_string())
  println("INVENTORY=" + hash(@utf8.encode(inventory)))
  println("MANIFEST=" + hash(@fs.read_file(out + "/manifest.json").binary()))
}

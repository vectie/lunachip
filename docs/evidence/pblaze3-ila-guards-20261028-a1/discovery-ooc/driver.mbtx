import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

fn quote(s : String) -> String {
  "'" + s.replace_all(old="'", new="'\"'\"'") + "'"
}

async fn main {
  let args = @env.args()
  guard args.length() == 4 else {
    fail("usage: SCRIPT LABEL dcp|project ABSOLUTE_PATH")
  }
  let label = args[1]
  guard label.to_array().all(c => (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') else {
    fail("unsafe label")
  }
  let path = args[3]
  guard path.has_prefix("/work/builds/") && !path.contains("}") && !path.contains("\n") else {
    fail("unexpected guest path")
  }
  let open = match args[2] {
    "dcp" => "open_checkpoint {\{path}}"
    "project" => "open_project -read_only {\{path}}\nopen_run synth_1"
    _ => fail("expected dcp or project")
  }
  let root = "/tmp/pblaze3-ila-netlist-" + label
  guard !@fs.exists(root) else { fail("fresh evidence required") }
  @fs.mkdir(root)
  let script =
    "if {[catch {\nset_param general.maxThreads 1\n" + open + "\n" +
    (
      #|puts "ILA_TOOL=[version]"
      #|puts "ILA_CORES=[get_debug_cores]"
      #|foreach core [get_debug_cores] {
      #|  puts "CORE_PROPERTIES_BEGIN $core"
      #|  puts [report_property -return_string $core]
      #|  puts "CORE_PROPERTIES_END $core"
      #|  foreach port [get_debug_ports -of_objects $core] {
      #|    puts "PORT_PROPERTIES_BEGIN $port"
      #|    puts [report_property -return_string $port]
      #|    puts "PORT_NETS=$port:[get_nets -segments -of_objects $port]"
      #|    puts "PORT_PROPERTIES_END $port"
      #|  }
      #|}
      #|foreach pattern {
      #|  */diagnostic_clock/inst/*
      #|  */diagnostic_status/inst/*
      #|  */ila_reset50/inst/clk
      #|  */ila_mig200/inst/clk
      #|  */ila_xdma250/inst/clk
      #|  */ila_core33/inst/clk
      #|  */clocks/core_clk
      #|  */mig/ui_clk
      #|  */xdma/axi_aclk
      #|} {
      #|  foreach pin [get_pins -hier -filter "NAME =~ $pattern"] {
      #|    if {[regexp {/(D|Q|C|CLK|I|O|clk|clock50|ui_clk|axi_aclk|core_clk|oscillator)$} $pin]} {
      #|      puts "PIN $pin NETS=[get_nets -segments -of_objects $pin] CLOCKS=[get_clocks -of_objects $pin]"
      #|    }
      #|  }
      #|}
      #|foreach cell [get_cells -hier -filter {NAME =~ */diagnostic_clock/inst/* || NAME =~ */diagnostic_status/inst/*}] {
      #|  puts "CELL_PROPERTIES_BEGIN $cell"
      #|  puts [report_property -return_string $cell]
      #|  puts "CELL_PROPERTIES_END $cell"
      #|}
      #|foreach clock [get_clocks] {
      #|  puts "CLOCK_PROPERTIES_BEGIN $clock"
      #|  puts [report_property -return_string $clock]
      #|  puts "CLOCK_PROPERTIES_END $clock"
      #|}
      #|puts "ILA_NETLIST_PROBE=PASS"
      #|} reason options]} {puts stderr "ILA_NETLIST_FAILED=$reason";puts stderr [dict get $options -errorinfo];exit 1}
      #|exit 0
      #|
    )
  let guest = ["/tools/amd-2026.1/2026.1/Vivado/bin/vivado", "-mode", "tcl", "-nojournal", "-nolog"].map(quote).join(" ")
  let relay = ["ssh", "-i", "/data/lunachip-prx100/vm/id_ed25519", "-o", "BatchMode=yes", "-o", "UserKnownHostsFile=/data/lunachip-prx100/vm/known_hosts", "-p", "22240", "builder@127.0.0.1", guest].map(quote).join(" ")
  @fs.write_file(root + "/probe.tcl", script, create_mode=CreateNew)
  @fs.write_file(root + "/driver.mbtx", @fs.read_file("/tmp/pblaze3-ila-netlist-probe-20261028.mbtx"), create_mode=CreateNew)
  let result = @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-p", "32123", "HwHiAiUser@106.39.18.146", relay], stdin=Text(script)).output(timeout_ms=180000)
  @fs.write_file(root + "/stdout.log", result.stdout(), create_mode=CreateNew)
  @fs.write_file(root + "/stderr.log", result.stderr(), create_mode=CreateNew)
  @fs.write_file(root + "/exit.txt", result.exit_code().to_string() + "\n", create_mode=CreateNew)
  println("retained=" + root)
  println(result.stderr())
  result.check()
}

import {
  "moonbitlang/async@0.22.4", "moonbitlang/async@0.22.4/fs", "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/json", "moonbitlang/core/encoding/utf8", "moonbitlang/x@0.5.1/crypto",
}
fn hash(b : Bytes) -> String { @crypto.bytes_to_hex_string(@crypto.sha256(b)) }
async fn main {
  let root = "/Users/kq/Workspace/lunachip/docs/evidence/pblaze3-single-mig-ila-opt-20261028-a1"
  let source = "/tmp/pblaze3-single-ila-opt-mig-a1"
  let before = "/tmp/lunachip-pblaze3-ila-export-20261028-a7/ddr-mig-ila"
  let after = "/tmp/lunachip-pblaze3-ila-export-20261028-a8/ddr-mig-ila"
  guard !@fs.exists(root) else { fail("fresh archive required") }
  assert_eq(@fs.read_file(source + "/exit.txt").text(), "0\n")
  assert_eq(@fs.read_file(before + "/build.tcl").binary(), @fs.read_file(after + "/build.tcl").binary())
  let checker = @shell.Cmd("moon", ["run", "scripts/pblaze3-ila-check.mbtx", "inspect", source + "/diagnostic.json", source + "/preview.ltx"]).output()
  checker.check()
  let old_layout = @json.parse(@fs.read_file(before + "/diagnostic.json").text())
  let new_layout = @json.parse(@fs.read_file(after + "/diagnostic.json").text())
  match (old_layout, new_layout) {
    (Object(old_fields), Object(new_fields)) => {
      old_fields["limitations"] = Json("")
      new_fields["limitations"] = Json("")
      assert_eq(old_layout, new_layout)
    }
    _ => fail("expected metadata objects")
  }
  @fs.mkdir(root)
  let sums : Array[String] = []
  let refs : Array[Json] = []
  for file in @fs.readdir(source, sort=true) {
    let bytes = @fs.read_file(source + "/" + file).binary()
    @fs.write_file(root + "/" + file, bytes, create_mode=CreateNew)
    sums.push(hash(bytes) + "  " + file)
    refs.push({"source":source + "/" + file,"retained":file,"sha256":hash(bytes)})
  }
  for (name, path) in [("actual-a7-diagnostic.json",before + "/diagnostic.json"),("checker.mbtx","scripts/pblaze3-ila-check.mbtx"),("metadata-equality.txt","/tmp/pblaze3-ila-metadata-delta-20261028-a1/receipt.txt")] {
    let bytes = @fs.read_file(path).binary()
    @fs.write_file(root + "/" + name, bytes, create_mode=CreateNew)
    sums.push(hash(bytes) + "  " + name)
    refs.push({"source":path,"retained":name,"sha256":hash(bytes)})
  }
  let readme =
    #|Independent single-MIG ILA optimized-checkpoint gate, 2026-10-28
    #|
    #|Actual Vivado2026.1 standalone probe passes on build20261028-mig-ila-build-a1 optimized DCP447eb4d381ca785f3eb973c8c5b3facb6046e28d229249d2b44dc3a1a2fa7b7b, unchanged before/after. This follows actual linked top synthesis accepting one ordinary five-probe ILA under BASIC. The optimized checkpoint is not final routed timing or image acceptance. No hardware was accessed, no module native cache or production source was changed, and no new bitstream was generated by this probe.
    #|
    #|The exact exported conditional physical helper verifies raw oscillator IBUF→BUFG ancestry and independent20ns primary clock at the50MHz debug hub, exact one-ILA set, depth1024, input pipeline1, and all five DATA_AND_TRIGGER ports. ILA capture clock shares the exact MIG ui_clk net, reported as clk_pll_i with period5.000ns. The AXI-only image deliberately has no raw50 status ILA or status synchronizer. The one selected ILA is pblaze3_i/ila_mig200, UUID83EA9068240D535FACE3158A36430D1E; widths53/147/8/50/137 represent AW/W/B/AR/R. AW bits50/51/52 are calibrated/UI-reset/UI-AXI-reset-n in the same UI domain. Passive interface attachment and production reset/transport are unchanged by selecting this one capture domain.
    #|
    #|Actual LTX SHAda99b2a76287b7857b6451a6a4c706ca26e33dbed59f97e84a2bbc276db2b398 contains the expected five ila_mig200_monitor_probe0..4 buses with exact descending subnets. The retained current checker runs successfully against the actual preview and pinned a8 layout SHA23fcbdb448fe75075044d7e1b5829e9b85a7eece41f83db6f647b4fd3f2ed8cc. The actual build used a7; build.tcl is byte-identical, and independent JSON equality after clearing only limitations confirms all other a7/a8 layout fields match. Actual a7 layout SHAe622701817972823f98afdbd192173c40f7e79c9690304e2356df30e7cdd07a3 is separately retained. Final build binding must retain its exact original layout pin and explicit metadata-only delta.
    #|
    #|No PBLAZE3_ILA_ROUTED_GUARD_COMPLETE or BUILD_COMPLETE marker is produced by this opt probe. Final routes, complete physical gates and exact bitstream/LTX binding remain pending. A running capture clock is necessary for ILA communication; use the separately accepted raw50 status image when the MIG UI clock is absent. No cross-image simultaneous capture is claimed.
    #|
  let manifest : Json = {"schema":"lunachip.single-mig-ila-opt/v1","scope":"actual optimized single-ILA physical helper and LTX layout inspection; no routed acceptance","references":refs,"hardware_execution":false,"native_module_cache_use":false}
  for (name, bytes) in [("README.md",@utf8.encode(readme)),("manifest.json",@utf8.encode(manifest.stringify(indent=2)+"\n")),("checker-result.json",@utf8.encode(checker.stdout())),("checker-stderr.log",@utf8.encode(checker.stderr())),("retain.mbtx",@fs.read_file("/tmp/pblaze3-single-mig-opt-retain-20261028.mbtx").binary())] {
    @fs.write_file(root + "/" + name, bytes, create_mode=CreateNew)
    sums.push(hash(bytes) + "  " + name)
  }
  let inventory = sums.join("\n") + "\n"
  @fs.write_file(root + "/SHA256SUMS", inventory, create_mode=CreateNew)
  @fs.write_file(root + "/SEAL.sha256", hash(@utf8.encode(inventory)) + "  SHA256SUMS\n", create_mode=CreateNew)
  println("ARCHIVE=" + root)
  println("FILES=" + sums.length().to_string())
  println("INVENTORY=" + hash(@utf8.encode(inventory)))
  println("MANIFEST=" + hash(@fs.read_file(root + "/manifest.json").binary()))
}

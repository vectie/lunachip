///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.1/crypto",
}

///|
let cache = "/Users/kq/Workspace/lunachip/_build/automation"

///|
let id = "phase6-flux-tile-direct8-q3-engine-progress-r2-h2"

///|
async fn command(root : String, label : String, args : Array[String]) -> Unit {
  @fs.write_file(
    root + "/" + label + ".command.json",
    args.to_json().stringify(indent=2),
    create_mode=CreateNew,
  )
  let output = @shell.Cmd("moon", args).output(max_output_bytes=16000000)
  @fs.write_file(
    root + "/" + label + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".exit",
    output.exit_code().to_string() + "\n",
    create_mode=CreateNew,
  )
  output.check()
}


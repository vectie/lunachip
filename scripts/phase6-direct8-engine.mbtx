///|
async fn prepare(
  root : String,
  repository : String,
  owner_support? : Bool = false,
  completed_prefix? : Bool = false,
  latency? : Bool = false,
  service_credit? : Bool = false,
  done_core? : Bool = false,
  pending_slot? : Bool = false,
) -> Unit {
  assert_false(@fs.exists(root))
  assert_false(completed_prefix && !owner_support)
  // Parent preparation creates ROOT. Keep its actual child command outcome.
  let args = [
    "run", "scripts/phase6-direct8-arbiter.mbtx", "--target-dir", cache, "--", "prepare",
    root, repository,
  ]
  let parent = @shell.Cmd("moon", args).output(max_output_bytes=16000000)
  assert_true(@fs.exists(root))
  @fs.write_file(
    root + "/parent-preflight.command.json",
    args.to_json().stringify(indent=2),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/parent-preflight.stdout",
    parent.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/parent-preflight.stderr",
    parent.stderr(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/parent-preflight.exit",
    parent.exit_code().to_string() + "\n",
    create_mode=CreateNew,
  )
  parent.check()
  command(root, "native-engine", [
    "test", "validation/formal/direct8_engine_binding_wbtest.mbt", "validation/formal/direct8_engine_bundle_wbtest.mbt",
    "validation/formal/direct8_engine_native_wbtest.mbt", "validation/formal/direct8_engine_owner_native_wbtest.mbt",
    "validation/formal/direct8_engine_prefix_wbtest.mbt", "validation/formal/fetched_safety_composition_wbtest.mbt",
    "validation/formal/direct8_latency_native_wbtest.mbt", "validation/formal/direct8_latency_bundle_wbtest.mbt",
    "validation/formal/direct8_service_credit_wbtest.mbt", "validation/formal/fetched_retirement_history_wbtest.mbt",
    "validation/formal/direct8_done_core_native_wbtest.mbt", "validation/formal/direct8_done_core_bundle_wbtest.mbt",
    "validation/formal/direct8_done_slot_wbtest.mbt", "validation/formal/direct8_service_phase_wbtest.mbt",
    "validation/formal/direct8_service_split_wbtest.mbt", "validation/formal/direct8_payload_native_wbtest.mbt",
    "validation/formal/direct8_payload_bundle_wbtest.mbt", "validation/formal/direct8_latency_composition_wbtest.mbt",
    "--target", "native", "--deny-warn", "--no-parallelize", "-j", "2", "--target-dir",
    cache,
  ])
  let format = ["fmt"]
  for path in sources() {
    if path.has_suffix(".mbt") || path.has_suffix(".mbtx") {
      format.push(path)
    }
  }
  format.push("--check")
  format.push("--target-dir")
  format.push(cache)
  command(root, "format-engine", format)
  command(root, "test-engine-script", [
    "test", "scripts/phase6-direct8-engine.mbtx", "--target", "native", "--deny-warn",
    "--target-dir", cache,
  ])
  let bundle = root + "/engine"
  command(root, "export-engine", [
    "run", "--target", "native", "--deny-warn", "--target-dir", cache, "cmd/phase6-formal-fixtures",
    "--", "export", id, bundle,
  ])
  command(root, "verify-engine", [
    "run",
    "--target",
    "native",
    "--deny-warn",
    "--target-dir",
    cache,
    "cmd/phase4-formal",
    "--",
    "verify",
    bundle,
    id + "-prove",
  ])
  command(root, "helpers-engine", [
    "run",
    "scripts/phase6-fetched-safety-review.mbtx",
    "--target-dir",
    cache,
    "--",
    "helpers-direct8",
    bundle + "/formal-dut.sv",
    repository,
  ])
  if owner_support {
    let supported = id + "-owner-support"
    let directory = root + "/engine-supported"
    command(root, "export-engine-supported", [
      "run", "--target", "native", "--deny-warn", "--target-dir", cache, "cmd/phase6-formal-fixtures",
      "--", "export", supported, directory,
    ])
    command(root, "verify-engine-supported", [
      "run",
      "--target",
      "native",
      "--deny-warn",
      "--target-dir",
      cache,
      "cmd/phase4-formal",
      "--",
      "verify",
      directory,
      supported + "-prove",
    ])
    command(root, "helpers-engine-supported", [
      "run",
      "scripts/phase6-fetched-safety-review.mbtx",
      "--target-dir",
      cache,
      "--",
      "helpers-direct8",
      directory + "/formal-dut.sv",
      repository,
    ])
  }
  if completed_prefix {
    let prefix_id = id + "-owner-prefix-support"
    let directory = root + "/engine-prefix"
    command(root, "export-engine-prefix", [
      "run", "--target", "native", "--deny-warn", "--target-dir", cache, "cmd/phase6-formal-fixtures",
      "--", "export", prefix_id, directory,
    ])
    command(root, "verify-engine-prefix", [
      "run",
      "--target",
      "native",
      "--deny-warn",
      "--target-dir",
      cache,
      "cmd/phase4-formal",
      "--",
      "verify",
      directory,
      prefix_id + "-prove",
    ])
    command(root, "helpers-engine-prefix", [
      "run",
      "scripts/phase6-fetched-safety-review.mbtx",
      "--target-dir",
      cache,
      "--",
      "helpers-direct8",
      directory + "/formal-dut.sv",
      repository,
    ])
  }
  if latency {
    let latency_id = "phase6-flux-tile-direct8-q3-engine-latency-r2-h2"
    let directory = root + "/engine-latency"
    command(root, "export-engine-latency", [
      "run", "--target", "native", "--deny-warn", "--target-dir", cache, "cmd/phase6-formal-fixtures",
      "--", "export", latency_id, directory,
    ])
    command(root, "verify-engine-latency", [
      "run",
      "--target",
      "native",
      "--deny-warn",
      "--target-dir",
      cache,
      "cmd/phase4-formal",
      "--",
      "verify",
      directory,
      latency_id + "-prove",
    ])
    command(root, "helpers-engine-latency", [
      "run",
      "scripts/phase6-fetched-safety-review.mbtx",
      "--target-dir",
      cache,
      "--",
      "helpers-direct8",
      directory + "/formal-dut.sv",
      repository,
    ])
  }
  if service_credit {
    let credit_id = "phase6-flux-tile-direct8-q3-engine-latency-r2-h2-service-credit"
    let directory = root + "/engine-latency-credit"
    command(root, "export-engine-latency-credit", [
      "run", "--target", "native", "--deny-warn", "--target-dir", cache, "cmd/phase6-formal-fixtures",
      "--", "export", credit_id, directory,
    ])
    command(root, "verify-engine-latency-credit", [
      "run",
      "--target",
      "native",
      "--deny-warn",
      "--target-dir",
      cache,
      "cmd/phase4-formal",
      "--",
      "verify",
      directory,
      credit_id + "-prove",
    ])
    command(root, "helpers-engine-latency-credit", [
      "run",
      "scripts/phase6-fetched-safety-review.mbtx",
      "--target-dir",
      cache,
      "--",
      "helpers-direct8",
      directory + "/formal-dut.sv",
      repository,
    ])
  }
  if done_core {
    for
      (kind, fixture) in [
        ("done-core", "phase6-flux-tile-direct8-q3-done-core-link-r2-h2"),
        (
          "engine-latency-done", "phase6-flux-tile-direct8-q3-engine-latency-r2-h2-service-credit-done-core",
        ),
      ] {
      let directory = root + "/" + kind
      command(root, "export-" + kind, [
        "run", "--target", "native", "--deny-warn", "--target-dir", cache, "cmd/phase6-formal-fixtures",
        "--", "export", fixture, directory,
      ])
      command(root, "verify-" + kind, [
        "run",
        "--target",
        "native",
        "--deny-warn",
        "--target-dir",
        cache,
        "cmd/phase4-formal",
        "--",
        "verify",
        directory,
        fixture + "-prove",
      ])
      command(root, "helpers-" + kind, [
        "run",
        "scripts/phase6-fetched-safety-review.mbtx",
        "--target-dir",
        cache,
        "--",
        "helpers-direct8",
        directory + "/formal-dut.sv",
        repository,
      ])
    }
  }
  if pending_slot {
    for
      (kind, fixture) in [
        (
          "done-core-slot", "phase6-flux-tile-direct8-q3-done-core-link-r2-h2-pending-slot",
        ),
        (
          "engine-latency-done-slot", "phase6-flux-tile-direct8-q3-engine-latency-r2-h2-service-credit-done-core-pending-slot",
        ),
        (
          "engine-service-phase", "phase6-flux-tile-direct8-q3-engine-service-phase-r2-h2",
        ),
        (
          "engine-service-owner", "phase6-flux-tile-direct8-q3-engine-service-owner-r2-h2",
        ),
        (
          "engine-service-ack-credit", "phase6-flux-tile-direct8-q3-engine-service-ack-credit-r2-h2",
        ),
        (
          "engine-service-payload", "phase6-flux-tile-direct8-q3-engine-service-payload-r2-h2",
        ),
        (
          "engine-service-phase-payload", "phase6-flux-tile-direct8-q3-engine-service-phase-payload-r2-h2",
        ),
        (
          "engine-age-potential-payload", "phase6-flux-tile-direct8-q3-engine-age-potential-payload-r2-h2",
        ),
        (
          "engine-latency-payload", "phase6-flux-tile-direct8-q3-engine-latency-payload-r2-h2",
        ),
      ] {
      let directory = root + "/" + kind
      command(root, "export-" + kind, [
        "run", "--target", "native", "--deny-warn", "--target-dir", cache, "cmd/phase6-formal-fixtures",
        "--", "export", fixture, directory,
      ])
      command(root, "verify-" + kind, [
        "run",
        "--target",
        "native",
        "--deny-warn",
        "--target-dir",
        cache,
        "cmd/phase4-formal",
        "--",
        "verify",
        directory,
        fixture + "-prove",
      ])
      command(root, "helpers-" + kind, [
        "run",
        "scripts/phase6-fetched-safety-review.mbtx",
        "--target-dir",
        cache,
        "--",
        "helpers-direct8",
        directory + "/formal-dut.sv",
        repository,
      ])
    }
  }
  println("PREPARED original direct8 engine progress; no engine result")
}

///|
async fn retain(root : String, snapshot : String) -> Unit {
  assert_false(@fs.exists(root + "/files.sha256"))
  command(root, "retain-arbiter", [
    "run", "scripts/phase6-direct8-arbiter.mbtx", "--target-dir", cache, "--", "retain-source",
    root, snapshot,
  ])
  let inventory = StringBuilder()
  for relative in sources() {
    let source = @fs.read_file(snapshot + "/" + relative).text()
    let leaf = "engine-" +
      relative.split("/").to_array().last().unwrap().to_owned()
    @fs.write_file(root + "/source/" + leaf, source, create_mode=CreateNew)
    let digest = @crypto.bytes_to_hex_string(
      @crypto.sha256(@utf8.encode(source)),
    )
    inventory.write_string(digest + "  " + relative + "\n")
  }
  @fs.write_file(
    root + "/source-engine-inputs.sha256",
    inventory.to_string(),
    create_mode=CreateNew,
  )
}

///|
async fn main {
  match @env.args() {
    [_, "prepare", root, repository] => prepare(root, repository)
    [_, "prepare-supported", root, repository] =>
      prepare(root, repository, owner_support=true)
    [_, "prepare-prefix", root, repository] =>
      prepare(root, repository, owner_support=true, completed_prefix=true)
    [_, "prepare-latency", root, repository] =>
      prepare(
        root,
        repository,
        owner_support=true,
        completed_prefix=true,
        latency=true,
      )
    [_, "retain-source", root, snapshot] => retain(root, snapshot)
    [_, "prepare-credit", root, repository] =>
      prepare(
        root,
        repository,
        owner_support=true,
        completed_prefix=true,
        latency=true,
        service_credit=true,
      )
    [_, "prepare-done", root, repository] =>
      prepare(
        root,
        repository,
        owner_support=true,
        completed_prefix=true,
        latency=true,
        service_credit=true,
        done_core=true,
      )
    [_, "prepare-done-slot", root, repository] =>
      prepare(
        root,
        repository,
        owner_support=true,
        completed_prefix=true,
        latency=true,
        service_credit=true,
        done_core=true,
        pending_slot=true,
      )
    _ =>
      fail(
        "usage: prepare[-supported|-prefix|-latency|-credit|-done|-done-slot] ROOT REPOSITORY | retain-source ROOT SNAPSHOT",
      )
  }
}

///|
test "engine retention owns distinct leaves and no active package manifest" {
  let leaves : Array[String] = []
  for path in sources() {
    let leaf = path.split("/").to_array().last().unwrap().to_owned()
    assert_false(leaves.contains(leaf))
    leaves.push(leaf)
  }
  assert_true(leaves.contains("concurrent_compute.mbt"))
  assert_true(leaves.contains("direct8_engine_source.mbt"))
  assert_false(leaves.contains("moon.pkg"))
}

///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn hash(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
fn checked_xml(original : String) -> String raise {
  let old = "<C0_S_AXI_SUPPORTS_NARROW_BURST>0</C0_S_AXI_SUPPORTS_NARROW_BURST>"
  assert_eq(original.split(old).to_array().length(), 2)
  guard !original.contains("ddr3_addr[15]") else {
    fail("unreviewed A15 output forbidden")
  }
  for
    tag in [
      "<RowAddress>15</RowAddress>", "<DataWidth>64</DataWidth>", "<C0_MEM_SIZE>2147483648</C0_MEM_SIZE>",
      "<C0_S_AXI_ADDR_WIDTH>31</C0_S_AXI_ADDR_WIDTH>", "<C0_S_AXI_DATA_WIDTH>128</C0_S_AXI_DATA_WIDTH>",
      "<C0_S_AXI_ID_WIDTH>4</C0_S_AXI_ID_WIDTH>",
    ] {
    assert_eq(original.split(tag).to_array().length(), 2)
  }
  original
}

///|
async fn export_bundle(destination : String) -> Unit {
  guard destination.has_prefix("/") &&
    !destination.contains("\n") &&
    !destination.contains("\r") &&
    destination.split("/").iter().all(p => p != "." && p != "..") &&
    !@fs.exists(destination) else {
    fail("fresh absolute destination required")
  }
  let reference = "artifacts/pblaze3-ila-ready-inputs-20261028-a1/ddr-status-ila"
  let pinned = [
    (
      "mig.prj", "6594d41537187d3d5fa05cf77c8af40f37e9d1f13aa032a3535095672de2ca94",
    ),
    (
      "build.tcl", "71379fada4c4062a60376b6a6961a6a238d5461404ec9521c29e7c124de670e0",
    ),
    (
      "pblaze3_diagnostic_clock.sv", "aa59746cdae6a47d346b6b3055da82f802bf6a9a0ce14f637502e0f5f6dca4f7",
    ),
    (
      "vendor-provenance.json", "aab1b0d509b58e056bf79cd96263d3a14ea2b1178b446c1f9508c22fc637ba47",
    ),
  ]
  for (name, expected) in pinned {
    assert_eq(hash(@fs.read_file(reference + "/" + name).binary()), expected)
  }
  let old_build = @fs.read_file(reference + "/build.tcl").text()
  let split = old_build.split("proc pblaze_mig_read {path} {").to_array()
  assert_eq(split.length(), 2)
  let child_guards = split[0].to_owned()
  assert_true(child_guards.contains("proc pblaze_assert_run_logs"))
  let recipe = @shell.Cmd("moon", [
    "run", "--deny-warn", "--warn-list", "+73", "scripts/pblaze3-jtag-ddr-recipe.mbtx",
  ]).output()
  recipe.check()
  let xml = @fs.read_file(reference + "/mig.prj").text()
  let effective = checked_xml(xml)
  let files : Map[String, String] = {
    "build.tcl": child_guards + recipe.stdout(),
    "mig-original.prj": xml,
    "mig.prj": effective,
    "pblaze3_diagnostic_clock.sv": @fs.read_file(
      reference + "/pblaze3_diagnostic_clock.sv",
    ).text(),
    "vendor-provenance.json": @fs.read_file(
      reference + "/vendor-provenance.json",
    ).text(),
    "pblaze3_jtag_ddr_status.sv": (
      #|module pblaze3_jtag_ddr_status (
      #|  (* X_INTERFACE_INFO = "xilinx.com:signal:clock:1.0 clock50 CLK", X_INTERFACE_PARAMETER = "XIL_INTERFACENAME clock50, FREQ_HZ 50000000" *)
      #|  input wire clock50,
      #|  input wire calibrated, ui_ready, mig_locked, source_locked,
      #|  output wire [3:0] flags
      #|);
      #|  xpm_cdc_array_single #(.DEST_SYNC_FF(3), .INIT_SYNC_FF(0), .SIM_ASSERT_CHK(1), .SRC_INPUT_REG(0), .WIDTH(4))
      #|    health_sync (.src_clk(1'b0), .src_in({source_locked, mig_locked, ui_ready, calibrated}), .dest_clk(clock50), .dest_out(flags));
      #|endmodule
      #|
    ),
    "pblaze3.xdc": (
      #|# DDR pins remain exclusively in the pinned MIG input. No PCIe IO exists.
      #|set_property PACKAGE_PIN D27 [get_ports clk_in1_50M]
      #|set_property IOSTANDARD LVCMOS18 [get_ports clk_in1_50M]
      #|create_clock -name clk_in1_50M -period 20.000 [get_ports clk_in1_50M]
      #|set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
      #|set_property BITSTREAM.CONFIG.UNUSEDPIN Pullup [current_design]
      #|set_property CFGBVS VCCO [current_design]
      #|set_property CONFIG_VOLTAGE 3.3 [current_design]
      #|
    ),
    "debug-hub.xdc": (
      #|set_property C_CLK_INPUT_FREQ_HZ 50000000 [get_debug_cores dbg_hub]
      #|set_property C_ENABLE_CLK_DIVIDER false [get_debug_cores dbg_hub]
      #|connect_debug_port dbg_hub/clk [get_nets -of_objects [get_pins pblaze3_i/diagnostic_clock/inst/oscillator_global/O]]
      #|
    ),
  }
  let board : Json = {
    "schema": "lunachip.pblaze3-jtag-ddr/v1",
    "mode": "jtag-ddr-2g",
    "part": "xc7k325tffg900-2",
    "vivado_release": "2026.1",
    "memory_base": "0x00000000",
    "memory_bytes": 2147483648.0,
    "last_byte": "0x7fffffff",
    "jtag_axi": {
      "count": 1,
      "data_bits": 32,
      "address_bits": 32,
      "id_bits": 4,
      "protocol": "AXI4",
      "bd_instance": "jtag",
    },
    "gpio": {
      "address": "0x80000000",
      "data_offset": 0,
      "width": 4,
      "healthy_value": 15,
      "bits_lsb_first": [
        "calibrated", "ui_reset_released", "mig_mmcm_locked", "source_mmcm_locked",
      ],
      "sync_stages": 3,
    },
    "requires_pcie": false,
    "requires_ila": false,
    "reset": "Source lock drives MIG active-low physical reset. UI reset/source lock/MIG lock reset all transaction owners through raw50 and UI-domain proc_sys_reset. Calibration does not reset or gate clocks. GPIO is unavailable while transport reset is asserted; use accepted status ILA fallback.",
    "claim": "2GiB configured aperture only. Sparse address/alias tests do not prove every byte, exact physical capacity, retention, or absent additional memory. No A15 output or4GiB claim.",
    "reference": reference,
  }
  files["board.json"] = board.stringify(indent=2) + "\n"
  let identity : Json = {
    "schema": "lunachip.pblaze3-jtag-ddr-input-provenance/v1",
    "reference": reference,
    "pinned_sources": pinned.map(p => ({ "path": p.0, "sha256": p.1 } : Json)),
    "mig_change": "None: accepted MIG XML retained byte-for-byte, including SUPPORTS_NARROW_BURST=0. JTAG commands must use CACHE=3, INCR and SIZE=32; the vendor upsizer packs modifiable accesses to the full128-bit MI width. Original retained as mig-original.prj; vendor receives isolated fresh work copy.",
  }
  files["provenance.json"] = identity.stringify(indent=2) + "\n"
  @fs.mkdir(destination)
  let inventory = StringBuilder()
  for name, contents in files {
    @fs.write_file(destination + "/" + name, contents, create_mode=CreateNew)
    inventory.write_string(
      hash(@fs.read_file(destination + "/" + name).binary()) +
      "  " +
      name +
      "\n",
    )
  }
  for name in ["pblaze3-jtag-ddr-build.mbtx", "pblaze3-jtag-ddr-recipe.mbtx"] {
    let bytes = @fs.read_file("scripts/" + name).binary()
    @fs.write_file(destination + "/" + name, bytes, create_mode=CreateNew)
    inventory.write_string(hash(bytes) + "  " + name + "\n")
  }
  @fs.write_file(
    destination + "/SHA256SUMS",
    inventory.to_string(),
    create_mode=CreateNew,
  )
  let verified = @shell.Cmd("moon", [
    "run", "scripts/pblaze3-build.mbtx", "verify", destination,
  ]).output()
  verified.check()
  println("Prepared JTAG-only2GiB DDR inputs: " + destination)
  println("No Vivado run, remote operation or hardware access performed.")
}

///|
fn selftest() -> Unit raise {
  let valid = "<RowAddress>15</RowAddress><DataWidth>64</DataWidth><C0_MEM_SIZE>2147483648</C0_MEM_SIZE><C0_S_AXI_ADDR_WIDTH>31</C0_S_AXI_ADDR_WIDTH><C0_S_AXI_DATA_WIDTH>128</C0_S_AXI_DATA_WIDTH><C0_S_AXI_ID_WIDTH>4</C0_S_AXI_ID_WIDTH><C0_S_AXI_SUPPORTS_NARROW_BURST>0</C0_S_AXI_SUPPORTS_NARROW_BURST>"
  let output = checked_xml(valid)
  assert_eq(output, valid)
  for
    invalid in [
      valid + "ddr3_addr[15]",
      valid.replace(old="<RowAddress>15", new="<RowAddress>16"),
      valid.replace(old="2147483648", new="4294967296"),
      valid.replace(old="<C0_S_AXI_ID_WIDTH>4", new="<C0_S_AXI_ID_WIDTH>5"),
      valid +
      "<C0_S_AXI_SUPPORTS_NARROW_BURST>0</C0_S_AXI_SUPPORTS_NARROW_BURST>",
    ] {
    try checked_xml(invalid) catch {
      _ => ()
    } noraise {
      _ => fail("invalid MIG source accepted")
    }
  }
  println(
    "PASS6 XML validation cases (byte identity; A15, row, capacity, ID, duplicate-tag rejection)",
  )
}

///|
async fn main {
  match @env.args()[1:] {
    ["export", destination] => export_bundle(destination)
    ["selftest"] => selftest()
    _ =>
      fail(
        "export NEW_ABSOLUTE_BUNDLE | selftest; execute with existing pblaze3-remote.mbtx and explicit2026.1 pin",
      )
  }
}

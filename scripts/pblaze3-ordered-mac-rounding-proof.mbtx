///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
}

///|
async fn main {
  let (input, out, alignment) = match @env.args()[1:] {
    [src, dir] => (src, dir, None)
    [src, dir, a, b, distance] => (src, dir, Some((a, b, distance)))
    _ =>
      fail(
        "ARRAY_INPUT_DIR NEW_PROOF_DIR [ADDEND_NODE TERM_NODE DISTANCE_REGISTER_NODE]",
      )
  }
  let ir = @fs.read_file(input + "/lane.lcir").text()
  let rtl = @fs.read_file(input + "/array.sv").text()
  let nodes : Map[String, Array[String]] = Map([])
  let adds = []
  for line in ir.split("\n") {
    if line.has_prefix("NODE ") {
      let fields = line.split(" ").map(s => s.to_owned()).to_array()
      nodes[fields[1]] = fields
      if fields[2] == "uint:25" && fields[3] == "add" {
        adds.push(fields[1])
      }
    }
  }
  assert_eq(adds.length(), 2)
  let top_name = rtl
  .split("\n")
  .find_first(l => l.has_prefix("module "))
  .unwrap()
  .split(" ")
  .to_array()[1].to_owned()
  let cuts = []
  let tests = []
  let negative = []
  for id in adds {
    let extended = nodes[nodes[id][4]]
    assert_eq(extended[3], "zext")
    let cast = nodes[extended[4]]
    assert_eq(cast[3], "reinterpret")
    let slice = nodes[cast[4]]
    assert_eq(slice[3], "slice")
    assert_eq(slice[5], "26")
    assert_eq(slice[6], "3")
    let x = "lc_n" + slice[4]
    let sum = "lc_n" + id
    cuts.push("w:" + x)
    tests.push("(\{sum} == expected(\{x}, 1'b0))")
    negative.push("(\{sum} == expected(\{x}, 1'b1))")
  }
  let lane = rtl.split("endmodule").to_array()[0].to_owned()
  let checker =
    #|function automatic [24:0] expected(input [26:0] x, input odd);
    #|  logic [24:0] candidate;
    #|  candidate = {1'b0,x[26:3]};
    #|  if (x[2:0] > 3'd4 || (x[2:0] == 3'd4 && (candidate[0] ^ odd)))
    #|    candidate = candidate + 25'd1;
    #|  expected = candidate;
    #|endfunction
  @fs.mkdir(out)
  @fs.write_file(
    out + "/proof.sv",
    lane +
    checker +
    "\n(* keep *) wire round_ok = " +
    tests.join(" && ") +
    ";\n(* keep *) wire round_odd = " +
    negative.join(" && ") +
    ";\nendmodule\n",
    create_mode=CreateNew,
  )
  let script = "read_verilog -sv proof.sv\nhierarchy -top " +
    top_name +
    "\nproc\nselect -module " +
    top_name +
    "\ncutpoint " +
    cuts.join(" ") +
    "\nopt\nsat -seq 1 -verify -prove round_ok 1\nsat -seq 1 -falsify -prove round_odd 1 -show " +
    cuts.map(s => s.strip_prefix("w:").unwrap().to_owned()).join(",") +
    "\n"
  @fs.write_file(out + "/rounding.ys", script, create_mode=CreateNew)
  if alignment is Some((a, b, distance)) {
    for (id, t) in [(a, "uint:32"), (b, "uint:32"), (distance, "uint:5")] {
      assert_eq(nodes[id][2], t)
      assert_eq(nodes[id][3], "reg")
    }
    let reference =
      #|function automatic [4:0] shift_amount(input [7:0] a, b);
      #|  logic [7:0] x,y,delta;
      #|  x=(a==0) ? 8'd1 : a;
      #|  y=(b==0) ? 8'd1 : b;
      #|  delta=(x>y) ? x-y : y-x;
      #|  shift_amount=(delta>31) ? 5'd31 : delta[4:0];
      #|endfunction
      #|reg [4:0] d1,d2,d3;
      #|always @(posedge lc_n0) begin
      #|  d1<=shift_amount(OPERAND_A[30:23],OPERAND_B[30:23]);
      #|  d2<=d1; d3<=d2;
      #|end
      #|(* keep *) wire aligned=(DISTANCE==d3);
      #|(* keep *) wire one_edge_early=(DISTANCE==d2);
      #|endmodule
    @fs.write_file(
      out + "/alignment.sv",
      lane +
      reference
      .replace(old="OPERAND_A", new="lc_n" + a)
      .replace(old="OPERAND_B", new="lc_n" + b)
      .replace_all(old="DISTANCE", new="lc_n" + distance) +
      "\n",
      create_mode=CreateNew,
    )
    @fs.write_file(
      out + "/alignment.ys",
      "read_verilog -sv alignment.sv\nhierarchy -top \{top_name}\nproc\nselect -module \{top_name}\n" +
      "cutpoint w:lc_n\{a} w:lc_n\{b}\nopt\n" +
      "sat -seq 4 -prove-skip 3 -verify -prove aligned 1\n" +
      "sat -seq 4 -prove-skip 3 -falsify -prove one_edge_early 1 -show lc_n\{a},lc_n\{b},d2,d3,lc_n\{distance}\n",
      create_mode=CreateNew,
    )
  }
}

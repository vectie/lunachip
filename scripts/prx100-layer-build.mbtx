///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn hash(b : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(b))
}

///|
async fn main {
  let args = @env.args()[1:].to_owned()
  let core_hz = if args.length() >= 6 { args[5] } else { "25000000" }
  let bounded_cdc = args.length() == 7 && args[6] == "bounded-cdc"
  let base = if args.length() == 6 || bounded_cdc { args[:5] } else { args[:] }
  guard base is ["build", inputs, expected_inventory, mig, root] &&
    [
      "20000000", "25000000", "33333333", "35714286", "37500000", "40000000", "41666667",
      "44444444", "50000000",
    ].contains(core_hz) &&
    inputs.has_prefix("/work/builds/prx100-layer-inputs-") &&
    mig.has_prefix("/work/builds/prx100-ddr-ip-") &&
    root.has_prefix("/work/builds/prx100-layer-vivado-") &&
    !@fs.exists(root) else {
    fail(
      "build INPUTS EXPECTED_INVENTORY_SHA256 MIG_ROOT NEW_BUILD_ROOT [20000000|25000000|33333333|35714286|37500000|40000000|41666667|44444444|50000000] [bounded-cdc]",
    )
  }
  let tool = "/tools/amd/2025.2/Vivado/bin/vivado"
  guard @json.parse(@fs.read_file("/work/builds/vivado-2025.2-pin.json").text())
    is {
      "executable_sha256": String(tool_hash),
      "version_stdout": String(version),
      ..
    } else {
    fail("Vivado pin required")
  }
  assert_eq(hash(@fs.read_file(tool).binary()), tool_hash)
  let output = @shell.Cmd(tool, ["-version"]).output()
  output.check()
  assert_eq(output.stdout(), version)
  assert_eq(@fs.read_file(mig + "/exit.txt").text(), "0\n")
  assert_true(
    @fs.read_file(mig + "/generate.stdout")
    .text()
    .contains("PRX100_MIG_GENERATED"),
  )
  assert_eq(
    hash(@fs.read_file(inputs + "/SHA256SUMS").binary()),
    expected_inventory,
  )
  let qualified = "/work/builds/prx100-ddr-memory-evidence-20261016/ip-a2"
  assert_eq(
    hash(@fs.read_file(mig + "/prx100.prj").binary()),
    hash(@fs.read_file(qualified + "/prx100.prj").binary()),
  )
  assert_eq(
    hash(@fs.read_file(mig + "/ip/prx100_ddr_mig/prx100_ddr_mig.xci").binary()),
    hash(@fs.read_file(qualified + "/mig.xci").binary()),
  )
  @fs.mkdir(root)
  @fs.mkdir(root + "/inputs")
  @fs.write_file(
    root + "/driver.mbtx",
    @fs.read_file("/work/prx100-layer-build.mbtx").binary(),
    create_mode=CreateNew,
  )
  @fs.write_file(root + "/tool-version.txt", version, create_mode=CreateNew)
  for name in @fs.readdir(inputs, sort=true) {
    guard @fs.kind(inputs + "/" + name, follow_symlink=false) == Regular else {
      fail("flat inputs required")
    }
    @fs.write_file(
      root + "/inputs/" + name,
      @fs.read_file(inputs + "/" + name).binary(),
      create_mode=CreateNew,
    )
  }
  for line in @fs.read_file(root + "/inputs/SHA256SUMS").text().split("\n") {
    if line != "" {
      let fields = line.split("  ").to_array()
      assert_eq(fields.length(), 2)
      guard !fields[1].contains("/") && fields[1] != ".." else {
        fail("invalid inventory path")
      }
      assert_eq(
        hash(@fs.read_file(root + "/inputs/" + fields[1].to_owned()).binary()),
        fields[0].to_owned(),
      )
    }
  }
  @fs.write_file(
    root + "/mig-project.prj",
    @fs.read_file(mig + "/prx100.prj").binary(),
    create_mode=CreateNew,
  )
  if bounded_cdc {
    @fs.write_file(
      root + "/cdc-generator.mbtx",
      @fs.read_file("/work/prx100-layer-cdc.mbtx").binary(),
      create_mode=CreateNew,
    )
    let code = @shell.Cmd(
      "moon",
      [
        "run",
        "/work/prx100-layer-cdc.mbtx",
        "--",
        root + "/inputs",
        root + "/cdc.tcl",
      ],
      stdout=ToFile(root + "/generate-cdc.stdout"),
      stderr=ToFile(root + "/generate-cdc.stderr"),
    ).status()
    assert_eq(code, 0)
  }
  let tcl = "set bounded_cdc " +
    (if bounded_cdc { "1" } else { "0" }) +
    "\nset core_hz " +
    core_hz +
    "\nset core_mhz " +
    (if core_hz == "41666667" {
      "41.666667"
    } else if core_hz == "44444444" {
      "44.444444"
    } else if core_hz == "50000000" {
      "50.000"
    } else if core_hz == "40000000" {
      "40.000"
    } else if core_hz == "37500000" {
      "37.500"
    } else if core_hz == "35714286" {
      "35.714286"
    } else if core_hz == "33333333" {
      "33.333333"
    } else if core_hz == "20000000" {
      "20.000"
    } else {
      "25.000"
    }) +
    "\nset core_period " +
    (if core_hz == "41666667" {
      "24.0"
    } else if core_hz == "44444444" {
      "22.5"
    } else if core_hz == "50000000" {
      "20.0"
    } else if core_hz == "40000000" {
      "25.0"
    } else if core_hz == "37500000" {
      "26.667"
    } else if core_hz == "35714286" {
      "28.0"
    } else if core_hz == "33333333" {
      "30.0"
    } else if core_hz == "20000000" {
      "50.0"
    } else {
      "40.0"
    }) +
    "\nset mig_xci {" +
    mig +
    "/ip/prx100_ddr_mig/prx100_ddr_mig.xci}\n" +
    (
      #|set_param general.maxThreads 1
      #|create_project prx100_ddr project -part xc7a100tfgg676-2
      #|file mkdir ip
      #|read_ip $mig_xci
      #|set_property GENERATE_SYNTH_CHECKPOINT false [get_files $mig_xci]
      #|create_ip -name clk_wiz -vendor xilinx.com -library ip -module_name prx100_ddr_refclock -dir ip
      #|set_property -dict [list CONFIG.PRIM_SOURCE {No_buffer} CONFIG.PRIM_IN_FREQ {50.000} CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {200.000} CONFIG.CLKOUT2_USED {true} CONFIG.CLKOUT2_REQUESTED_OUT_FREQ $core_mhz CONFIG.USE_RESET {true} CONFIG.RESET_TYPE {ACTIVE_HIGH} CONFIG.USE_LOCKED {true}] [get_ips prx100_ddr_refclock]
      #|create_ip -name jtag_axi -vendor xilinx.com -library ip -module_name prx100_ddr_jtag -dir ip
      #|set_property -dict [list CONFIG.RD_TXN_QUEUE_LENGTH {16} CONFIG.WR_TXN_QUEUE_LENGTH {16} CONFIG.PROTOCOL {0} CONFIG.M_AXI_ID_WIDTH {1} CONFIG.M_AXI_DATA_WIDTH {32} CONFIG.M_AXI_ADDR_WIDTH {32}] [get_ips prx100_ddr_jtag]
      #|create_ip -name axi_protocol_converter -vendor xilinx.com -library ip -module_name prx100_layer_protocol -dir ip
      #|set_property -dict [list CONFIG.SI_PROTOCOL {AXI4} CONFIG.MI_PROTOCOL {AXI4LITE} CONFIG.TRANSLATION_MODE {2} CONFIG.DATA_WIDTH {32} CONFIG.ADDR_WIDTH {32} CONFIG.ID_WIDTH {1}] [get_ips prx100_layer_protocol]
      #|if {[get_property CONFIG.RD_TXN_QUEUE_LENGTH [get_ips prx100_ddr_jtag]]!=16 || [get_property CONFIG.WR_TXN_QUEUE_LENGTH [get_ips prx100_ddr_jtag]]!=16} {error "Expected16 read/write queue entries"}
      #|generate_target all [get_ips {prx100_ddr_refclock prx100_ddr_jtag prx100_layer_protocol}]
      #|set_property GENERATE_SYNTH_CHECKPOINT false [get_files ip/prx100_layer_protocol/prx100_layer_protocol.xci]
      #|set_property GENERATE_SYNTH_CHECKPOINT false [get_files ip/prx100_ddr_refclock/prx100_ddr_refclock.xci]
      #|set_property GENERATE_SYNTH_CHECKPOINT false [get_files ip/prx100_ddr_jtag/prx100_ddr_jtag.xci]
      #|report_ip_status -file ip-status.txt
      #|read_verilog -sv {inputs/core.sv inputs/controller.sv inputs/bridge.sv inputs/prx100_layer_system.sv inputs/prx100_layer_top.sv}
      #|read_xdc inputs/prx100_layer.xdc
      #|set_property top prx100_layer_top [current_fileset]
      #|synth_design -top prx100_layer_top -part xc7a100tfgg676-2 -flatten_hierarchy none
      #|write_checkpoint post-synth.dcp
      #|if {$bounded_cdc} {
      #| close_design
      #| open_checkpoint post-synth.dcp
      #| source cdc.tcl
      #|}
      #|report_utilization -file synth-utilization.txt
      #|opt_design
      #|place_design
      #|phys_opt_design
      #|route_design
      #|phys_opt_design -hold_fix
      #|route_design -directive Explore
      #|phys_opt_design -hold_fix
      #|report_route_status -file route-status.txt
      #|if {$bounded_cdc} {
      #| report_bus_skew -file bus-skew.txt
      #| report_exceptions -coverage -file exception-coverage.txt
      #| report_exceptions -ignored -file ignored-exceptions.txt
      #|}
      #|write_checkpoint routed.dcp
      #|report_timing_summary -delay_type min_max -report_unconstrained -file timing.txt
      #|report_clocks -file clocks.txt
      #|report_cdc -details -file cdc.txt
      #|set uc [get_clocks -of_objects [get_nets ui_clk]]
      #|if {[llength $uc] != 1 || abs([get_property PERIOD $uc]-10.0)>0.0001} {error "Expected100MHz DDR UI"}
      #|set cc [get_clocks -of_objects [get_nets clk_core]]
      #|if {[llength $cc]!=1 || abs([get_property PERIOD $cc]-$core_period)>0.0001} {error {Layer clock period mismatch}}
      #|set corepins [get_pins -hier -filter {REF_PIN_NAME == C && NAME =~ *system_i/core_i/*}]
      #|set checked 0
      #|foreach pin $corepins {set clocks [get_clocks -of_objects $pin];if {[llength $clocks]!=1 || abs([get_property PERIOD $clocks]-$core_period)>0.0001} {error "Layer register clock mismatch $pin $clocks"};incr checked}
      #|if {$checked<100} {error {Missing core register clock qualification}}
      #|set f [open clock-qualification.txt w]
      #|puts $f "core_hz=$core_hz ui_hz=100000000 ui_clock=$uc core_clock=$cc checked_core_clock_pins=$checked"
      #|close $f
      #|report_clock_interaction -file clock-interaction.txt
      #|report_utilization -file utilization.txt
      #|report_drc -file drc.txt
      #|report_methodology -file methodology.txt
      #|set setup [get_timing_paths -delay_type max -max_paths 1]
      #|set hold [get_timing_paths -delay_type min -max_paths 1]
      #|if {[llength $setup] != 1 || [llength $hold] != 1} {error "Missing routed setup/hold paths"}
      #|if {[get_property SLACK $setup] < 0 || [get_property SLACK $hold] < 0} {error "DDR target timing failed"}
      #|set violations [get_drc_violations -quiet -filter {SEVERITY == Error || SEVERITY == {Critical Warning}}]
      #|if {[llength $violations] != 0} {error "DDR target DRC failed: $violations"}
      #|write_debug_probes prx100_layer.ltx
      #|write_bitstream prx100_layer.bit
      #|puts "PRX100_LAYER_ROUTED_PASS"
    )
  @fs.write_file(root + "/build.tcl", tcl + "\n", create_mode=CreateNew)
  let code = @shell.Cmd(
    "timeout",
    ["7200s", tool, "-mode", "batch", "-notrace", "-source", "build.tcl"],
    cwd=root,
    stdout=ToFile(root + "/build.stdout"),
    stderr=ToFile(root + "/build.stderr"),
  ).status()
  @fs.write_file(
    root + "/exit.txt",
    code.to_string() + "\n",
    create_mode=CreateNew,
  )
  assert_eq(code, 0)
  assert_true(
    @fs.read_file(root + "/build.stdout")
    .text()
    .contains("PRX100_LAYER_ROUTED_PASS"),
  )
  @fs.write_file(
    root + "/bitstream.sha256",
    hash(@fs.read_file(root + "/prx100_layer.bit").binary()) +
    "  prx100_layer.bit\n",
    create_mode=CreateNew,
  )
  println(
    "PASS: routed BF16/FP32 DDR batch target; new complete-layer floating-point hardware,integer core unchanged; no programming performed",
  )
}

    "set requested_hz " +
    jtag_hz.to_int().to_string() +
    "\nset bitstream {" +
    build +
    "/prx100_layer.bit}\nset fixture {" +
    fixture +
    "}\nset read_policy scan\nset assets {\n",
  )
  for a in assets {
    guard a
      is {
        "name": String(name),
        "file": String(file),
        "address": Number(address, ..),
        "bytes": Number(bytes, ..),
        ..
      } else {
      fail("asset")
    }
    t.write_string(
      "{" +
      name +
      " " +
      file +
      " " +
      address.to_int().to_string() +
      " " +
      bytes.to_int().to_string() +
      "}\n",
    )
  }
  t.write_string("}\nset traces {\n")
  for tr in traces {
    guard tr
      is {
        "name": String(name),
        "reference_file": String(file),
        "address": Number(address, ..),
        "words": Number(words, ..),
        ..
      } else {
      fail("trace")
    }
    safe(name)
    safe(file)
    t.write_string(
      "{" +
      name +
      " " +
      file +
      " " +
      address.to_int().to_string() +
      " " +
      words.to_int().to_string() +
      "}\n",
    )
  }
  t.write_string("}\narray set program_stats {\n")
  for (name, b) in programs {
    let (count, products, beats) = stats(b)
    t.write_string(
      name +
      " {" +
      count.to_string() +
      " " +
      products.to_string() +
      " " +
      beats.to_string() +
      "}\n",
    )
  }

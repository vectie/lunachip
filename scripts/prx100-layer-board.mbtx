///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn hash(b : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(b))
}

///|
fn word(b : Bytes, i : Int32) -> UInt32 {
  let a = i * 4
  b[a].to_uint() |
  (b[a + 1].to_uint() << 8) |
  (b[a + 2].to_uint() << 16) |
  (b[a + 3].to_uint() << 24)
}

///|
fn stats(b : Bytes) -> (Int32, UInt64, UInt64) raise {
  assert_eq(b.length() % 64, 0)
  let count = b.length() / 64
  let mut products = 0UL
  let mut beats = 0UL
  assert_eq(word(b, (count - 1) * 16), 0U)
  for j in 0..<(count - 1) {
    let i = j * 16
    let op = word(b, i)
    let n = word(b, i + 4).to_uint64()
    let k = word(b, i + 5).to_uint64()
    assert_true(op > 0U && op <= 15U)
    if op == 4U || op == 5U {
      products += n * k
    } else if op == 3U || op == 7U || op == 13U {
      products += n
    }
    if op == 4U {
      beats += n * k / 2UL
    } else if op == 14U || op == 15U {
      beats += n
    }
  }
  (count, products, beats)
}

///|
fn safe(s : String) -> Unit raise {
  assert_true(
    !s.contains("{") &&
    !s.contains("}") &&
    !s.contains("\n") &&
    !s.contains(".."),
  )
}

///|
async fn main {
  guard @env.args()[1:] is ["run", build, fixture, qualification, root] &&
    build.has_prefix("/work/builds/prx100-layer-vivado-") &&
    fixture.has_prefix("/work/builds/prx100-layer-cpu-native-") &&
    root.has_prefix("/work/builds/prx100-layer-board-") &&
    !@fs.exists(root) else {
    fail("run QUALIFIED_BUILD LINUX_NATIVE_FIXTURE QUALIFICATION NEW_ROOT")
  }
  for s in [build, fixture, qualification, root] {
    safe(s)
  }
  assert_eq(@fs.read_file(build + "/exit.txt").text(), "0\n")
  let bit_hash = hash(@fs.read_file(build + "/prx100_layer.bit").binary())
  assert_eq(
    @fs.read_file(build + "/bitstream.sha256").text(),
    bit_hash + "  prx100_layer.bit\n",
  )
  guard @json.parse(@fs.read_file(qualification).text())
    is {
      "status": "PASS",
      "bitstream_sha256": String(qbit),
      "sources": Object(sources),
      "read_queue_depth": Number(16, ..),
      "write_queue_depth": Number(16, ..),
      "jtag_hz": Number(jtag_hz, ..),
      "core_clock_hz": Number(core_hz, ..),
      ..
    } else {
    fail("source/bit-bound digital qualification required")
  }
  assert_eq(qbit, bit_hash)
  assert_true([20000000.0, 25000000.0].contains(core_hz))
  assert_true(
    @fs.read_file(build + "/clock-qualification.txt")
    .text()
    .has_prefix("core_hz=" + core_hz.to_int().to_string() + " ui_hz=100000000"),
  )
  assert_true([6000000.0, 10000000.0, 15000000.0, 30000000.0].contains(jtag_hz))
  for name, expected in sources {
    guard expected is String(digest) else { fail("source hash") }
    safe(name)
    assert_eq(hash(@fs.read_file(build + "/inputs/" + name).binary()), digest)
  }
  for
    name in [
      "core.sv", "controller.sv", "bridge.sv", "prx100_layer_system.sv", "prx100_layer_top.sv",
      "prx100_layer.xdc",
    ] {
    assert_true(sources.contains(name))
  }
  let tool = "/tools/amd/2025.2/Vivado/bin/vivado"
  guard @json.parse(@fs.read_file("/work/builds/vivado-2025.2-pin.json").text())
    is {
      "executable_sha256": String(tool_hash),
      "version_stdout": String(version),
      ..
    } else {
    fail("Vivado pin")
  }
  assert_eq(hash(@fs.read_file(tool).binary()), tool_hash)
  let v = @shell.Cmd(tool, ["-version"]).output()
  v.check()
  assert_eq(v.stdout(), version)
  guard @json.parse(@fs.read_file(fixture + "/fixture.json").text())
    is {
      "status": "PASS",
      "assets": Array(assets),
      "traces": Array(traces),
      "cpu_traces": Array(cpu),
      "program_sha256": String(program_hash),
      "program_descriptors": Number(2025, ..),
      "comparison_absolute_tolerance": Number(0.0001, ..),
      "comparison_relative_tolerance": Number(0.0001, ..),
      ..
    } else {
    fail("complete layer fixture")
  }
  assert_eq(assets.length(), 27)
  assert_eq(traces.length(), 80)
  assert_eq(cpu.length(), 80)
  let program = @fs.read_file(fixture + "/program.bin").binary()
  assert_eq(hash(program), program_hash)
  let mut split = 0
  let mut fourth = 0U
  for a in assets {
    guard a
      is {
        "name": String(name),
        "file": String(file),
        "bytes": Number(bytes, ..),
        "sha256": String(digest),
        "address": Number(address, ..),
        ..
      } else {
      fail("asset")
    }
    safe(name)
    safe(file)
    assert_true(!file.contains("/") && !file.has_prefix("cpu-"))
    let raw = @fs.read_file(fixture + "/" + file).binary()
    assert_eq(raw.length(), bytes.to_int())
    assert_eq(hash(raw), digest)
    if name == "embedding-3" {
      fourth = address.to_int().reinterpret_as_uint()
    }
  }
  assert_true(fourth > 0U)
  for j in 0..<(program.length() / 64) {
    if word(program, j * 16) == 14U && word(program, j * 16 + 8) == fourth {
      assert_eq(split, 0)
      split = j
    }
  }
  assert_eq(split, 1518)
  for c in cpu {
    guard c
      is {
        "file": String(file),
        "words": Number(words, ..),
        "sha256": String(digest),
        ..
      } else {
      fail("CPU tensor")
    }
    safe(file)
    assert_true(!file.contains("/"))
    let raw = @fs.read_file(fixture + "/" + file).binary()
    assert_eq(raw.length(), words.to_int() * 4)
    assert_eq(hash(raw), digest)
  }
  let first = Bytes::from_array(
    program[:split * 64].to_array() + Array::make(64, (0).to_byte()),
  )
  let last = Bytes::from_array(program[split * 64:].to_array())
  let programs = [("full", program), ("prefill", first), ("decode", last)]
  @fs.mkdir(root)
  for
    (from, to) in [
      ("/work/prx100-layer-board.mbtx", "driver.mbtx"),
      ("/work/prx100-layer-io.mbtx", "io-generator.mbtx"),
      ("/work/prx100-fqc-data.mbtx", "decoder-generator.mbtx"),
      (qualification, "qualification.json"),
      (fixture + "/fixture.json", "fixture.json"),
    ] {
    @fs.write_file(
      root + "/" + to,
      @fs.read_file(from).binary(),
      create_mode=CreateNew,
    )
  }
  for
    (script, out) in [
      ("io-generator.mbtx", "io.tcl"),
      ("decoder-generator.mbtx", "decoder.tcl"),
    ] {
    let r = @shell.Cmd("moon", [
      "run",
      root + "/" + script,
      "--",
      "emit",
      root + "/" + out,
    ]).output()
    r.check()
  }
  for (name, bytes) in programs {
    @fs.write_file(
      root + "/program-" + name + ".bin",
      bytes,
      create_mode=CreateNew,
    )
  }
  let segments : Json = {
    "full_sha256": hash(program),
    "prefill_sha256": hash(first),
    "decode_sha256": hash(last),
    "split_descriptor": split,
    "scope": "Exact original descriptor bytes split at the fourth embedding LOAD;HALT appended to prefill;decode retains original HALT. No tensor calculation.",
  }
  @fs.write_file(
    root + "/segments.json",
    segments.stringify(indent=2) + "\n",
    create_mode=CreateNew,
  )

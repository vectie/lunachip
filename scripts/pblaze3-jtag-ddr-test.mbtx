///|
async fn write(path : String, data : &@io.Data) -> Unit {
  @fs.write_file(path, data, create_mode=CreateNew)
}

///|
async fn prepare(device : String, output : String) -> String {
  guard device == "xc7k325t_0" else { fail("expected exact device xc7k325t_0") }
  guard !@fs.exists(output) else { fail("output must be fresh") }
  @fs.mkdir(output, recursive=true)
  let root = @fs.realpath(output)
  let rows = plan_rows()
  write(root + "/plan.tsv", rows.join("\n") + "\n")
  write(root + "/hardware.tcl", hardware_tcl + "\n")
  let metadata : Json = {
    "schema": "pblaze3-jtag-ddr-sparse-v1",
    "device": device,
    "target": "localhost:3121/xilinx_tcf/Digilent/261020153153",
    "part": "xc7k325t",
    "idcode": "43651093",
    "aperture_bytes": 2147483648.0,
    "status_address": "80000000",
    "status_expected": "0000000f",
    "sampled_words": addresses().length(),
    "passes": 2,
    "transactions": rows.length(),
    "plan_sha256": sha(@fs.read_file(root + "/plan.tsv").binary()),
    "tcl_sha256": sha(@fs.read_file(root + "/hardware.tcl").binary()),
    "scope": "Sparse address-line/alias check only; not a full memory sweep or proof that every byte works. Configured 2GiB aperture cannot exclude 4GiB physical capacity. Destructively overwrites sampled words.",
    "image_identity": "Device identity and health registers cannot identify the programmed image. Physical interpretation requires the separately pinned JTAG-DDR bitstream and successful programming receipt in the enclosing evidence archive.",
  }
  write(root + "/plan.json", metadata.stringify(indent=2))
  root
}

///|
async fn audit(root : String) -> Json {
  let rows = plan_rows()
  assert_eq(@fs.read_file(root + "/plan.tsv").text(), rows.join("\n") + "\n")
  assert_eq(@fs.read_file(root + "/hardware.tcl").text(), hardware_tcl + "\n")
  assert_eq(@fs.read_file(root + "/exit.txt").text(), "0\n")
  let expected = rows.mapi((i, row) => (i + 1).to_string() + "\t" + row)
  assert_eq(
    @fs.read_file(root + "/attempts.tsv").text(),
    expected.join("\n") + "\n",
  )
  let actual = @fs.read_file(root + "/transactions.tsv").text()
  let lines = actual.split("\n").to_array()
  assert_eq(lines.length(), rows.length() + 1)
  assert_eq(lines[rows.length()], "")
  for i in 0..<rows.length() {
    let fields = lines[i].split("\t").map(s => s.to_owned()).to_array()
    guard fields.length() == 9 else {
      fail("malformed transaction row " + i.to_string())
    }
    assert_eq(fields[:5].join("\t"), expected[i])
    let raw = fields[5]
      .replace_all(old="_", new="")
      .replace_all(old=" ", new="")
      .to_lower()
    assert_eq(raw, fields[4])
    assert_eq(fields[6:], ["OKAY", "0", "1"])
  }
  let identity = @fs.read_file(root + "/hardware-identity.tsv")
    .text()
    .split("\t")
    .to_array()
  guard identity.length() == 6 &&
    identity[0] == "localhost:3121/xilinx_tcf/Digilent/261020153153" &&
    identity[1] == "xc7k325t_0" &&
    identity[2] == "xc7k325t" &&
    identity[3] == "43651093" &&
    !identity[4].is_empty() &&
    identity[5] == "AXI4_Full\n" else {
    fail("hardware identity receipt mismatch")
  }
  assert_true(!@fs.read_file(root + "/version.txt").text().is_empty())
  let marker = "PBLAZE3_DDR_SPARSE_COMPLETE=" + rows.length().to_string()
  assert_eq(
    @fs.read_file(root + "/stdout.log")
    .text()
    .replace_all(old="\r\n", new="\n")
    .split("\n")
    .filter(s => s == marker)
    .count(),
    1,
  )
  {
    "status": "PASS",
    "scope": "Sparse tested-address separation only, not full-memory capacity qualification; physical capacity above configured 2GiB remains unknown.",
    "image_identity": "Requires enclosing archive to bind exact JTAG-DDR bitstream/programming receipt; these target/health checks cannot identify the image.",
    "transactions": rows.length(),
    "sampled_words": addresses().length(),
    "passes": 2,
    "plan_sha256": sha(@fs.read_file(root + "/plan.tsv").binary()),
    "transactions_sha256": sha(
      @fs.read_file(root + "/transactions.tsv").binary(),
    ),
    "attempts_sha256": sha(@fs.read_file(root + "/attempts.tsv").binary()),
    "stdout_sha256": sha(@fs.read_file(root + "/stdout.log").binary()),
  }
}

///|
async fn main {
  match @env.args()[1:] {
    ["plan", device, output] => println(prepare(device, output))
    ["audit", root] => println(audit(root).stringify(indent=2))
    ["run", vivado, device, timeout_text, output] => {
      let timeout = @string.parse_int(timeout_text)
      guard timeout >= 1000 &&
        timeout <= 3600000 &&
        vivado.has_prefix("/") &&
        @fs.can_execute(vivado) else {
        fail("absolute executable required; timeout 1000..3600000ms")
      }
      let root = prepare(device, output)
      errdefer write(
        root + "/FAILED.txt",
        "Execution or evidence audit failed; inspect stdout/stderr, attempts.tsv and transactions.tsv. No PASS receipt.\n",
      )
      let launcher = @fs.realpath(vivado)
      let pin = sha(@fs.read_file(launcher).binary())
      let args = [
        "-mode",
        "batch",
        "-notrace",
        "-source",
        root + "/hardware.tcl",
        "-log",
        root + "/vivado.log",
        "-journal",
        root + "/vivado.jou",
        "-tclargs",
        device,
        root,
      ]
      let command : Json = {
        "program": launcher,
        "launcher_sha256": pin,
        "arguments": args,
        "cwd": root,
        "timeout_ms": timeout,
      }
      write(root + "/command.json", command.stringify(indent=2))
      let status = @shell.Cmd(
        launcher,
        args,
        cwd=root,
        stdout=ToFile(root + "/stdout.log"),
        stderr=ToFile(root + "/stderr.log"),
      ).status(timeout_ms=timeout)
      write(root + "/exit.txt", status.to_string() + "\n")
      assert_eq(sha(@fs.read_file(launcher).binary()), pin)
      write(root + "/complete.json", audit(root).stringify(indent=2))
      println(root)
    }
    _ =>
      fail(
        "plan DEVICE NEW_OUTPUT | run ABS_VIVADO DEVICE TIMEOUT_MS NEW_OUTPUT | audit OUTPUT; run overwrites sparse DDR words and never programs the FPGA",
      )
  }
}

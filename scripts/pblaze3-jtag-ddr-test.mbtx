///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/io",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn sha(b : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(b))
}

///|
fn hex(n : UInt32) -> String {
  let s = n.to_string(radix=16)
  "00000000"[:8 - s.length()].to_owned() + s
}

///|
fn addresses() -> Array[UInt32] {
  let a : Array[UInt32] = []
  for i in 0..<2048 {
    a.push(i.reinterpret_as_uint() << 20)
  }
  for bit in 2..<=30 {
    let n = 1U << bit
    for v in [n - 4U, n, n + 4U, 0x7ffffffcU ^ n] {
      if !a.contains(v) {
        a.push(v)
      }
    }
  }
  for v in [4U, 8U, 12U, 0x7ffffff0U, 0x7ffffff4U, 0x7ffffff8U, 0x7ffffffcU] {
    if !a.contains(v) {
      a.push(v)
    }
  }
  a.sort()
  a
}

///|
fn plan_rows() -> Array[String] {
  let a = addresses()
  let rows : Array[String] = []
  for pass in 0..<2 {
    let seed = if pass == 0 { 0x13579bdfU } else { 0xeca86420U }
    let phase = pass.to_string()
    rows.push(phase + "-before\tR\t80000000\t0000000f")
    let order = Array::makei(a.length(), i => {
      if pass == 0 {
        i
      } else {
        a.length() - 1 - i
      }
    })
    for i in order {
      let data = seed ^ ((i + 1).reinterpret_as_uint() * 0x9e3779b9U)
      rows.push(phase + "-write\tW\t" + hex(a[i]) + "\t" + hex(data))
    }
    rows.push(phase + "-written\tR\t80000000\t0000000f")
    for j in 0..<order.length() {
      let i = order[order.length() - 1 - j]
      let data = seed ^ ((i + 1).reinterpret_as_uint() * 0x9e3779b9U)
      rows.push(phase + "-read\tR\t" + hex(a[i]) + "\t" + hex(data))
    }
    rows.push(phase + "-after\tR\t80000000\t0000000f")
  }
  rows
}


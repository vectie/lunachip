import {"moonbitlang/async@0.22.4","moonbitlang/async@0.22.4/fs","moonbitlang/core/env","moonbitlang/core/json","moonbitlang/core/string","moonbitlang/x@0.5.1/crypto"}
fn n(s : StringView) -> Int {@string.parse_int(s) catch {_=>abort("decimal")}}
fn hash(b : Bytes) -> String {@crypto.bytes_to_hex_string(@crypto.sha256(b))}
fn field(j : Json,k : String) -> Json {guard j is Object(m) else {abort("object")};m[k]}
async fn main {
 guard @env.args()[1:] is [root,out] && !@fs.exists(out) else {fail("CPU_AUDITED_ROOT NEW_JSON")}
 let audit=@json.parse(@fs.read_file(root+"/audit.json").text());assert_eq(field(audit,"status"),"PASS")
 assert_eq(field(audit,"raw_sha256"),hash(@fs.read_file(root+"/transactions.tsv").binary()).to_json());assert_eq(field(audit,"results_sha256"),hash(@fs.read_file(root+"/results.tsv").binary()).to_json())
 let raw=@fs.read_file(root+"/transactions.tsv").text().split("\n").filter(s=>s!="").map(s=>s.split("\t").to_array()).to_array()
 let groups=@fs.read_file(root+"/queues.tsv").text().split("\n").filter(s=>s!="").map(s=>s.split("\t").to_array()).to_array()
 assert_eq(groups[0].join("\t"),"first_sequence\ttransactions\top\twords\tprepare_us\trun_us\tfinish_us\ttotal_us\tresponse")
 let covered : Set[Int]=Set([]);let counts=Array::make(2,0);let words=Array::make(2,0);let us=Array::make(4,0)
 let mut diagnostics=0
 guard field(audit,"metrics") is Array(metrics) && [11,16].contains(metrics.length()) else {fail("audited batch metrics")}
 for g in groups[1:] {
  assert_eq(g.length(),9);let first=n(g[0]);let count=n(g[1]);let op=g[2];assert_true(["R","W"].contains(op.to_owned()));assert_true(count>=1 && count<=16);assert_eq(g[8],"OKAY");assert_true(n(g[5])>0)
  let diagnostic=raw[first+count-1][2]=="00000030"
  if diagnostic {
   assert_eq(op,"R");assert_true(count==2 || count==3)
   assert_eq(raw[first-1][1],"R");assert_eq(raw[first-1][2],"00000008");assert_eq(n(raw[first-1][3]),2);assert_eq(raw[first-1][5],"00000005,00000000");assert_true(["OKAY","LAUNCH_OKAY"].contains(raw[first-1][6].to_owned()))
   assert_eq(n(raw[first+count-1][3]),34)
   let mut expected=0x10300000U
   for i in first..<(first+count-1) {assert_eq(@string.parse_uint(raw[i][2],base=16),expected);expected+=n(raw[i][3]).reinterpret_as_uint()*4U}
   guard field(metrics[diagnostics],"jobs") is Number(jobs,..) else {fail("jobs")}
   assert_eq(expected,0x10300000U+jobs.to_uint()*32U);assert_true(expected<=0x10300600U);diagnostics+=1
  }
  let mut totalwords=0
  for i in first..<(first+count) {
   assert_false(covered.contains(i));covered.add(i);let r=raw[i];assert_eq(n(r[0]),i);assert_eq(r[1],op);assert_true(["GROUP_OKAY","GROUP_SUBMITTED"].contains(r[6].to_owned()));if r[6]=="GROUP_SUBMITTED" {assert_eq(op,"W");assert_eq(r[5],"-")};assert_eq(n(r[7]),0)
   let a=@string.parse_uint(r[2],base=16);let len=n(r[3]);assert_true(len>=1 && len<=256 && (a&4095U)+len.reinterpret_as_uint()*4U<=4096U)
   if !(diagnostic && i==first+count-1) {assert_true(a>=0x10000000U && a<0x20000000U && a+len.reinterpret_as_uint()*4U<=0x20000000U)}
   totalwords+=len
  }
  assert_eq(totalwords,n(g[3]));let direction=if op=="R"{0}else{1};counts[direction]+=1;words[direction]+=totalwords
  assert_eq(n(g[7]),n(g[4])+n(g[5])+n(g[6]));for i in 0..<4 {let value=n(g[4+i]);assert_true(value>=0);us[i]+=value}
 }
 for i in 1..<raw.length() {assert_eq(covered.contains(i),["GROUP_OKAY","GROUP_SUBMITTED"].contains(raw[i][6].to_owned()))}
 let board=@json.parse(@fs.read_file(root+"/receipt.json").text())
 assert_true(["joined".to_json(),"coalesced".to_json()].contains(field(board,"mode")))
 let coalesced=field(board,"mode")=="coalesced".to_json();assert_eq(diagnostics,if coalesced{11}else{16});assert_eq(counts,if coalesced{[17,4]}else{[22,4]});assert_eq(words,if coalesced{[18118,11264]}else{[18288,11264]});assert_eq(covered.length(),if coalesced{133}else{143})
 let compact=true;let mut descriptors=0;let mut starts=0;let mut errors=0;let mut snapshots=0
 for r in raw[1:] {
  if r[6]=="SLVERR" {continue}
  if r[1]=="W" && r[2]=="00000020" {assert_eq(n(r[3]),3);descriptors+=1}
  if r[1]=="W" && r[2]=="00000010" && r[4]=="00000001" {starts+=1}
  if r[1]=="R" && r[2]=="0000000c" {errors+=1}
  if r[1]=="R" && r[2]=="00000008" && starts>0 {assert_eq(n(r[3]),if compact {2}else{1});snapshots+=1}
 }
 assert_eq(starts,if coalesced{11}else{16});assert_eq(descriptors,if coalesced{11}else{10});assert_eq(errors,if compact {0}else{16});assert_true(snapshots>=starts)
 let result : Json={"status":"PASS","groups":groups.length()-1,"read_groups":counts[0],"write_groups":counts[1],"read_words":words[0],"write_words":words[1],"transactions":covered.length(),"diagnostic_groups":diagnostics,"completed_read_dispatch":field(board,"completed_read_dispatch"),"prepare_us":us[0],"run_us":us[1],"finish_us":us[2],"total_us":us[3],"raw_sha256":hash(@fs.read_file(root+"/transactions.tsv").binary()),"queues_sha256":hash(@fs.read_file(root+"/queues.tsv").binary()),"scope":"Complete homogeneous command-group coverage: DDR groups or exact full result range then34 counters after DONE/error0. At most16 bursts,each<=256words,no4KiB crossing; exact physical campaign shapes/totals. Legacy queues.tsv includes non-queued list groups,explicit dispatch recorded. GROUP_OKAY is final response only; CPU and policy audits separately required."}
 @fs.write_file(out,result.stringify(indent=2)+"\n",create_mode=CreateNew);println("PASS complete DDR queue group coverage and byte accounting")
}

///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn hash(b : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(b))
}

///|
async fn main {
  guard @env.args()[1:] is ["run", build, root] &&
    build.has_prefix("/work/builds/prx100-ddr-route-") &&
    root.has_prefix("/work/builds/prx100-ddr-board-") &&
    !@fs.exists(root) else {
    fail("run QUALIFIED_ROUTE NEW_BOARD_ROOT")
  }
  assert_eq(@fs.read_file(build + "/exit.txt").text(), "0\n")
  assert_true(
    @fs.read_file(build + "/repair.stdout")
    .text()
    .contains("PRX100_DDR_REPAIRED_PASS"),
  )
  assert_true(
    @fs.read_file(build + "/ui-clock.txt")
    .text()
    .contains("frequency_hz=100000000"),
  )
  let bit = build + "/prx100_ddr.bit"
  let bit_hash = hash(@fs.read_file(bit).binary())
  assert_true(
    @fs.read_file(build + "/bitstream.sha256")
    .text()
    .has_prefix(bit_hash + "  "),
  )
  let tool = "/tools/amd/2025.2/Vivado/bin/vivado"
  guard @json.parse(@fs.read_file("/work/builds/vivado-2025.2-pin.json").text())
    is {
      "executable_sha256": String(tool_hash),
      "version_stdout": String(version),
      ..
    } else {
    fail("Vivado pin required")
  }
  assert_eq(hash(@fs.read_file(tool).binary()), tool_hash)
  let o = @shell.Cmd(tool, ["-version"]).output()
  o.check()
  assert_eq(o.stdout(), version)
  @fs.mkdir(root)
  @fs.write_file(
    root + "/driver.mbtx",
    @fs.read_file("/work/prx100-ddr-board.mbtx").binary(),
    create_mode=CreateNew,
  )
  @fs.write_file(root + "/tool-version.txt", version, create_mode=CreateNew)
  let identity : Json = {
    "scope": "authorized volatile standalone DDR target through identified CPU_TAG; no portable core or flash programming",
    "build": build,
    "bitstream": bit,
    "bitstream_sha256": bit_hash,
    "part": "xc7a100tfgg676-2",
    "idcode": "13631093",
    "cable": "ME10E06D1010A",
    "ui_clock_hz": 100000000,
    "memory_bytes": 268435456,
  }
  @fs.write_file(
    root + "/identity.json",
    identity.stringify(indent=2) + "\n",
    create_mode=CreateNew,
  )
  let tcl = "set bitstream {" +
    bit +
    "}\nset probes {" +
    build +
    "/prx100_ddr.ltx}\n" +
    (
      #|open_hw_manager
      #|connect_hw_server -url localhost:3121
      #|set candidates [get_hw_targets -quiet *ME10E06D1010A]

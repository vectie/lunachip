      #|current_hw_target $target
      #|set_property PARAM.FREQUENCY 1000000 $target
      #|open_hw_target
      #|set devices [get_hw_devices -quiet]
      #|if {[llength $devices] != 1} {error "Expected one FPGA"}
      #|set device [lindex $devices 0]
      #|if {[get_property PART $device] ne "xc7a100t" || [string tolower [get_property IDCODE_HEX $device]] ne "13631093"} {error "FPGA identity mismatch"}
      #|set_property PROGRAM.FILE $bitstream $device
      #|if {[file exists $probes]} {set_property PROBES.FILE $probes $device}
      #|program_hw_devices $device
      #|refresh_hw_device $device
      #|if {[get_property REGISTER.CONFIG_STATUS.BIT13_DONE_INTERNAL_SIGNAL_STATUS $device] ne "1" || [get_property REGISTER.CONFIG_STATUS.BIT14_DONE_PIN $device] ne "1" || [get_property REGISTER.CONFIG_STATUS.BIT00_CRC_ERROR $device] ne "0"} {error "FPGA configuration status failed"}
      #|puts "PROGRAMMED_STANDALONE_DDR_DONE=1 CRC_ERROR=0"
      #|set axes [get_hw_axis -quiet]
      #|if {[llength $axes] != 1} {error "Expected one JTAG-to-AXI diagnostic core, found $axes"}
      #|set axi [lindex $axes 0]
      #|report_property -all $axi
      #|reset_hw_axi $axi
      #|set sequence 0
      #|proc rd {address} {
      #|  global axi sequence
      #|  set txn [create_hw_axi_txn ddr_rd[incr sequence] $axi -type read -address [format %08x $address] -len 1]
      #|  run_hw_axi $txn
      #|  set raw [get_property DATA $txn]
      #|  if {![regexp {^[0-9a-fA-F]{8}$} $raw]} {error "Malformed32-bit AXI data: $raw"}
      #|  scan $raw %x data
      #|  delete_hw_axi_txn $txn
      #|  return $data
      #|}
      #|proc wr {address data} {
      #|  global axi sequence
      #|  set txn [create_hw_axi_txn ddr_wr[incr sequence] $axi -type write -address [format %08x $address] -data [format %08x $data] -len 1]
      #|  run_hw_axi $txn
      #|  delete_hw_axi_txn $txn
      #|}
      #|proc reference_word {index lane seed} {
      #|  set salts {0x13579bdf 0x2468ace0 0x9e3779b9 0x5a5aa5a5}
      #|  set x [expr {(($index*16) ^ $seed ^ [lindex $salts $lane]) & 0xffffffff}]
      #|  set x [expr {($x ^ ($x<<13)) & 0xffffffff}]
      #|  set x [expr {($x ^ ($x>>17)) & 0xffffffff}]
      #|  return [expr {($x ^ ($x<<5)) & 0xffffffff}]
      #|}
      #|if {[rd 0] != 0x44445233 || [rd 4] != 0x00010000 || [rd 100] != 100000000 || [rd 104] != 16} {error "Wrong DDR diagnostic register identity"}
      #|set calibrated 0
      #|for {set i 0} {$i<600} {incr i} {
      #|  if {([rd 8]&1)!=0} {set calibrated 1;break}
      #|  after 50
      #|}
      #|if {!$calibrated} {error "DDR3 calibration timeout"}
      #|puts "DDR3_INIT_CALIB_COMPLETE=1"
      #|set out [open memory.tsv w]
      #|puts $out "name	mode	seed	command	beats	flags	error	writes	write_data	reads	checked	mismatches	write_cycles	read_cycles	first_address	expected0	expected1	expected2	expected3	actual0	actual1	actual2	actual3	diagnostic_us"
      #|flush $out
      #|proc run_case {name mode seed command beats idle expected_bad correct_seed} {
      #|  global out
      #|  if {$idle>0} {after $idle}
      #|  set begin [clock microseconds]
      #|  wr 20 $seed
      #|  wr 24 $beats
      #|  wr 28 $mode
      #|  wr 16 $command
      #|  set done 0
      #|  for {set i 0} {$i<1200} {incr i} {
      #|    set flags [rd 8]
      #|    if {($flags&1)==0} {error "Calibration lost in $name"}
      #|    if {($flags&4)!=0} {set done 1;break}
      #|    after 50
      #|  }
      #|  if {!$done} {error "DDR test timeout: $name"}
      #|  set error [rd 12]
      #|  set writes [rd 32]
      #|  set data [rd 108]
      #|  set reads [rd 36]
      #|  set checked [rd 40]
      #|  set mismatches [rd 44]
      #|  set wc [expr {[rd 48]+(wide([rd 52])<<32)}]
      #|  set rc [expr {[rd 56]+(wide([rd 60])<<32)}]
      #|  set first [rd 64]
      #|  set expected {};set actual {}
      #|  foreach address {68 72 76 80} {lappend expected [rd $address]}
      #|  foreach address {84 88 92 96} {lappend actual [rd $address]}
      #|  set elapsed [expr {[clock microseconds]-$begin}]
      #|  puts $out [join [concat [list $name $mode $seed $command $beats $flags $error $writes $data $reads $checked $mismatches $wc $rc $first] $expected $actual [list $elapsed]] [format %c 9]]
      #|  flush $out
      #|  if {$error!=0 || ($flags&2)!=0} {error "DDR controller fault in $name: code=$error flags=$flags"}
      #|  set expected_writes [expr {($command&2)!=0 ? 0 : $beats}]
      #|  set expected_reads [expr {($command&4)!=0 ? 0 : $beats}]
      #|  if {$writes!=$expected_writes || $data!=$expected_writes || $reads!=$expected_reads || $checked!=$expected_reads} {error "Incomplete memory coverage in $name"}
      #|  if {($expected_writes>0 && $wc<=0) || ($expected_reads>0 && $rc<=0)} {error "Missing phase timing in $name"}
      #|  if {$mismatches!=$expected_bad || (($flags&8)!=0)!=($expected_bad>0)} {error "Unexpected DDR mismatches in $name: $mismatches"}
      #|  if {$expected_bad>0} {
      #|    set first_index [expr {($command&8)!=0 ? $beats-1 : 0}]
      #|    if {$first!=$first_index*16} {error "Wrong first mismatch address in $name"}
      #|    for {set lane 0} {$lane<4} {incr lane} {
      #|      if {[lindex $actual $lane]!=[reference_word $first_index $lane $correct_seed]} {error "CPU readback reference failed in $name lane$lane"}
      #|      if {[lindex $expected $lane]!=[reference_word $first_index $lane $seed]} {error "CPU expected-pattern reference failed in $name lane$lane"}
      #|    }
      #|  }
      #|  puts "MEMORY_CASE_PASS $name beats=$beats mismatches=$mismatches write_cycles=$wc read_cycles=$rc diagnostic_us=$elapsed"
      #|}
      #|run_case small-address 4 0x70101626 1 4096 0 0 0
      #|foreach spec {
      #|  {full-zero 0 0 1} {full-ones 1 0 9}
      #|  {full-checker-a 2 0 1} {full-checker-5 3 0 9}
      #|  {full-address 4 0x70101626 1} {full-inverse 5 0x70101626 9}
      #|  {mask-baseline 0 0 1} {mask-even-bytes 6 0xaabbccdd 1} {mask-odd-bytes 7 0xaabbccdd 9}
      #|} {
      #|  lassign $spec name mode seed command
      #|  run_case $name $mode $seed $command 16777216 0 0 0
      #|}
      #|run_case mask-retention 7 0xaabbccdd 11 16777216 5000 0 0
      #|foreach seed {0x10203040 0x89abcdef 0x76543210} {
      #|  run_case repeat-$seed 4 $seed 9 16777216 0 0 0
      #|}
      #|run_case address-retention 4 0x76543210 3 16777216 10000 0 0
      #|run_case negative-first-address 4 0x76543211 3 16777216 0 16777216 0x76543210
      #|run_case negative-last-address 4 0x76543211 11 16777216 0 16777216 0x76543210
      #|run_case final-clean-read 4 0x76543210 11 16777216 0 0 0
      #|close $out
      #|puts "PRX100_DDR_FULL_MEMORY_CAMPAIGN_PASS"
      #|close_hw_target
      #|disconnect_hw_server
      #|close_hw_manager
    )
  @fs.write_file(root + "/board.tcl", tcl + "\n", create_mode=CreateNew)
  let server = @shell.Cmd(
    "sudo",
    [
      "-n",
      "/tools/amd/2025.2/Vivado/bin/hw_server",
      "-d",
      "-I300",
      "-p0",
      "-sTCP:127.0.0.1:3121",
      "-L" + root + "/hw-server.log",
    ],
    stdout=ToFile(root + "/server.stdout"),
    stderr=ToFile(root + "/server.stderr"),
  ).status()
  @fs.write_file(
    root + "/server-exit.txt",
    server.to_string() + "\n",
    create_mode=CreateNew,
  )
  assert_eq(server, 0)
  let code = @shell.Cmd(
    "timeout",
    ["2400s", tool, "-mode", "batch", "-notrace", "-source", "board.tcl"],
    cwd=root,
    stdout=ToFile(root + "/board.stdout"),
    stderr=ToFile(root + "/board.stderr"),
  ).status()
  @fs.write_file(
    root + "/exit.txt",
    code.to_string() + "\n",
    create_mode=CreateNew,
  )
  assert_eq(code, 0)
  assert_eq(hash(@fs.read_file(bit).binary()), bit_hash)
  assert_true(
    @fs.read_file(root + "/board.stdout")
    .text()
    .contains("PRX100_DDR_FULL_MEMORY_CAMPAIGN_PASS"),
  )
  println(
    "PASS: calibrated standalone DDR and complete memory campaign; inspect captured phase counters for bandwidth",
  )
}

///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn field(j : Json, key : String) -> Json raise {
  guard j is Object(m) else { fail("object required") }
  m.get(key).unwrap()
}

///|
fn array(j : Json) -> Array[Json] raise {
  guard j is Array(a) else { fail("array required") }
  a
}

///|
fn num(j : Json) -> Double raise {
  match j {
    Number(n, ..) => n
    String(s) => @string.parse_double(s)
    _ => fail("number or decimal64-bit JSON string required")
  }
}

///|
fn int(j : Json) -> Int raise {
  num(j).to_int()
}

///|
fn uint(j : Json) -> UInt raise {
  num(j).to_uint()
}

///|
fn text(j : Json) -> String raise {
  guard j is String(s) else { fail("string required") }
  s
}

///|
fn stat(values : Array[Double]) -> Json raise {
  assert_true(values.length() > 0)
  let a = values.copy()
  a.sort()
  let n = a.length()
  {
    "min": a[0],
    "median": (a[(n - 1) / 2] + a[n / 2]) / 2.0,
    "max": a[n - 1],
    "samples": n,
  }
}

///|
fn dot(a : Array[Int], w : Array[Int], tile : Int, j : Int) -> Int64 {
  let mut sum = 0L
  for k in (tile * 16)..<(tile * 16 + 16) {
    sum += a[k].to_int64() * w[j * 1024 + k].to_int64()
  }
  sum
}

///|
async fn load(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
async fn main {
  guard @env.args()[1:] is ["audit", root, inputs, output] &&
    !@fs.exists(output) else {
    fail("audit BOARD_ROOT FIXTURE_ROOT NEW_REPORT_JSON")
  }
  assert_eq(@fs.read_file(root + "/exit.txt").text(), "0\n")
  let raw = @fs.read_file(inputs + "/fixture.json")
  assert_eq(
    @crypto.bytes_to_hex_string(@crypto.sha256(raw.binary())),
    "409ca5210ca8a10a2799f66590ab0ccee51f1cc501d8dc738a1334a71dfe225e",
  )
  let fixture = @json.parse(raw.text())
  let weights = array(field(fixture, "weights_int8_row_major")).map(x => int(x))
  let source = array(field(fixture, "inputs"))
  let vectors = source.map(x => {
    array(field(x, "activation_int8")).map(x => int(x))
  })
  assert_eq(weights.length(), 8192)
  assert_eq(vectors.length(), 3)
  for n in weights {
    assert_true(n >= -127 && n <= 127)
  }
  for a in vectors {
    assert_eq(a.length(), 1024)
    for n in a {
      assert_true(n >= -127 && n <= 127)
    }
  }
  // Reconstruct packing from the original row-major fixture, independently of
  // the preparer's word files and expected-partial tables.
  let operands : Map[UInt, UInt] = Map([])
  for tile in 0..<64 {
    for word in 0..<32 {
      let mut packed = 0U
      for lane in 0..<4 {
        let i = word * 4 + lane
        packed = packed |
          (
            (
              weights[i % 8 * 1024 + tile * 16 + i / 8].reinterpret_as_uint() &
              255U
            ) <<
            (lane * 8)
          )
      }
      operands[0x10100000U + (tile * 128 + word * 4).reinterpret_as_uint()] = packed
    }
  }
  for v, a in vectors {
    for word in 0..<256 {
      let mut packed = 0U
      for lane in 0..<4 {
        packed = packed |
          ((a[word * 4 + lane].reinterpret_as_uint() & 255U) << (lane * 8))
      }
      operands[0x10200000U +
      v.reinterpret_as_uint() * 0x10000U +
      word.reinterpret_as_uint() * 4U] = packed
    }
  }
  assert_eq(operands.length(), 2816)
  let memory : Map[UInt, UInt] = Map([])
  let guards : Map[UInt, UInt] = Map([])
  for
    (base, size) in [
      (0x10100000U, 8192),
      (0x10200000U, 1024),
      (0x10210000U, 1024),
      (0x10220000U, 1024),
      (0x10300000U, 2048),
      (0x10400000U, 32),
    ] {
    guards[base - 4U] = 0xa5a5a5a5U
    guards[base + size.reinterpret_as_uint()] = 0xdeadbeefU
  }
  let jobs = array(load(root + "/jobs.json"))
  let txns = array(load(root + "/transactions.json"))
  let partials = array(load(root + "/partials.json"))
  assert_eq(jobs.length(), 20)
  assert_eq(partials.length(), 1560)
  let log = @fs.read_file(root + "/vivado.stdout").text()
  for
    marker in [
      "PRX_PROGRAMMED DONE=1 CRC_ERROR=0", "PRX_READY\t50524433\t00010007\t50000000",
      "PRX_FINISHED",
    ] {
    assert_true(log.contains(marker))
  }
  let lines = log.split("\n").filter(x => x.has_prefix("PRX_AXI\t")).to_array()
  assert_eq(lines.length(), txns.length())
  let starts : Map[Int, Int] = Map([])
  let names : Map[String, Int] = Map([])
  let full_ms : Array[Double] = []
  let resident_ms : Array[Double] = []
  let host_resident : Array[Double] = []
  let ddr_ms : Array[Double] = []
  let core_ms : Array[Double] = []
  let stage_ms : Array[Double] = []
  let mut next_first = -1
  for n, job in jobs {
    let (expected_name, v, tiles) = if n == 0 {
      ("smoke-k16", 0, 1)
    } else if n == 1 {
      ("smoke-k32", 0, 2)
    } else if n < 5 {
      ("qwen-vector-" + (n - 2).to_string(), n - 2, 64)
    } else {
      let i = n - 5
      ("resident-" + (i / 3).to_string() + "-" + (i % 3).to_string(), i % 3, 64)
    }
    assert_eq(text(field(job, "name")), expected_name)
    assert_eq(int(field(job, "vector")), v)
    assert_eq(int(field(job, "tiles")), tiles)
    names[expected_name] = n
    let first = int(field(job, "first_sequence"))
    let last = int(field(job, "last_sequence"))
    assert_true(first > next_first && last >= first && last < txns.length())
    assert_eq(last - first + 1, int(field(job, "transactions")))
    starts[first + 2] = n
    next_first = last
    let seen : Map[UInt, UInt] = Map([])
    let read_counts : Map[UInt, Int] = Map([])
    let mut rtt = 0.0
    for i in first..<(last + 1) {
      let txn = txns[i]
      rtt += num(field(txn, "rtt_ms"))
      if field(txn, "op") == "R" {
        let address = uint(field(txn, "address"))
        read_counts[address] = read_counts.get(address).unwrap_or(0) + 1
        if address < 0x10000000U {
          seen[address] = uint(field(txn, "returned"))
        }
      }
    }
    assert_eq(rtt, num(field(job, "rtt_sum_ms")))
    for
      (address, key) in [
        (56U, "job_cycles"),
        (64U, "ddr_wait_cycles"),
        (72U, "core_wait_cycles"),
        (80U, "operand_staging_cycles"),
        (88U, "compute_counter_cycles"),
      ] {
      assert_eq(seen[address + 4U], 0U)
      assert_eq(seen[address].to_double(), num(field(job, key)))
    }
    assert_eq(seen[8U], 5U)
    assert_eq(seen[12U], 0U)
    for
      (address, value) in [
        (44U, tiles),
        (48U, tiles * 4),
        (52U, tiles * 8),
        (96U, tiles * 36),
        (100U, tiles * 2),
        (104U, tiles * 2 + 2),
        (108U, tiles * 4),
        (112U, tiles * 4),
      ] {
      assert_eq(seen[address], value.reinterpret_as_uint())
    }
    assert_eq(seen[88U], (tiles * 24).reinterpret_as_uint())
    for
      (address, key, expected) in [
        (160U, "core_read_requests", tiles * 68),
        (164U, "core_write_requests", tiles * 8),
        (168U, "core_byte_read_requests", 0),
        (172U, "core_word_read_requests", tiles * 68),
      ] {
      assert_eq(seen[address], expected.reinterpret_as_uint())
      assert_eq(uint(field(job, key)), seen[address])
      assert_eq(read_counts[address], 1)
    }
    let cycles = seen[56U]
    assert_true(
      cycles > seen[88U] &&
      cycles < 50000000U &&
      seen[64U] > 0U &&
      seen[72U] > 0U,
    )
    assert_eq(num(field(job, "job_counter_ns")), cycles.to_double() * 20.0)
    let actual = array(field(job, "integer_actual"))
    assert_eq(actual.length(), 8)
    for j in 0..<8 {
      let mut sum = 0L
      for tile in 0..<tiles {
        sum += dot(vectors[v], weights, tile, j)
      }
      assert_eq(int(actual[j]), sum.to_int())
      assert_eq(
        seen[128U + j.reinterpret_as_uint() * 4U],
        sum.to_int().reinterpret_as_uint(),
      )
      assert_eq(read_counts[0x10400000U + j.reinterpret_as_uint() * 4U], 1)
      assert_eq(read_counts[128U + j.reinterpret_as_uint() * 4U], 1)
    }
    if n >= 2 {
      full_ms.push(cycles.to_double() / 50000.0)
      ddr_ms.push(seen[64U].to_double() / 50000.0)
      core_ms.push(seen[72U].to_double() / 50000.0)
      stage_ms.push(seen[80U].to_double() / 50000.0)
    }
    if n >= 5 {
      resident_ms.push(cycles.to_double() / 50000.0)
      host_resident.push(num(field(job, "host_launch_to_observed_done_ms")))
    }
  }
  let sums : Map[UInt, UInt] = Map([])
  let config : Map[UInt, UInt] = Map([])
  let write_counts : Map[UInt, Int] = Map([])
  let read_counts : Map[UInt, Int] = Map([])
  let mut operand_writes = 0
  let mut operand_reads = 0
  let mut guard_reads = 0
  let mut output_reads = 0
  let mut launch_count = 0
  let mut total_rtt = 0.0
  for seq, txn in txns {
    assert_eq(int(field(txn, "seq")), seq)
    let op = text(field(txn, "op"))
    let addr = uint(field(txn, "address"))
    let data = uint(field(txn, "write_data"))
    let returned = uint(field(txn, "returned"))
    let f = lines[seq].split("\t").to_array()
    assert_eq(f.length(), 6)
    assert_eq(@string.parse_int(f[1]), seq)
    assert_eq(f[2], op)
    assert_eq(@string.parse_uint(f[3], base=16), addr)
    assert_eq(@string.parse_uint(f[4], base=16), returned)
    assert_eq(f[5], "OKAY")
    assert_true(num(field(txn, "rtt_ms")) >= 0.0)
    total_rtt += num(field(txn, "rtt_ms"))
    if op == "W" {
      assert_eq(returned, data)
      if addr >= 0x10000000U {
        write_counts[addr] = write_counts.get(addr).unwrap_or(0) + 1
        if operands.get(addr) is Some(expected) {
          assert_eq(data, expected)
          operand_writes += 1
        } else if guards.get(addr) is Some(expected) {
          assert_eq(data, expected)
        } else if (addr >= 0x10300000U && addr < 0x10300800U) ||
          (addr >= 0x10400000U && addr < 0x10400020U) {
          assert_eq(data, 0x13579bdfU)
        } else {
          let base = if addr < 0x10000010U { 0x10000000U } else { 0x1ffffff0U }
          assert_true(addr >= base && addr < base + 16U)
          assert_eq(data, 0x13579bdfU ^ base ^ ((addr - base) / 4U))
        }
        memory[addr] = data
      } else if addr == 16U {
        assert_eq(data, 1U)
        let index = starts[seq]
        assert_eq(index, launch_count)
        launch_count += 1
        let job = jobs[index]
        let v = int(field(job, "vector"))
        let tiles = int(field(job, "tiles"))
        assert_eq(config[20U], 0x100000U)
        assert_eq(config[24U], 0x200000U + v.reinterpret_as_uint() * 0x10000U)
        assert_eq(config[28U], 0x300000U)
        assert_eq(config[32U], 0x400000U)
        assert_eq(config[36U], tiles.reinterpret_as_uint())
        for j in 0..<8 {
          let mut sum = 0L
          for tile in 0..<tiles {
            let p = dot(vectors[v], weights, tile, j)
            memory[0x10300000U + (tile * 32 + j * 4).reinterpret_as_uint()] = p
              .to_int()
              .reinterpret_as_uint()
            sum += p
          }
          memory[0x10400000U + j.reinterpret_as_uint() * 4U] = sum
            .to_int()
            .reinterpret_as_uint()
          sums[128U + j.reinterpret_as_uint() * 4U] = sum
            .to_int()
            .reinterpret_as_uint()
        }
      } else {
        assert_true([20U, 24U, 28U, 32U, 36U].contains(addr))
        config[addr] = data
      }
    } else {
      assert_eq(op, "R")
      assert_eq(data, 0U)
      if addr >= 0x10000000U {
        read_counts[addr] = read_counts.get(addr).unwrap_or(0) + 1
        guard returned == memory[addr] else {
          fail(
            "CPU DDR read mismatch at sequence" +
            seq.to_string() +
            ": expected " +
            memory[addr].to_string() +
            " observed " +
            returned.to_string(),
          )
        }
        if operands.contains(addr) {
          operand_reads += 1
        }
        if guards.contains(addr) {
          guard_reads += 1
        }
        if (addr >= 0x10300000U && addr < 0x10300800U) ||
          (addr >= 0x10400000U && addr < 0x10400020U) {
          output_reads += 1
        }
      } else if sums.get(addr) is Some(expected) {
        assert_eq(returned, expected)
      } else {
        assert_true(
          [
            8U, 12U, 44U, 48U, 52U, 56U, 60U, 64U, 68U, 72U, 76U, 80U, 84U, 88U,
            92U, 96U, 100U, 104U, 108U, 112U, 160U, 164U, 168U, 172U,
          ].contains(addr),
        )
      }
    }
  }
  assert_eq(launch_count, 20)
  assert_eq(operand_writes, 2816)
  assert_eq(operand_reads, 5632)
  assert_eq(guard_reads, 12)
  assert_eq(output_reads, 1720)
  for addr, _ in operands {
    assert_eq(write_counts[addr], 1)
    assert_eq(read_counts[addr], 2)
  }
  for addr, _ in guards {
    assert_eq(write_counts[addr], 1)
    assert_eq(read_counts[addr], 1)
  }
  let seen_partials : Map[String, Bool] = Map([])
  for p in partials {
    let name = text(field(p, "job"))
    let index = names[name]
    assert_true(index < 5)
    let job = jobs[index]
    let v = int(field(p, "vector"))
    let tile = int(field(p, "tile"))
    let j = int(field(p, "channel"))
    assert_eq(v, int(field(job, "vector")))
    assert_true(tile >= 0 && tile < int(field(job, "tiles")) && j >= 0 && j < 8)
    let addr = 0x10300000U + (tile * 32 + j * 4).reinterpret_as_uint()
    assert_eq(uint(field(p, "address")), addr)
    assert_eq(
      uint(field(p, "actual")),
      dot(vectors[v], weights, tile, j).to_int().reinterpret_as_uint(),
    )
    let key = name + "/" + tile.to_string() + "/" + j.to_string()
    assert_false(seen_partials.contains(key))
    seen_partials[key] = true
    let matching = txns[int(field(job, "first_sequence")):int(
      field(job, "last_sequence"),
    ) +
    1].filter(t => field(t, "op") == "R" && uint(field(t, "address")) == addr)
    assert_eq(matching.length(), 1)
    assert_eq(field(matching[0], "returned"), field(p, "actual"))
  }
  let scales = array(field(fixture, "weight_scales")).map(x => num(x))
  let fp_weights = array(field(fixture, "weights_fp64_row_major")).map(x => {
    num(x)
  })
  let quantization : Array[Json] = []
  for v, input in source {
    let fp_activation = array(field(input, "activation_fp64")).map(x => num(x))
    let original = array(field(input, "cpu_original_fp64")).map(x => num(x))
    let expected = array(field(input, "cpu_int32")).map(x => int(x))
    let dequant = array(field(input, "cpu_dot_of_dequantized_inputs_fp64")).map(x => {
        num(x)
      },
    )
    let mut max_error = 0.0
    let mut e = 0.0
    let mut energy = 0.0
    for j in 0..<8 {
      let mut original_dot = 0.0
      for k in 0..<1024 {
        original_dot += fp_activation[k] * fp_weights[j * 1024 + k]
      }
      assert_true((original_dot - original[j]).abs() < 1.0e-12)
      let mut s = 0L
      for tile in 0..<64 {
        s += dot(vectors[v], weights, tile, j)
      }
      assert_eq(s.to_int(), expected[j])
      let y = s.to_double() * num(field(input, "activation_scale")) * scales[j]
      assert_true((y - dequant[j]).abs() < 1.0e-9)
      let delta = y - original[j]
      max_error = max_error.max(delta.abs())
      e += delta * delta
      energy += original[j] * original[j]
    }
    quantization.push({
      "vector": v,
      "integer": expected,
      "max_abs_error_vs_original": max_error,
      "relative_l2_error_vs_original": (e / energy).sqrt(),
    })
  }
  let receipt = load(root + "/receipt.json")
  assert_eq(field(receipt, "status"), "PASS")
  assert_eq(int(field(receipt, "total_transactions")), txns.length())
  assert_eq(num(field(receipt, "rtt_sum_ms")), total_rtt)
  let cpu = load(inputs + "/cpu-benchmark.json")
  assert_eq(int(field(cpu, "iterations_per_sample")), 1000)
  assert_eq(int(field(cpu, "sample_count")), 5)
  let cpu_int = array(field(cpu, "integer_total_ms")).map(x => num(x))
  let cpu_fp = array(field(cpu, "fp64_total_ms")).map(x => num(x))
  assert_eq(cpu_int.length(), 5)
  assert_eq(cpu_fp.length(), 5)
  let report : Json = {
    "status": "PASS",
    "identity": load(root + "/identity.json"),
    "fixture_sha256": "409ca5210ca8a10a2799f66590ab0ccee51f1cc501d8dc738a1334a71dfe225e",
    "jobs": 20,
    "full_k1024_jobs": 18,
    "independently_verified_partial_words": 1560,
    "independently_verified_final_words": 160,
    "raw_okay_transactions": txns.length(),
    "operand_bytes": 11264,
    "guard_words": 12,
    "fpga_full_job_ms_all18": stat(full_ms),
    "fpga_resident_job_ms15": stat(resident_ms),
    "resident_host_launch_to_observed_done_ms15": stat(host_resident),
    "ddr_wait_ms18": stat(ddr_ms),
    "core_wait_ms18": stat(core_ms),
    "staging_ms18": stat(stage_ms),
    "counter_overlap": "Target ABI1.7: independent result BRAM reads, descriptor publication, prefetch and tile execution overlap; DDR/staging/core counters are not a disjoint latency partition",
    "compute_counter_ms_per_full_job": 0.03072,
    "cpu_scalar_integer_us": stat(cpu_int),
    "cpu_scalar_fp64_us": stat(cpu_fp),
    "cpu_scope": field(cpu, "implementation"),
    "quantization": quantization,
    "upload": load(root + "/upload.json"),
    "receipt": receipt,
    "workload_wall_ms": @string.parse_int64(
      @fs.read_file(root + "/workload-wall-ms.txt").text().trim(),
    ),
    "clock_hz": 50000000,
    "useful_ddr_read_bytes_per_full_job": 9216,
    "useful_ddr_write_bytes_per_full_job": 2080,
    "core_memory_transactions_per_full_job": {
      "reads": 4352,
      "word_reads": 4352,
      "byte_reads": 0,
      "writes": 512,
      "total": 4864,
    },
    "scope": "Exact integer comparison from original row-major INT8 codes with Int64 accumulation; all raw readbacks, operand writes, guards, job ranges and counters audited. Job timing ends at final MIG write acceptance; following readback proves visibility. Same eight output channels of one Qwen projection, not a full model.",
  }
  @fs.write_file(
    output,
    report.stringify(indent=2) + "\n",
    create_mode=CreateNew,
  )
  println(
    "PASS independent original-fixture/raw-JTAG audit; " +
    txns.length().to_string() +
    " transactions",
  )
}

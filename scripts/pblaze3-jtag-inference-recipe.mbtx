///|
import {
  "moonbitlang/core/env",
}

///|
fn main raise {
  let (mhz, period) = match @env.args()[1:] {
    [] | ["25"] => ("25.000", "40.000")
    ["40"] | ["40", "prefetch"] => ("40.000", "25.000")
    ["50", "prefetch"] => ("50.000", "20.000")
    ["60", "prefetch"] => ("60.000", "16.667")
    ["75", "prefetch"] => ("75.000", "13.333")
    ["80", "prefetch"] => ("80.000", "12.500")
    ["100", "prefetch"] => ("100.000", "10.000")
    _ => fail("expected 25 or 40 MHz, or 40/50/60/75/80/100 MHz with prefetch")
  }
  let prefetch = @env.args()[1:] is [_, "prefetch"]
  let clocks = if prefetch {
    (
      #|  foreach pin {pblaze3_i/jtag/aclk pblaze3_i/gpio/s_axi_aclk pblaze3_i/status/clock50 pblaze3_i/reset_core/slowest_sync_clk pblaze3_i/accelerator/clock pblaze3_i/weight_clock/s_axi_aclk} {same_physical_net $core $pin}
    )

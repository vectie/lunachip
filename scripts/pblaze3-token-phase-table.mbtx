///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
async fn main {
  guard @env.args()[1:] is [profile, tokens, output] && !@fs.exists(output) else {
    fail("UNTIMED_PROFILE_TSV TOKENS_TSV NEW_CSV")
  }
  let p = @fs.read_file(profile).text().trim().split("\n").to_array()
  let t = @fs.read_file(tokens).text().trim().split("\n").to_array()
  assert_eq(p.length(), 6)
  assert_eq(t.length(), 5)
  let labels = p[0].split("\t").map(x => x.to_owned()).to_array()
  let rows = StringBuilder()
  rows.write_string(
    "position,input_id,output_id,core,weight_wait,weight_handoff,matrix_issue,matrix_drain,matrix_advance,matrix_write,descriptor,scalar_ddr_request,scalar_ddr_response,unary,other,loader_request,loader_response,loader_launch,weight_packets_during_issue\n",
  )
  for i in 0..<4 {
    let a = p[i + 1].split("\t").to_array()
    let b = p[i + 2].split("\t").to_array()
    assert_eq(b[1], "token" + i.to_string())
    let v = t[i + 1].split("\t").to_array()
    assert_eq(@string.parse_int(v[0]), i)
    let counts : Map[String, Int64] = Map([])
    for j in 2..<labels.length() {
      counts[labels[j]] = (
          @string.parse_int64(b[j]) - @string.parse_int64(a[j]) + 4294967296L
        ) %
        4294967296L
    }
    assert_eq(counts["core"], @string.parse_int64(v[3]))
    assert_eq(counts["launch"], @string.parse_int64(v[5]))
    assert_eq(
      counts["loader_request"] +
      counts["loader_response"] +
      counts["loader_launch"],
      @string.parse_int64(v[4]),
    )
    assert_eq(
      counts["bank"] +
      counts["issue"] +
      counts["drain"] +
      counts["advance"] +
      counts["row_write"] +
      counts["descriptor"] +
      counts["data_request"] +
      counts["data_response"] +
      counts["unary"] +
      counts["other"],
      counts["core"],
    )
    let cells = [
      v[0].to_owned(),
      v[1].to_owned(),
      v[2].to_owned(),
      counts["core"].to_string(),
      (counts["bank"] - counts["handoff"]).to_string(),
    ]
    for
      name in [
        "handoff", "issue", "drain", "advance", "row_write", "descriptor", "data_request",
        "data_response", "unary", "other", "loader_request", "loader_response", "loader_launch",
        "packet_during_issue",
      ] {
      cells.push(counts[name].to_string())
    }
    rows.write_string(cells.join(",") + "\n")
  }
  @fs.write_file(output, rows.to_string(), create_mode=CreateNew)
}

  #|source $src

///|
fn sha(b : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(b))
}

///|
async fn main {
  guard @env.args()[1:] is [output] && !@fs.exists(output) else {
    fail("NEW_OUTPUT")
  }
  @fs.mkdir(output, recursive=true)
  let root = @fs.realpath(output)
  let runner = @fs.realpath("scripts/pblaze3-jtag-ddr-test.mbtx")
  let source = @fs.read_file(runner).binary()
  let cache = "/tmp/pblaze3-deploy-script-build-20261028"
  @fs.write_file(root + "/vivado-stub", stub + "\n", create_mode=CreateNew)
  @shell.Cmd("/bin/chmod", ["+x", root + "/vivado-stub"]).run()
  let cases = [
    "good", "alias-256", "alias-512", "alias-1024", "uncalibrated", "extra-health-bit",
    "health-lost", "wrong-cable", "duplicate-cable", "wrong-device", "wrong-part",
    "wrong-id", "crc", "no-axi", "two-axi", "wrong-width", "wrong-class", "wrong-address",
    "busy-before", "stale-read", "poison-ignored", "rresp", "bresp", "busy", "not-done", "run-error", "dropped-write",
    "short-data", "byte-reversed", "hang", "out-of-range", "unaligned", "gpio-write",
  ]
  for scenario in cases {
    let path = root + "/" + scenario
    let timeout = if scenario == "hang" { "1000" } else { "60000" }
    let result = @shell.Cmd(
      "moon",
      [
        "run",
        runner,
        "--target-dir",
        cache,
        "run",
        root + "/vivado-stub",
        "xc7k325t_0",
        timeout,
        path,
      ],
      env={ "PBLAZE3_DDR_STUB_SCENARIO": scenario },
      inherit_env=true,
    ).output(timeout_ms=90000)
    @fs.write_file(
      root + "/" + scenario + "-stdout.log",
      result.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/" + scenario + "-stderr.log",
      result.stderr(),
      create_mode=CreateNew,
    )
    assert_eq(
      result.exit_code() == 0,
      scenario == "good",
      msg="scenario " + scenario,
    )
    assert_eq(@fs.exists(path + "/complete.json"), scenario == "good")
    if scenario != "good" {
      assert_true(@fs.exists(path + "/FAILED.txt"))
    }
    if ["alias-256", "alias-512", "alias-1024"].contains(scenario) {
      let attempts = @fs.read_file(path + "/attempts.tsv").text()
      assert_true(attempts.contains("0-written\tR\t80000000"))
      assert_true(attempts.contains("0-read\tR\t"))
      assert_true(
        @fs.read_file(path + "/stderr.log").text().contains("readback mismatch"),
      )
    }
    if scenario == "uncalibrated" {
      assert_false(
        @fs.read_file(path + "/attempts.tsv").text().contains("\tW\t"),
      )
    }
    if scenario == "hang" {
      assert_true(
        @fs.read_file(path + "/stdout.log")
        .text()
        .contains("STUB_BEFORE_TIMEOUT"),
      )
      assert_true(
        @fs.read_file(path + "/attempts.tsv").text().contains("1\t0-before"),
      )
    }
    if ["out-of-range", "unaligned", "gpio-write"].contains(scenario) {
      assert_eq(
        @fs.read_file(path + "/transactions.tsv").text().split("\n").count(),
        2,
      )
      assert_true(
        @fs.read_file(path + "/stderr.log")
        .text()
        .contains("FAIL_AT=2\t0-write"),
      )
    }
    println("PASS " + scenario)
  }
  // Audit must independently reject incomplete history and altered readback.
  let good = root + "/good"
  let original = @fs.read_file(good + "/transactions.tsv").text()
  let original_lines = original.split("\n").map(s => s.to_owned()).to_array()
  let variants = [
    original.replace_all(old="OKAY", new="SLVERR"),
    original_lines[1:].join("\n"),
    original.replace_all(old="0000000f", new="0000000e"),
  ]
  for i, variant in variants {
    @fs.write_file(good + "/transactions.tsv", variant)
    let result = @shell.Cmd("moon", [
      "run", runner, "--target-dir", cache, "audit", good,
    ]).output(timeout_ms=30000)
    @fs.write_file(
      root + "/audit-negative-" + i.to_string() + ".log",
      result.stderr(),
      create_mode=CreateNew,
    )
    assert_true(result.exit_code() != 0)
  }
  @fs.write_file(good + "/transactions.tsv", original)
  let result = @shell.Cmd("moon", [
    "run", runner, "--target-dir", cache, "audit", good,
  ]).output(timeout_ms=30000)
  result.check()
  assert_eq(@fs.read_file(runner).binary(), source)
  let receipt : Json = {
    "status": "PASS",
    "cases": cases.length() + variants.length(),
    "scope": "Tcl software model and evidence verifier only; no hardware or Vivado",
    "runner_sha256": sha(source),
    "test_sha256": sha(
      @fs.read_file("scripts/pblaze3-jtag-ddr-test-test.mbtx").binary(),
    ),
    "stub_sha256": sha(@fs.read_file(root + "/vivado-stub").binary()),
  }
  @fs.write_file(
    root + "/receipt.json",
    receipt.stringify(indent=2),
    create_mode=CreateNew,
  )
}

///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.1/crypto",
}

///|
let predecessor = "/Users/kq/Workspace/lunachip/artifacts/phase6-fetched-packed-certificate-20261015"

///|
let seal = "1dfb489073e67166791a8f37a8e5dc52da93b697ed7307ace64420688845a55c"

///|
fn hash(text : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(text)))
}

///|
fn search(query : String) -> String raise {
  guard query.split("(check-sat)\n").to_array() is [prefix, suffix] &&
    suffix.has_prefix("(get-value ((concat ") &&
    suffix.has_suffix("))\n(exit)\n\n") else {
    fail("one complete packed observation after the sole check required")
  }
  prefix.to_owned() + "(check-sat)\n"
}

///|
async fn main {
  guard @env.args() is [_, root] else { fail("usage: FRESH_ISOLATED_ROOT") }
  let cwd = @fs.realpath(@env.current_dir().unwrap())
  guard cwd != "/Users/kq/Workspace/lunachip" &&
    root.has_prefix(cwd + "/artifacts/") &&
    !root.contains("/../") &&
    !@fs.exists(root) else {
    fail("fresh root in isolated checkout required")
  }
  let status = @shell.Cmd("git", [
    "status", "--porcelain", "--untracked-files=all",
  ]).output()
  status.check()
  assert_eq(status.stdout(), "")
  let inventory = @fs.read_file(predecessor + "/files.sha256").text()
  assert_eq(hash(inventory), seal)
  let seen : Map[String, Unit] = Map([])
  for line in inventory.split("\n") {
    if line.is_empty() {
      continue
    }
    guard line.split("  ").to_array() is [digest, path] &&
      digest.length() == 64 &&
      !path.is_empty() &&
      !path.has_prefix("/") &&
      !path.split("/").contains("..") &&
      !seen.contains(path.to_owned()) else {
      fail("invalid predecessor inventory")
    }
    seen[path.to_owned()] = ()
    assert_eq(
      @crypto.bytes_to_hex_string(
        @crypto.sha256(
          @fs.read_file(predecessor + "/" + path.to_owned()).binary(),
        ),
      ),
      digest.to_owned(),
    )
  }
  assert_eq(seen.length(), 221)
  let query = @fs.read_file(predecessor + "/query.smt2").text()
  assert_eq(
    hash(query),
    "e3186d29f213bff9e1c5043697bf0096b8d86e409529d7cb21bfc9776d10885e",
  )
  assert_eq(
    hash(search(query)),
    "4ed9be0a1de4c9d977413f4560bb54f3725e94be0f948d00785b76b84d14c54d",
  )
  let inputs = @fs.read_file(predecessor + "/inputs.sha256").text()
  assert_eq(
    hash(inputs),
    "22a66a156ec7d39dbe587a1487426950d13b77be49e3cf7c414439657f9da014",
  )
  let review = @fs.read_file(predecessor + "/review-field-split.txt").text()
  assert_eq(
    hash(review),
    "6e59cbf9179189c76e07ab8180a90632a539bc14e9b1744d990d4204d456d6fc",
  )
  @fs.mkdir(root)
  for
    name in [
      "query.smt2", "model.smt2", "layout.tsv", "scenario.smtc", "terms.txt", "certificate-layout.tsv",
      "baseline-reference.txt", "inputs.sha256", "review-field-split.txt",
    ] {
    @fs.write_file(
      root + "/" + name,
      @fs.read_file(predecessor + "/" + name).binary(),
      create_mode=CreateNew,
    )
  }
  let head = @shell.Cmd("git", ["rev-parse", "HEAD"]).output()
  head.check()
  @fs.write_file(
    root + "/preparation-head.txt",
    head.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/preparation.txt",
    "EXACT-SEALED-PACKED-INPUTS\nPREDECESSOR " +
    predecessor +
    "\nINVENTORY-SHA256 " +
    seal +
    "\n221 predecessor entries verified. All seven prepared inputs, inventory and independent mechanical review copied byte-for-byte. No query, model, guidance or initialization changes. Continuous session certificate=false denotes no accepted witness at observation time, not absence of a post-check request. Strict decoding and original-model/causal validation remain required.\n",
    create_mode=CreateNew,
  )
  println("PREPARED-EXACT-PACKED-INPUTS " + root)
}

///|
test "packed retrieval preserves the entire sole search prefix" {
  let prefix = "(assert true)\n(check-sat)\n"
  assert_eq(
    search(prefix + "(get-value ((concat s0 #b1)))\n(exit)\n\n"),
    prefix,
  )
  for
    bad in [
      prefix + "(exit)\n\n",
      prefix + "(check-sat)\n(get-value ((concat s0 #b1)))\n(exit)\n\n",
      prefix + "(get-value ((concat s0 #b1)))\n(exit)\n",
    ] {
    try search(bad) catch {
      _ => ()
    } noraise {
      _ => fail("changed or incomplete observation accepted")
    }
  }
}

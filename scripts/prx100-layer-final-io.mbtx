///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn hash(b : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(b))
}

///|
async fn main {
  guard @env.args()[1:] is ["emit", original, fixture_json, checker, root] &&
    !@fs.exists(root + "/io.tcl") &&
    !@fs.exists(root + "/final-runtime.tcl") &&
    !@fs.exists(root + "/final-check.mbtx") else {
    fail("emit QUALIFIED_2MS_IO FIXTURE_JSON CHECKER_SOURCE EXISTING_NEW_ROOT")
  }
  let io = @fs.read_file(original).binary()
  assert_eq(
    hash(io),
    "3eb5c50c7ccc42741f0d0827a787431ae8fd372ab01f284235aa6f40414a0dae",
  )
  let fixture = @fs.read_file(fixture_json).binary()
  guard @json.parse(@fs.read_file(fixture_json).text())
    is {
      "status": "PASS",
      "model": "Qwen/Qwen3-0.6B",
      "revision": "c1899de289a04d12100db370d81485cdf75e47ca",
      "hidden": 1024,
      ..
    } else {
    fail("pinned Qwen fixture")
  }
  let runtime =
    #|array set final_plans {};array set final_tokens {};array set final_pending_files {}
    #|set final_request 0;set final_checker {};set final_pending 0;set final_reply {};set final_error {}

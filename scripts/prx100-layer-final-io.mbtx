    #| puts $comparisons [join [lrange $fields 2 6] \t];flush $comparisons
    #| puts $checker_trace "$final_request\t$name\t$actual_file\t$final_pending_files($actual_file)\t$words\t$exact\t$maximum\t$relative\t$digest\t[expr {[clock microseconds]-$begin}]";flush $checker_trace

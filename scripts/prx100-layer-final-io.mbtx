    #| foreach part $recorded raw $values {lassign $part seq slot path addr offset n;set actual [bytes_from_data $raw $n];if {[string length $actual]!=4*$n} {error {Prepared binary length}};puts -nonewline $channels($path) $actual;incr binary_read_words $n}
    #| set finish [clock microseconds]
    #| puts $groups "$first\tR\t[lindex [lindex $recorded 0] 3]\t[llength $txns]\t$words\t[expr {$run_begin-$begin}]\t[expr {$run_end-$run_begin}]\t[expr {$finish-$run_end}]\t[expr {$finish-$begin}]\t$response";flush $groups
    #| puts $pool_trace "$first\t0\t[llength $txns]\t1\t$words\t[expr {$status_end-$run_end}]\t[expr {$data_end-$status_end}]\t[expr {$finish-$data_end}]";flush $pool_trace
    #| foreach part $recorded {lassign $part seq slot path addr offset n;puts $scatter_trace "$seq\t$first\t$slot\t$call\t$kind\t$path\t$addr\t$offset\t$n"};flush $scatter_trace
    #| set begin [clock microseconds]
    #| }
    #| foreach path $files {close $channels($path)}
    #|}
    #|rename verify_floats basic_verify_floats
    #|proc verify_floats {name actual_file expected_file words} {
    #| global final_pending_files final_checker final_request fixture comparisons checker_trace
    #| if {![info exists final_pending_files($actual_file)]} {
    #|  if {[string match resident-* $name]} {error {Unregistered resident payload}}
    #|  return [basic_verify_floats $name $actual_file $expected_file $words]
    #| }
    #| if {$words!=1024 || $actual_file ne "$name.bin" || $expected_file ne "$fixture/$final_pending_files($actual_file)"} {error {Final check identity}}
    #| set begin [clock microseconds];incr final_request
    #| puts $final_checker "CHECK\t$final_request\t$name\t$actual_file\t$final_pending_files($actual_file)\t$words";flush $final_checker
    #| set line [final_read_line];set fields [split $line \t]

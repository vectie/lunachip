    #| vwait ::final_pending
    #| after cancel $timeout;fileevent $final_checker readable {}
    #| if {$final_error ne {}} {error $final_error};return $final_reply
    #|}
    #|proc start_final_checker {} {
    #| global fixture final_reference_pin final_checker final_request checker_trace
    #| if {$final_checker ne {}} {error {Duplicate checker startup}}
    #| set final_checker [open [list | env MOON_HOME=/tools/moon-baseline PATH=/tools/moon-baseline/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin moon run final-check.mbtx -- $fixture $final_reference_pin 2>checker.stderr] r+]
    #| fconfigure $final_checker -blocking 0 -buffering line -translation lf
    #| if {[final_read_line] ne "READY\t4\t$final_reference_pin"} {error {Checker reference handshake}}
    #| set final_request 0
    #| set checker_trace [open checker.tsv w];puts $checker_trace [join {id name actual reference words exact maximum relative actual_sha256 us} \t];flush $checker_trace
    #|}
    #|proc stop_final_checker {} {
    #| global final_checker final_request final_pending_files checker_trace
    #| if {[array size final_pending_files]} {error {Unchecked final payloads}}
    #| puts $final_checker QUIT;flush $final_checker
    #| if {[final_read_line] ne "BYE\t$final_request"} {error {Checker shutdown handshake}}
    #| fconfigure $final_checker -blocking 1;close $final_checker;set final_checker {};close $checker_trace
    #|}
    #|proc prepare_final_runtime {} {
    #| global traces axi bulk_pool bulk_lengths pool_created final_plans final_tokens final_plan_trace timings
    #| set begin [clock microseconds];start_final_checker
    #| set final_plan_trace [open final-plans.tsv w];puts $final_plan_trace [join {plan group slot job token address offset_words words object} \t]
    #| foreach {plan start end} {full 0 4 prefill 0 3 decode 3 4} {
    #|  set locations {};set txns {};set parts {};set slot 0;set job 0
    #|  for {set token $start} {$token<$end} {incr token} {
    #|   set rows {};foreach row $traces {if {[lindex $row 0] eq "t$token-output"} {lappend rows $row}}
    #|   if {[llength $rows]!=1} {error {Unique final tensor}}
    #|   lassign [lindex $rows 0] name file address words;set address [expr {0x10000000+$address}]
    #|   if {$words!=1024 || ($address&3) || $address<0x10000000 || $address+4096>0x20000000} {error {Final tensor shape/aperture}}
    #|   lappend locations [list $address $words];set final_tokens($address) $token
    #|   for {set offset 0} {$offset<1024} {incr offset $n} {
    #|    set a [expr {$address+4*$offset}];set addr [format %08x $a];set key F,$plan,$slot
    #|    set n [expr {min(256,1024-$offset,(4096-($a&4095))/4)}]
    #|    if {[info exists bulk_pool($key)] || $slot>=20 || $n<1} {error {Prepared plan capacity/identity}}
    #|    set txn [create_hw_axi_txn final_${plan}_$slot $axi -type read -id 0 -address $addr -len $n -burst INCR]
    #|    set bulk_pool($key) $txn;set bulk_lengths($key) $n;incr pool_created
    #|    lappend txns $txn;lappend parts [list [expr {$slot%16}] $job $addr $offset $n]
    #|    puts $final_plan_trace "$plan\t[expr {$slot/16}]\t[expr {$slot%16}]\t$job\t$token\t$addr\t$offset\t$n\t$txn";incr slot
    #|   }
    #|   incr job
    #|  }
    #|  if {[info exists final_plans($locations)]} {error {Duplicate plan shape}}
    #|  set final_plans($locations) [list $txns $parts]
    #| }
    #| flush $final_plan_trace;puts $timings "setup\tfinal_runtime_preparation\t[expr {[clock microseconds]-$begin}]";flush $timings
    #|}
    #|rename read_jobs basic_read_jobs
    #|proc read_jobs {kind jobs} {
    #| if {$kind ne {results} || ![string match resident-* [lindex [lindex $jobs 0] 2]]} {return [basic_read_jobs $kind $jobs]}
    #| global axi sequence groups pool_reused binary_read_words pool_trace scatter_trace scatter_plans read_job_call completed_read_phase final_plans final_tokens final_pending_files
    #| if {!$completed_read_phase || [llength $jobs]<1 || [llength $jobs]>4 || [array size final_pending_files]} {error {Prepared final phase/count}}

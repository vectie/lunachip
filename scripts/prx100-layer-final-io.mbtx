    #| foreach job $jobs {
    #|  if {[llength $job]!=3} {error {Prepared job shape}};lassign $job address words path
    #|  if {![string is integer -strict $address] || $words!=1024 || ![info exists final_tokens($address)] || ![regexp {^resident-(full[0-9]+|prefill|decode[0-9]+)-t([0-3])-output\.bin$} $path matched sample token] || $token!=$final_tokens($address) || [lsearch -exact $files $path]>=0} {error {Prepared job identity}}
    #|  lappend locations [list $address $words];lappend files $path
    #| }

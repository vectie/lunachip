    #|}
    #|rename finish_io basic_finish_io
    #|proc finish_io {} {global final_plan_trace;stop_final_checker;close $final_plan_trace;basic_finish_io}
  @fs.write_file(
    root + "/final-runtime.tcl",
    "set final_reference_pin {" + hash(fixture) + "}\n" + runtime + "\n",
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/final-check.mbtx",
    @fs.read_file(checker).binary(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/io.tcl",
    @fs.read_file(original).text() +
    "\nsource final-runtime.tcl\nprepare_final_runtime\n",
    create_mode=CreateNew,
  )

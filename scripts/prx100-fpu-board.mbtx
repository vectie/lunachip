    #|  } else {set actual [read_range 0x10300000 [expr {$jobs*8}]]}
    #|  set flat [concat {*}$expected]
    #|  if {$actual ne $flat} {error "CPU reference mismatch $name"}
    #|  set results_end [clock microseconds]
    #|  if {!$fused_results} {set counters [burst R 48 [lrepeat 34 00000000]];set counter_sequence $sequence}
    #|  set verified [expr {[clock microseconds]-$begin}]
    #|  set numeric {}
    #|  foreach word $counters {scan $word %x n;lappend numeric $n}
    #|  lassign $numeric index completed total ddr pack wait core reads writes staged loaded state vector hz ui cache
    #|  lassign [lrange $numeric 16 19] ddr_compute pack_compute ddr_pack triple
    #|  lassign [lrange $numeric 28 33] gap feeder prepared started retired pending
    #|  if {$prepared!=$jobs || $started!=$jobs || $retired!=$jobs || $pending!=0 || $feeder!=0 || $index!=$jobs-1 || $vector!=($jobs-1)%$vectors} {error "Pipeline drain mismatch $name $numeric"}
    #|  if {$length==1024 && $jobs>1 && ($ddr_compute<=$wait-$core || $pack_compute<=$wait-$core)} {error "Missing guaranteed arithmetic overlap $name"}
    #|  if {!$compact_control} {set error_value [rd 12]}
    #|  if {$completed!=$jobs || $total!=$ddr+$pack+$wait-$ddr_compute-$pack_compute-$ddr_pack+$triple+$gap || $pack!=$jobs*1025 || $core!=$jobs*(4*$length+4) || $reads!=$jobs*16+$cold*128 || $writes!=$jobs*2 || $staged!=$jobs*512+$cold*4096 || $loaded!=$jobs*8192 || $state!=10 || $cache!=1 || $hz!=50000000 || $ui!=100000000 || $error_value!=0} {error "Counter mismatch $name $numeric"}
    #|  set checked [clock microseconds]
    #|  set cache_certificate $counter_sequence
    #|  puts $polling "$name\t$previous_poll_us\t$start_us\t$delay_ms\t$delay_us\t[expr {$i+1}]\t$poll_rtt_us"
    #|  puts $phases "$name\t$jobs\t[expr {$begin-$job_begin}]\t$elapsed\t[expr {$results_end-$begin-$elapsed}]\t[expr {$verified+$begin-$results_end}]\t[expr {$checked-$begin-$verified}]\t[expr {$checked-$job_begin}]\t[expr {$i+1}]"
    #|  flush $phases
    #|  puts $results "$name	$length	$jobs	$vectors	$cold	[join $flat ,]	[join $actual ,]	$total	$ddr	$pack	$wait	$core	$reads	$writes	$staged	$loaded	$elapsed	$verified"
    #|  flush $results
    #|  puts "FPDDR_BATCH_PASS $name jobs=$jobs total_cycles=$total core_cycles=$core"
    #|}
    #|set bulk_rejections 0
    #|foreach {ready jobs} {0 3 1 0 1 49} {
    #|  set result_ready $ready;set before $sequence
    #|  if {![catch {completed_reads $jobs} reason] || $reason ne "Completed-read phase/shape" || $sequence!=$before} {error "Completed-read rejection failed"}
    #|}
    #|set result_ready 0;set rejected [open completed-negative.txt w];puts $rejected "PASS three invalid completed-read phase/shapes rejected before any transaction";close $rejected
    #|foreach {op address count} {R 0 1 R 0x0ffffffc 2 R 0x20000000 1 R 0x1ffffffc 2 W 0x10100001 1 R 0x10100000 0 X 0x10100000 1} {
    #|  set before $sequence
    #|  if {![catch {bulk $op $address [lrepeat $count 00000000]} reason] || $reason ne "DDR-only bulk range" || $sequence!=$before} {error "Bulk range rejection failed"}
    #|  incr bulk_rejections
    #|}
    #|set rejected [open bulk-negative.txt w]
    #|puts $rejected "PASS $bulk_rejections invalid bulk ranges rejected before creating any transaction"
    #|close $rejected
    #|if {[rd 0]!=0x46504433 || [rd 4]!=0x10003} {error "Register identity mismatch"}
    #|set calibrated 0
    #|for {set i 0} {$i<100} {incr i} {if {[rd 8]&1} {set calibrated 1;break};after 10}
    #|if {!$calibrated} {error "DDR calibration timeout"}
    #|verify 0 {46504433 00010003}
    #|burst R 1 {00000000} SLVERR
    #|burst W 0 {00000001} SLVERR
    #|burst W 32 {00000000} SLVERR
    #|burst W 36 {00000031} SLVERR
    #|burst W 40 {00000004} SLVERR
    #|burst W 20 {00100000 00200000 00300000}
    #|burst W 0x10000000 {12345678 89abcdef 76543210 fedcba98}
    #|verify 0x10000000 {12345678 89abcdef 76543210 fedcba98}
    #|set uploads [open uploads.tsv w]
    #|puts $uploads "name	bytes	upload_us	readback_us"
    #|
  ))
  let words : Array[Array[UInt]]=jobs.map(j=> {
    guard j is {"words":Array(a),"expected_bits":Number(g,..),..} else {abort("job required")}
    let row=a.map(x=>match x {Number(n,..)=>n.to_uint();_=>abort("word")})
    assert_eq(row.length(),1024)
    assert_eq(cpu(row,1024),g.to_uint())
    row
  })
  let weights=Array::makei(4096,p=> (words[p/512][(p%512)*2]>>16)|(words[p/512][(p%512)*2+1]&0xffff0000U))
  let activations=Array::makei(1536,p=> (words[(p/512)*8][(p%512)*2]&65535U)|(words[(p/512)*8][(p%512)*2+1]<<16))
  let guards=[0x100ffff0U,0x10104000U,0x101ffff0U,0x10201800U,0x102ffff0U,0x10300600U].map(address=>(address,Array::makei(4,i=>0x5aa50000U^address^i.reinterpret_as_uint())))
  for (address,array) in guards {
    upload(tcl,address,array)
    tcl.write_string("verify 0x"+hex(address)+" {"+array.map(hex).join(" ")+"}\n")
  }
  for vector in 0..<3 {for lane in 0..<8 {for k in 0..<1024 {
    assert_eq(words[vector*8+lane][k]>>16,words[lane][k]>>16)
    assert_eq(words[vector*8+lane][k]&65535U,words[vector*8][k]&65535U)
  }}}
  tcl.write_string("set poison_begin [clock microseconds]\n")
  for (address,array) in [(0x10100000U,weights),(0x10200000U,activations)] {upload(tcl,address,array.map(x=>x^0xffffffffU))}
  for (address,array) in [(0x10100000U,weights),(0x10200000U,activations)] {tcl.write_string("verify 0x"+hex(address)+" {"+array.map(x=>hex(x^0xffffffffU)).join(" ")+"}\n")}
  tcl.write_string("set p [open poison-us.txt w]\nputs $p [expr {[clock microseconds]-$poison_begin}]\nclose $p\nset application_begin [clock microseconds]\nset upload_begin [clock microseconds]\n")
  upload(tcl,0x10100000U,weights)
  upload(tcl,0x10200000U,activations)
  tcl.write_string("set upload_us [expr {[clock microseconds]-$upload_begin}]\nset verify_begin [clock microseconds]\n")
  for (address,array) in [(0x10100000U,weights),(0x10200000U,activations)] {tcl.write_string("verify 0x"+hex(address)+" {"+array.map(hex).join(" ")+"}\n")}
  tcl.write_string("puts $uploads \"qwen\t22528\t$upload_us\t[expr {[clock microseconds]-$verify_begin}]\"\n")
  for length in [1,2,3,16,1023,1024] {
    let expected=Array::makei(3,v=>Array::makei(8,l=>cpu(words[v*8+l],length)))
    batch(tcl,"qwen-k"+length.to_string(),length,3,3,length==1,expected)
  }
  let full=Array::makei(3,v=>Array::makei(8,l=>cpu(words[v*8+l],1024)))
  for repeat in 0..<6 {batch(tcl,"qwen-repeat-"+repeat.to_string(),1024,3,3,false,full)}
  for count in [1,18,48] {batch(tcl,"qwen-batch-"+count.to_string(),1024,count,if count==1 {1}else{3},false,full)}
  tcl.write_string("wr 16 2\n")
  batch(tcl,"qwen-cold-3",1024,3,3,true,full)
  for (address,array) in [(0x10100000U,weights),(0x10200000U,activations)] {tcl.write_string("verify 0x"+hex(address)+" {"+array.map(hex).join(" ")+"}\n")}
  for (address,array) in guards {tcl.write_string("verify 0x"+hex(address)+" {"+array.map(hex).join(" ")+"}\n")}
  tcl.write_string((
    #|set transport [open transport.tsv w]
    #|puts $transport "requested_hz\tactual_hz\treuse\ttransactions\tobjects"
    #|puts $transport "$requested_hz\t$actual_hz\t$reuse_transactions\t$sequence\t$created_count"
    #|close $transport
    #|close $phases
    #|close $evidence
    #|close $polling
    #|close $stages
    #|close $queues
    #|foreach key [array names txn_cache] {delete_hw_axi_txn $txn_cache($key)}
    #|close $uploads
    #|close $transactions
    #|close $results
    #|set campaign [open campaign-us.txt w]
    #|puts $campaign [expr {[clock microseconds]-$campaign_begin}]
    #|close $campaign
    #|set application [open application-us.txt w]
    #|puts $application [expr {[clock microseconds]-$application_begin}]
    #|close $application
    #|close_hw_target
    #|disconnect_hw_server
    #|close_hw_manager
    #|puts "PRX100_FPODR_BOARD_PASS"
    #|
  ))
  @fs.write_file(root+"/board.tcl",tcl.to_string(),create_mode=CreateNew)
  let server=@shell.Cmd("sudo",["-n","/tools/amd/2025.2/Vivado/bin/hw_server","-d","-I300","-p0","-sTCP:127.0.0.1:3121","-L"+root+"/hw-server.log"],stdout=ToFile(root+"/hw-server.stdout"),stderr=ToFile(root+"/hw-server.stderr")).status();assert_eq(server,0)
  let code=@shell.Cmd("timeout",["300s",tool,"-mode","batch","-notrace","-source","board.tcl"],cwd=root,stdout=ToFile(root+"/board.stdout"),stderr=ToFile(root+"/board.stderr")).status()
  @fs.write_file(root+"/exit.txt",code.to_string()+"\n",create_mode=CreateNew)
  let receipt : Json={"status":if code==0 {"PASS"}else{"FAIL"},"bitstream_sha256":bit_hash,"cable":"ME10E06D1010A","clock_hz":50000000,"jtag_hz":hz,"mode":mode,"read_write_queue_depth":16,"completed_read_dispatch":"sequential_list","launch_dispatch":if mode=="list" {"separate"}else{"sequential_list"},"scope":"unchanged FPDDR1.3Q and preceding paced/cache-evidence path; separate or single-command full DDR results plus34 counters after DONE. Same complete payload and CPU/error/counter checks. GROUP_OKAY is final command/group response only. List mode runs sequentially inside a command; it is not hardware-queued completion."}
  @fs.write_file(root+"/receipt.json",receipt.stringify(indent=2)+"\n",create_mode=CreateNew)
  assert_eq(code,0)
  assert_true(@fs.read_file(root+"/board.stdout").text().contains("PRX100_FPODR_BOARD_PASS"))
}

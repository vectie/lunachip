import {"moonbitlang/async@0.22.4","moonbitlang/async@0.22.4/fs","moonbitlang/async@0.22.4/shell","moonbitlang/core/env","moonbitlang/core/json","moonbitlang/x@0.5.1/crypto"}

fn hash(b : Bytes) -> String { @crypto.bytes_to_hex_string(@crypto.sha256(b)) }
fn hex(n : UInt) -> String { let s=n.to_string(radix=16); "00000000"[:8-s.length()].to_owned()+s }
fn cpu(words : Array[UInt], length : Int) -> UInt {
  let mut sum : Float=0.0
  for k in 0..<length {
    let product=Float::reinterpret_from_uint(words[k]&0xffff0000U)*Float::reinterpret_from_uint((words[k]&65535U)<<16)
    sum=sum+product
  }
  if sum.is_nan() {0x7fc00000U}else{sum.reinterpret_as_uint()}
}

fn upload(tcl : StringBuilder, address : UInt, words : Array[UInt]) -> Unit {
  tcl.write_string("upload 0x"+hex(address)+" {"+words.map(hex).join(" ")+"}\n")
}

fn batch(tcl : StringBuilder, name : String, length : Int, jobs : Int, vectors : Int, cold : Bool, rows : Array[Array[UInt]]) -> Unit {
  tcl.write_string("job "+name+" "+length.to_string()+" "+jobs.to_string()+" "+vectors.to_string()+" "+(if cold {"1"}else{"0"})+" {"+Array::makei(jobs,j=>"{"+rows[j%vectors].map(hex).join(" ")+"}").join(" ")+"}\n")
}

async fn main {
  guard @env.args()[1:] is ["run",build,jobs_path,qualification_path,root,hz,mode] && build=="/work/builds/prx100-fpq-vivado-20261018-hold-a2" && root.has_prefix("/work/builds/prx100-fpu-board-") && hz=="30000000" && ["list","launch","joined"].contains(mode) && !@fs.exists(root) else {fail("run QUALIFIED_BUILD JOBS QUALIFICATION NEW_ROOT 30000000 paced|fused|list")}
  assert_eq(@fs.read_file(build+"/exit.txt").text(),"0\n")
  assert_true(@fs.read_file(build+"/clock-qualification.txt").text().has_prefix("core_hz=50000000 ui_hz=100000000"))
  guard @json.parse(@fs.read_file(qualification_path).text()) is {"status":"PASS","sources":Object(sources),..} else {fail("source-bound digital qualification required")}
  for name,expected in sources {
    guard expected is String(digest) else {fail("source digest required")}
    assert_eq(hash(@fs.read_file(build+"/inputs/"+name).binary()),digest)
  }
  for name in ["core.sv","controller.sv","bridge.sv","prx100_fpo_top.sv","prx100_fpo_system.sv","prx100_fpo.xdc"] {assert_true(sources.contains(name))}
  let tool="/tools/amd/2025.2/Vivado/bin/vivado"
  guard @json.parse(@fs.read_file("/work/builds/vivado-2025.2-pin.json").text()) is {"executable_sha256":String(tool_hash),"version_stdout":String(version),..} else {fail("Vivado pin required")}
  assert_eq(hash(@fs.read_file(tool).binary()),tool_hash)
  let observed=@shell.Cmd(tool,["-version"]).output();observed.check();assert_eq(observed.stdout(),version)
  let bit_hash=hash(@fs.read_file(build+"/prx100_fpo.bit").binary())
  assert_eq(@fs.read_file(build+"/bitstream.sha256").text(),bit_hash+"  prx100_fpo.bit\n")
  assert_eq(hash(@fs.read_file(jobs_path).binary()),"eecb0a30731ce6645ef53a897c97aaa50a3e1d94399387c89b3dae1cb799ed8c")
  guard @json.parse(@fs.read_file(jobs_path).text()) is Array(jobs) && jobs.length()==24 else {fail("24 pinned jobs required")}
  if build.has_prefix("/work/builds/prx100-fpq-vivado-") {
    guard @json.parse(@fs.read_file(qualification_path).text()) is {"bitstream_sha256":String(expected),"read_queue_depth":Number(16,..),"write_queue_depth":Number(16,..),..} else {fail("queue-depth and bit-bound physical qualification required")}
    assert_eq(bit_hash,expected)
  } else {assert_eq(mode,"reuse");assert_eq(bit_hash,"d8354654fceb7d08d997f85a6da1261448c9697796885d4b04d261c7818506b4")}
  @fs.mkdir(root)
  for (from,to) in [("/work/prx100-fpu-board.mbtx","driver.mbtx"),(jobs_path,"jobs.json"),(qualification_path,"qualification.json")] {@fs.write_file(root+"/"+to,@fs.read_file(from).binary(),create_mode=CreateNew)}
  let tcl=StringBuilder()
  tcl.write_string("set bitstream {"+build+"/prx100_fpo.bit}\n")
  tcl.write_string("set requested_hz "+hz+"\nset reuse_transactions 1\nset queued_uploads 1\nset compact_control 1\nset certified_cache 1\nset paced_poll 1\nset fused_results "+(if mode!="paced" {"1"}else{"0"})+"\nset result_queue 0\nset launch_mode "+mode+"\nset configured_descriptor {}\nset cache_certificate 0\nset poll_rtt_us 0\nset result_ready 0\n")

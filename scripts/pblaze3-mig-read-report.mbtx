///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
async fn main {
  guard @env.args()[1:] is [measurements, mhz, out] else {
    fail("MEASUREMENTS_TSV ROUTED_ARRAY_MHZ NEW_JSON")
  }
  let clock = @string.parse_int(mhz)
  guard clock > 0 && clock <= 700 else {
    fail("array clock outside timing sweep")
  }
  let rows = @fs.read_file(measurements).text().trim().split("\n").to_array()
  assert_eq(rows.length(), 13)
  assert_eq(
    rows[0],
    "trial\tmode\tcycles\tbeats\tbytes\tar_count\trlast_count\tflags\tchecksum",
  )
  let clocks = Array::makei(4, _ => [])
  let signatures : Map[Int32, Int64] = Map([])
  for line in rows[1:] {
    let n = []
    for value in line.split("\t") {
      n.push(@string.parse_int64(value))
    }
    assert_eq(n.length(), 9)
    let m = n[1].to_int()
    assert_true(m >= 0 && m < 4)
    assert_eq(n[0].to_int(), clocks[m].length())
    assert_eq(n[3], 1048576L)
    assert_eq(n[4], 67108864L)
    assert_eq(n[5], if m == 1 { 16384L } else { 131072L })
    assert_eq(n[6], n[5])
    assert_eq(n[7], 16L * n[1] + 10L)
    assert_true(n[2] >= n[3] && n[2] <= 200000000L)
    if signatures.get(m) is Some(prev) {
      assert_eq(prev, n[8])
    }
    signatures[m] = n[8]
    clocks[m].push(n[2].to_int())
  }
  let names = [
    "sequential_512B", "sequential_4096B", "2KiB_fragments_4096B_pitch", "2KiB_fragments_6144B_pitch",
  ]
  let patterns : Array[Json] = []
  for m, samples in clocks {
    assert_eq(samples.length(), 3)
    let gbps = 3.0 *
      67108864.0 *
      0.2 /
      samples.fold(init=0, (a, x) => a + x).to_double()
    patterns.push({
      "pattern": names[m],
      "ui_cycles": Json(samples),
      "pooled_decimal_GBps": gbps,
      "fraction_of_12_8_GBps": gbps / 12.8,
      "bf16_lanes_at_700MHz": gbps / 1.4,
      "bf16_lanes_at_routed_clock": gbps * 500.0 / clock.to_double(),
    })
  }
  let result : Json = {
    "ui_hz": 200000000,
    "bytes_per_accepted_beat": 64,
    "bytes_per_scan": 67108864,
    "routed_array_mhz": clock,
    "bf16_bytes_per_lane_per_edge": 2,
    "patterns": patterns,
  }
  @fs.write_file(out, result.stringify(indent=2) + "\n", create_mode=CreateNew)
}

///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn copy_values(values : Map[String, String]) -> Map[String, String] {
  let result : Map[String, String] = Map([])
  for key, value in values {
    result[key] = value
  }
  result
}

///|
// Read complete SMT sample blocks, not the synthetic half-clock event blocks.
// Only the exact top's public/observer names are retained; nested DUT aliases
// cannot overwrite a top-level signal with the same leaf name.
fn top_frames(source : String) -> Array[Map[String, String]] raise {
  assert_true(source.contains("$enddefinitions $end"))
  let scope : Array[String] = []
  let ids : Map[String, String] = Map([])
  let values : Map[String, String] = Map([])
  let frames : Array[Map[String, String]] = []
  let mut fresh = false
  for raw in source.split("\n") {
    let line = raw.trim()
    let parts = line.split(" ").filter(part => !part.is_empty()).to_array()
    match parts {
      ["$scope", _, name, "$end"] => scope.push(name.to_owned())
      ["$upscope", "$end"] => ignore(scope.pop())
      ["$var", _, _, code, name, ..] =>
        if scope is ["lc_formal_direct_completion_top"] &&
          name.has_prefix("lc_") {
          ids[code.to_owned()] = name.to_owned()
        }
      [bits, code] if bits.has_prefix("b") => {
        if code == "t" {
          fresh = true
        }
        if ids.get(code.to_owned()) is Some(name) {
          values[name] = bits[1:].to_owned()
        }
      }
      _ =>
        if line.has_prefix("#") {
          if fresh {
            frames.push(copy_values(values))
          }
          fresh = false
        } else if line.has_prefix("0") || line.has_prefix("1") {
          if ids.get(line[1:].to_owned()) is Some(name) {
            values[name] = line[:1].to_owned()
          }
        }
    }
  }
  if fresh {
    frames.push(copy_values(values))
  }
  assert_true(scope.is_empty() && !frames.is_empty())
  frames
}

///|
fn value(frame : Map[String, String], name : String) -> String raise {
  guard frame.get(name) is Some(bits) else {
    fail("missing exact top signal: " + name)
  }
  bits
}

///|
fn number(frame : Map[String, String], name : String) -> UInt64 raise {
  let bits = value(frame, name)
  assert_true(bits.length() <= 64 && !bits.is_empty())
  let mut result = 0UL
  for digit in bits {
    assert_true(digit == '0' || digit == '1')
    result = (result << 1) | (if digit == '1' { 1UL } else { 0UL })
  }
  result
}

///|
fn bits64(value : UInt64) -> String {
  let out = StringBuilder()
  for index in 0..<64 {
    out.write_string(
      if ((value >> (63 - index)) & 1UL) == 1UL {
        "1"
      } else {
        "0"
      },
    )
  }
  out.to_string()
}

///|
fn canonical_load() -> String {
  bits64(0UL) +
  bits64(256UL | (16UL << 32)) +
  bits64(8UL | (16UL << 16)) +
  bits64((73UL << 32) | 0x200UL)
}

///|
fn qualify(frames : Array[Map[String, String]]) -> (Int, Int) raise {
  assert_true(frames.any(frame => number(frame, "lc_reset") == 1UL))
  let packet = canonical_load()
  let mut admitted : Int? = None
  for index, frame in frames {
    if number(frame, "lc_dc_watch") == 1UL &&
      number(frame, "lc_dc_admit") == 1UL &&
      number(frame, "lc_descriptor_valid") == 1UL &&
      number(frame, "lc_descriptor_ready") == 1UL &&
      value(frame, "lc_dc_packet") == packet {
      assert_eq(number(frame, "lc_reset"), 0UL)
      assert_true(number(frame, "lc_dc_post_reset_edges") < 32UL)
      admitted = Some(index)
    }
    if number(frame, "lc_dc_watched_retirement_deadline") == 0UL {
      guard admitted is Some(at) && at < index else {
        fail("deadline failure without earlier actual canonical admission")
      }
      assert_eq(number(frame, "lc_reset"), 0UL)
      assert_eq(number(frame, "lc_dc_active"), 1UL)
      assert_eq(number(frame, "lc_dc_age"), 1UL)
      assert_eq(number(frame, "lc_dc_checked_deadline"), 1UL)
      assert_eq(number(frame, "lc_dc_ordinal_retire"), 0UL)
      assert_eq(value(frame, "lc_dc_saved_packet"), packet)
      return (at, index)
    }
  }
  fail("no qualified age-one shortened-deadline failure")
}

///|
async fn review(root : String) -> Unit {
  let task = "phase6-flux-tile-direct8-q3-negative-deadline1-bmc"
  let output = root + "/negative-output"
  let work = output + "/" + task + "-work"
  assert_false(@fs.exists(root + "/files.sha256"))
  assert_eq(@fs.read_file(root + "/runner-negative.exit").text(), "0\n")
  assert_true(@fs.read_file(work + "/status").text().has_prefix("FAIL "))
  assert_true(
    @fs.read_file(output + "/result.lcfr")
    .text()
    .contains("RESULT counterexample\n"),
  )
  for name in ["head", "status"] {
    assert_eq(
      @fs.read_file(root + "/" + name + "-before.stdout").text(),
      @fs.read_file(root + "/" + name + "-after.stdout").text(),
    )
  }
  for name in ["formal-dut.sv", "formal-harness.sv"] {
    assert_eq(
      @fs.read_file(root + "/negative/" + name).text(),
      @fs.read_file(work + "/src/" + name).text(),
    )
  }
  let smt = @fs.read_file(work + "/model/design_smt2.smt2").text()
  assert_eq(smt.split("; yosys-smt2-assume ").count() - 1, 7)
  assert_eq(smt.split("; yosys-smt2-cover ").count() - 1, 0)
  let model = @json.parse(@fs.read_file(work + "/model/design.json").text())
  let (memories, unknown_bits) = unknown_memories(model)
  let trace = @fs.read_file(work + "/engine_0/trace.vcd").text()
  let (admission, failed) = qualify(top_frames(trace))
  let log = @fs.read_file(work + "/logfile.txt").text()
  assert_true(log.contains("Status: failed") && log.contains("Assert failed"))
  let execution = @fs.read_file(root + "/negative/" + task + ".lcfg").text()
  guard execution
    .split("\n")
    .filter(line => line.has_prefix("EXPECTED-FAILURE "))
    .to_array()
    is [expected_line] else {
    fail("one declared negative stable label required")
  }
  let expected = expected_line[17:].to_owned()
  assert_true(!expected.is_empty() && expected != "none")
  for line in log.split("\n") {
    if line.contains("Assert failed") {
      assert_true(line.contains(expected))
    }
  }
  for name in ["trace.yw", "trace_tb.v", "trace.smtc"] {
    assert_true(!@fs.read_file(work + "/engine_0/" + name).text().is_empty())
  }
  let report = "DIRECT8-DEADLINE-NEGATIVE-REVIEW 1\nSOURCE-COPIES exact\nHEAD-STATUS clean-unchanged\nASSUMPTIONS 7 original-public-only-R2-H2-C2\nCOVERS 0 selected\nPREPARED-ASSERTIONS \{smt.split("; yosys-smt2-assert ").count()-1}\nPREPARED-UNKNOWN-ARRAYS \{memories} bits\{unknown_bits}\nORIGINAL-UNKNOWN-MEMORY native38-arrays8960-bits-and-all-read-states\nMEMORY-COI tool-optimization-not-initialization-or-source-cut\nACTUAL-CANONICAL-ADMISSION frame\{admission}\nAGE1-ACTIVE-NO-ORDINAL-ACK-FAILURE frame\{failed}\nNEGATIVE-CONTROL qualified\nPOSITIVE-COMPLETION false\nPHASE6-PASS false\nEND\n"
  @fs.write_file(root + "/negative-review.txt", report, create_mode=CreateNew)
  println(report)
}

///|
fn unknown_memories(model : Json) -> (Int, Int) raise {
  guard model is { "modules": Array(modules), .. } else {
    fail("prepared model modules required")
  }
  let mut memories = 0
  let mut unknown_bits = 0
  for prepared_module in modules {
    guard prepared_module is { "cell_sorts": Array(sorts), .. } else {
      fail("prepared cell sorts required")
    }
    for sort in sorts {
      if sort is { "type": "$mem_v2", "cells": Array(cells), .. } {
        for cell in cells {
          guard cell
            is {
              "parameters": {
                "INIT": String(init),
                "RD_INIT_VALUE": String(read_init),
                ..
              },
              ..
            } else {
            fail("memory initialization parameters required")
          }
          assert_true(!init.is_empty() && init.split("x").join("").is_empty())
          assert_true(
            !read_init.is_empty() && read_init.split("x").join("").is_empty(),
          )
          memories += 1
          unknown_bits += init.length()
        }
      }
    }
  }
  (memories, unknown_bits)
}

///|
fn useful_address(write : Bool, address : UInt64) -> Bool {
  if write {
    address >= 1024UL && address < 1280UL && address % 4UL == 0UL
  } else {
    (address >= 256UL && address < 384UL) ||
    (address >= 512UL && address < 640UL)
  }
}

///|
fn useful_bus_witness(frames : Array[Map[String, String]]) -> Unit raise {
  let reads : Map[UInt64, Bool] = Map([])
  let writes : Map[UInt64, Bool] = Map([])
  let read_acks : Map[UInt64, Bool] = Map([])
  let write_acks : Map[UInt64, Bool] = Map([])
  let mut owner : (Bool, UInt64, UInt64)? = None
  for frame in frames {
    if number(frame, "lc_clock") != 0UL || number(frame, "lc_reset") == 1UL {
      continue
    }
    if number(frame, "lc_memory_request_valid") == 1UL &&
      number(frame, "lc_memory_request_ready") == 1UL {
      assert_true(owner is None)
      let write = number(frame, "lc_memory_request_write") == 1UL
      let address = number(frame, "lc_memory_request_address")
      assert_true(useful_address(write, address))
      assert_eq(
        number(frame, "lc_memory_request_bytes"),
        if write {
          4UL
        } else {
          1UL
        },
      )
      assert_eq(
        number(frame, "lc_memory_request_mask"),
        if write {
          15UL
        } else {
          1UL
        },
      )
      if !write {
        assert_eq(number(frame, "lc_memory_request_data"), 0UL)
      }
      let addresses = if write { writes } else { reads }
      assert_false(addresses.contains(address))
      addresses[address] = true
      owner = Some((write, address, number(frame, "lc_memory_request_tag")))
    }
    if number(frame, "lc_memory_response_valid") == 1UL &&
      number(frame, "lc_memory_response_ready") == 1UL {
      guard owner is Some((write, address, tag)) else {
        fail("useful ACK without full-width request identity")
      }
      assert_eq(number(frame, "lc_memory_response_tag"), tag)
      assert_eq(number(frame, "lc_memory_response_fault"), 0UL)
      let acknowledgments = if write { write_acks } else { read_acks }
      assert_false(acknowledgments.contains(address))
      acknowledgments[address] = true
      owner = None
    }
  }
  assert_true(owner is None)
  assert_eq(
    (reads.length(), read_acks.length(), writes.length(), write_acks.length()),
    (256, 256, 64, 64),
  )
}

///|
fn retirement_witness(
  frames : Array[Map[String, String]],
  useful? : Bool = false,
) -> String raise {
  if useful {
    useful_bus_witness(frames)
  }
  let mut admitted = 0UL
  let mut retired = 0UL
  let mut edge = 0
  let mut watch : (Int, UInt64, String, Int)? = None
  for index, frame in frames {
    // A low-clock SMT state is the PRE of the next modeled rising edge.
    if number(frame, "lc_clock") != 0UL {
      continue
    }
    if number(frame, "lc_reset") == 1UL {
      admitted = 0UL
      retired = 0UL
      watch = None
    } else {
      if useful {
        assert_eq(number(frame, "lc_dc_public_producer_sequence"), 1UL)
      }
      for
        premise in [
          "initial_only_reset", "host_descriptor_stable", "host_owned_success_response",
          "host_response_stable", "host_request_ready_r2", "host_response_offer_h2",
          "host_completion_ready_c2",
        ] {
        assert_eq(number(frame, "lc_dc_" + premise), 1UL)
      }
      assert_eq(number(frame, "lc_dc_outstanding"), admitted - retired)
      if number(frame, "lc_dc_watch") == 1UL {
        assert_true(watch is None)
        assert_eq(number(frame, "lc_dc_admit"), 1UL)
        assert_eq(number(frame, "lc_descriptor_valid"), 1UL)
        assert_eq(number(frame, "lc_descriptor_ready"), 1UL)
        assert_true(number(frame, "lc_dc_post_reset_edges") < 32UL)
        let packet = value(frame, "lc_dc_packet")
        assert_eq(packet.length(), 256)
        watch = Some((index, admitted + 1UL, packet, edge))
      }
      if number(frame, "lc_dc_admit") == 1UL {
        admitted += 1UL
      }
      if number(frame, "lc_dc_retire") == 1UL {
        if useful {
          assert_true(retired < 4UL)
          assert_eq(number(frame, "lc_completion_id"), 73UL)
          assert_eq(number(frame, "lc_completion_fault"), 0UL)
          assert_eq(number(frame, "lc_completion_fault_address"), 0UL)
          assert_eq(
            number(frame, "lc_completion_bytes_completed"),
            if retired < 2UL {
              128UL
            } else if retired == 2UL {
              0UL
            } else {
              256UL
            },
          )
        }
        retired += 1UL
        assert_true(retired <= admitted)
        if watch is Some((at, ordinal, packet, admission_edge)) &&
          retired == ordinal {
          assert_true(at < index && edge > admission_edge)
          for
            name in [
              "lc_dc_active", "lc_dc_ordinal_retire", "lc_dc_ordinal_history", "lc_completion_valid",
              "lc_completion_ready",
            ] {
            assert_eq(number(frame, name), 1UL)
          }
          assert_eq(
            number(
              frame,
              if useful {
                "lc_dc_useful_store_cover"
              } else {
                "lc_dc_watched_retirement_cover"
              },
            ),
            1UL,
          )
          if useful {
            let store = bits64(0UL) +
              bits64(1024UL | (32UL << 32)) +
              bits64(8UL | (8UL << 16)) +
              bits64((73UL << 32) | (3UL << 16) | 0x200UL)
            assert_eq(packet, store)
            assert_eq((admitted, retired, ordinal), (4UL, 4UL, 4UL))
          }
          assert_eq(number(frame, "lc_dc_older"), 0UL)
          assert_eq(value(frame, "lc_dc_saved_packet"), packet)
          assert_eq(
            value(frame, "lc_completion_id"),
            packet[192:224].to_owned(),
          )
          let age = number(frame, "lc_dc_age")
          assert_eq(age, (edge - admission_edge).to_uint64())
          assert_true(age <= 11718UL)
          assert_eq(number(frame, "lc_dc_checked_deadline"), 11718UL)
          // Require the real next rising transition, not an unconsumed offer.
          guard frames.get(index + 1) is Some(after) else {
            fail("missing retirement edge commit")
          }
          assert_eq(number(after, "lc_clock"), 1UL)
          assert_eq(number(after, "lc_dc_active"), 0UL)
          return "WATCH-ADMISSION frame\{at} ordinal\{ordinal}\nORDINAL-RETIREMENT frame\{index} age\{age}\nCOMPLETION-FAULT \{number(frame, "lc_completion_fault")}\nWATCHED-TERMINAL observed-on-retirement-edge\nUSEFUL-STORE \{useful}\n"
        }
      }
    }
    edge += 1
  }
  fail("no actual watched ordinal retirement in the complete witness")
}

///|
fn prepared_assertions(kind : String) -> Int raise {
  match kind {
    "positive" => 82
    // The retained SBY cover preparation removes all assertions, not premises.
    "retirement" | "useful" => 0
    "progress" => 84
    "supported" => 92
    _ => fail("unsupported completion review kind")
  }
}

///|
async fn review_completion(root : String, kind : String) -> Unit {
  assert_true(
    kind == "positive" ||
    kind == "retirement" ||
    kind == "useful" ||
    kind == "progress" ||
    kind == "supported",
  )
  assert_false(@fs.exists(root + "/files.sha256"))
  let run = root + "/" + kind + "-run"
  let (bundle, task, mode, depth, premises) = match kind {
    "positive" =>
      (
        "eventual", "phase6-flux-tile-direct8-q3-eventual-r2-h2-c2-d11718-bmc", "bmc",
        23552, 7,
      )
    "retirement" =>
      (
        "eventual", "phase6-flux-tile-direct8-q3-eventual-r2-h2-c2-d11718-cover-watched-retirement",
        "cover", 23552, 7,
      )
    "useful" =>
      (
        "useful", "phase6-flux-tile-direct8-q3-useful-store-r2-h2-c2-d11718-cover-useful-store-write-ack-retirement",
        "cover", 23552, 8,
      )
    "progress" =>
      (
        "progress", "phase6-flux-tile-direct8-q3-transport-progress-r2-h2-prove",
        "prove", 12, 7,
      )
    "supported" =>
      (
        "supported", "phase6-flux-tile-direct8-q3-transport-progress-r2-h2-fifo-support-prove",
        "prove", 12, 7,
      )
    _ => fail("unsupported direct8 review")
  }
  let output = run + "/output"
  let work = output + "/" + task + "-work"
  let status = @fs.read_file(work + "/status").text()
  let passed = status.has_prefix("PASS ")
  assert_true(
    passed ||
    status.has_prefix("TIMEOUT ") ||
    (
      mode == "prove" &&
      (status.has_prefix("UNKNOWN ") || status.has_prefix("FAIL "))
    ),
  )
  let exit = @fs.read_file(run + "/runner.exit").text()
  if passed {
    assert_eq(exit, "0\n")
  } else {
    assert_true(exit != "0\n")
  }
  for name in ["head", "status", "volumes"] {
    assert_eq(
      @fs.read_file(run + "/" + name + "-before.stdout").text(),
      @fs.read_file(run + "/" + name + "-after.stdout").text(),
    )
  }
  assert_true(@fs.read_file(run + "/status-before.stdout").text().is_empty())
  for leaf in ["formal-dut.sv", "formal-harness.sv"] {
    assert_eq(
      @fs.read_file(root + "/" + bundle + "/" + leaf).text(),
      @fs.read_file(work + "/src/" + leaf).text(),
    )
  }
  let config = @fs.read_file(output + "/" + task + ".sby").text()
  assert_true(
    config.contains("depth \{depth}\n") &&
    config.contains("timeout 600\n") &&
    config.contains("expect pass\n"),
  )
  assert_true(config.contains("mode \{mode}\n"))
  let smt = @fs.read_file(work + "/model/design_smt2.smt2").text()
  assert_eq(smt.split("; yosys-smt2-assume ").count() - 1, premises)
  assert_eq(smt.split("; yosys-smt2-memory ").count() - 1, 38)
  assert_eq(
    smt.split("; yosys-smt2-cover ").count() - 1,
    if mode == "cover" {
      1
    } else {
      0
    },
  )
  assert_eq(
    smt.split("; yosys-smt2-assert ").count() - 1,
    prepared_assertions(kind),
  )
  if kind == "supported" {
    for lane in 0..<4 {
      for role in ["read", "write"] {
        assert_true(smt.contains(" lc_d8p_fifo_\{lane}_\{role}_range\n"))
      }
    }
  }
  if mode == "cover" {
    assert_true(
      @fs.read_file(work + "/model/design_prep.ys")
      .text()
      .contains("chformal -live -fair -assert -remove\n"),
    )
  }
  let execution = @fs.read_file(root + "/" + bundle + "/" + task + ".lcfg").text()
  for line in execution.split("\n") {
    let parts = line.split(" ").to_array()
    if parts is [role, _, label] && (role == "A" || role == "P") {
      assert_true(smt.contains(" " + label.to_owned() + "\n"))
    }
  }
  let memory = unknown_memories(
    @json.parse(@fs.read_file(work + "/model/design.json").text()),
  )
  assert_eq(memory, (38, 8960))
  let log = @fs.read_file(work + "/logfile.txt").text()
  let mut last_check = "none"
  for line in log.split("\n") {
    if line.contains("Checking assertions in step ") ||
      line.contains("Checking cover reachability in step ") {
      last_check = line.to_owned()
    }
  }
  let witness = if passed {
    let result = @fs.read_file(output + "/result.lcfr").text()
    assert_true(result.contains("ASSUMPTIONS \{premises}\n"))
    if mode != "prove" {
      assert_true(result.contains("BOUND 23552\n"))
    }
    assert_true(!@fs.read_file(output + "/receipt.lcfe").text().is_empty())
    if mode == "prove" {
      assert_true(
        result.contains("CLASS unbounded\n") &&
        result.contains("INDUCTION k-induction 12\n") &&
        result.contains("PROPERTIES 8\n") &&
        result.contains("RESULT proved\n"),
      )
      assert_true(log.contains("basecase") && log.contains("induction"))
      "TRANSPORT-PROGRESS unbounded-component-only\nPOSITIVE-DEADLINE not-established-by-this-component\n"
    } else if kind == "positive" {
      assert_true(
        result.contains("PROPERTIES 6\n") &&
        result.contains("RESULT bounded-pass\n"),
      )
      "POSITIVE-DEADLINE bounded-pass-through23552-global-steps\n"
    } else {
      assert_true(
        result.contains("RESULT cover-witness\n") &&
        result.contains("PROPERTIES 1\n"),
      )
      let zero = @fs.exists(work + "/engine_0/trace0.vcd")
      assert_true(zero != @fs.exists(work + "/engine_0/trace.vcd"))
      let base = if zero { "trace0" } else { "trace" }
      for ext in ["yw", "smtc", "vcd"] {
        assert_true(
          !@fs.read_file(work + "/engine_0/" + base + "." + ext)
          .text()
          .is_empty(),
        )
      }
      assert_true(
        !@fs.read_file(work + "/engine_0/" + base + "_tb.v").text().is_empty(),
      )
      retirement_witness(
        top_frames(@fs.read_file(work + "/engine_0/" + base + ".vcd").text()),
        useful=kind == "useful",
      )
    }
  } else {
    assert_true(log.contains("TIMEOUT") || (mode == "prove" && !passed))
    assert_false(@fs.exists(output + "/result.lcfr"))
    assert_false(@fs.exists(output + "/receipt.lcfe"))
    "POSITIVE-DEADLINE not-established\nREACHABILITY not-established-by-this-task\n"
  }
  let scope = if mode == "prove" {
    "UNBOUNDED-COMPONENT induction12 completion11718-not-selected"
  } else {
    "FULL-BOUND 23552 deadline11718"
  }
  let report = "DIRECT8-COMPLETION-REVIEW 1\nTASK \{task}\nSTATUS \{status.trim()}\nSOURCE-COPIES exact\nHEAD-STATUS clean-unchanged\nPUBLIC-ASSUMPTIONS \{premises}\nUNKNOWN-ARRAYS 38 bits8960 read-INIT-unknown\n\{scope}\nLAST-CHECK \{last_check}\n" +
    witness +
    "PHASE6-PASS false\nEND\n"
  let report_path = run + "/review.txt"
  if @fs.exists(report_path) {
    assert_eq(@fs.read_file(report_path).text(), report)
  } else {
    @fs.write_file(report_path, report, create_mode=CreateNew)
  }
  println(report)
}

///|
async fn main {
  match @env.args() {
    [_, root] => review(root)
    [_, "completion", root, kind] => review_completion(root, kind)
    [_, "retain-source", root, source] => {
      assert_false(@fs.exists(root + "/files.sha256"))
      @fs.write_file(
        root + "/host-review-source.mbtx",
        @fs.read_file(source).text(),
        create_mode=CreateNew,
      )
    }
    _ =>
      fail(
        "usage: ROOT | completion ROOT positive|retirement|useful|progress|supported | retain-source ROOT SCRIPT",
      )
  }
}

///|
test "VCD review keeps top-level identities and only complete SMT samples" {
  assert_eq(prepared_assertions("positive"), 82)
  assert_eq(prepared_assertions("retirement"), 0)
  assert_eq(prepared_assertions("useful"), 0)
  assert_eq(prepared_assertions("progress"), 84)
  assert_eq(prepared_assertions("supported"), 92)
  let vcd = "$scope module lc_formal_direct_completion_top $end\n$var wire 1 n0 lc_reset $end\n$scope module lc_dut $end\n$var wire 1 n1 lc_reset $end\n$upscope $end\n$upscope $end\n$enddefinitions $end\n#0\nb0 t\nb1 n0\nb0 n1\n#5\n1!\n#10\nb1 t\nb0 n0\n#15\n1!\n"
  let frames = top_frames(vcd)
  assert_eq(frames.length(), 2)
  assert_eq(number(frames[0], "lc_reset"), 1UL)
  assert_eq(number(frames[1], "lc_reset"), 0UL)
  assert_eq(canonical_load().length(), 256)
}

///|
test "cover review follows actual PRE ordinal retirement and preserves full packet identity" {
  let base : Map[String, String] = Map([])
  for
    name in [
      "lc_clock", "lc_reset", "lc_dc_outstanding", "lc_dc_watch", "lc_dc_admit",
      "lc_descriptor_valid", "lc_descriptor_ready", "lc_dc_post_reset_edges", "lc_dc_retire",
      "lc_dc_active", "lc_dc_ordinal_retire", "lc_dc_ordinal_history", "lc_dc_watched_retirement_cover",
      "lc_completion_valid", "lc_completion_ready", "lc_dc_older", "lc_dc_age", "lc_completion_fault",
    ] {
    base[name] = "0"
  }
  for
    premise in [
      "initial_only_reset", "host_descriptor_stable", "host_owned_success_response",
      "host_response_stable", "host_request_ready_r2", "host_response_offer_h2",
      "host_completion_ready_c2",
    ] {
    base["lc_dc_" + premise] = "1"
  }
  base["lc_dc_packet"] = canonical_load()
  base["lc_dc_saved_packet"] = canonical_load()
  base["lc_completion_id"] = bits64(73UL)[32:].to_owned()
  base["lc_dc_checked_deadline"] = bits64(11718UL)
  let frames = Array::makei(6, _ => copy_values(base))
  frames[0]["lc_reset"] = "1"
  for index in [1, 3, 5] {
    frames[index]["lc_clock"] = "1"
  }
  for
    name in [
      "lc_dc_watch", "lc_dc_admit", "lc_descriptor_valid", "lc_descriptor_ready",
    ] {
    frames[2][name] = "1"
  }
  for
    name in [
      "lc_dc_outstanding", "lc_dc_retire", "lc_dc_active", "lc_dc_ordinal_retire",
      "lc_dc_ordinal_history", "lc_dc_watched_retirement_cover", "lc_completion_valid",
      "lc_completion_ready", "lc_dc_age",
    ] {
    frames[4][name] = "1"
  }
  assert_true(
    retirement_witness(frames).contains("ORDINAL-RETIREMENT frame4 age1"),
  )
  // Same public ID does not excuse a changed high descriptor lane.
  frames[4]["lc_dc_saved_packet"] = "1" + canonical_load()[1:].to_owned()
  try retirement_witness(frames) catch {
    _ => ()
  } noraise {
    _ => fail("changed saved packet must fail")
  }
  frames[4]["lc_dc_saved_packet"] = canonical_load()
  frames[4]["lc_dc_older"] = "1"
  try retirement_witness(frames) catch {
    _ => ()
  } noraise {
    _ => fail("older retirement must not satisfy watch")
  }
}

///|
test "useful witness addresses reject high-bit aliases and unaligned words" {
  for address in [256UL, 383UL, 512UL, 639UL] {
    assert_true(useful_address(false, address))
  }
  for address in [1024UL, 1276UL] {
    assert_true(useful_address(true, address))
  }
  for address in [0x80000100UL, 0xffffffffUL, 384UL, 640UL] {
    assert_false(useful_address(false, address))
  }
  for address in [0x80000400UL, 0xffffffffUL, 1025UL, 1280UL] {
    assert_false(useful_address(true, address))
  }
}

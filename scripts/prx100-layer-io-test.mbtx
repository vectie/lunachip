    #|finish_io;require {[array size objects]==0} {Pool cleanup leak};close $groups;close $controls
    #|puts PRX100_LAYER_IO_TEST_PASS
  @fs.write_file(root + "/test.tcl", tcl + "\n", create_mode=CreateNew)
  let code = @shell.Cmd(
    "tclsh",
    ["test.tcl"],
    cwd=root,
    stdout=ToFile(root + "/test.stdout"),
    stderr=ToFile(root + "/test.stderr"),
  ).status()
  @fs.write_file(
    root + "/exit.txt",
    code.to_string() + "\n",
    create_mode=CreateNew,
  )
  assert_eq(code, 0, msg=@fs.read_file(root + "/test.stderr").text())
  assert_true(
    @fs.read_file(root + "/test.stdout")
    .text()
    .contains("PRX100_LAYER_IO_TEST_PASS"),
  )
  println(@fs.read_file(root + "/result.txt").text())

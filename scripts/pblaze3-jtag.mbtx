///|
async fn fresh(path : String) -> String {
  guard !@fs.exists(path) else { fail("evidence path already exists: " + path) }
  @fs.mkdir(path, recursive=true)
  @fs.realpath(path)
}

///|
async fn write(path : String, value : &@io.Data) -> Unit {
  @fs.write_file(path, value, create_mode=CreateNew)
}

///|
async fn prepare(
  mode : String,
  vivado : String,
  server : String,
  root : String,
  target : String,
  device : String,
  id : String,
  bit : String,
  expected_version : String,
  provenance : Json,
) -> Array[String] {
  guard clean(server) && @fs.can_execute(vivado) else {
    fail("expected executable Vivado path and nonempty server URL")
  }
  let launcher = @fs.realpath(vivado)
  let driver = @fs.realpath("scripts/pblaze3-jtag.mbtx")
  let identity : Json = {
    "mode": mode,
    "vivado": launcher,
    "launcher_sha256": sha(@fs.read_file(launcher).binary()),
    "server": server,
    "driver": driver,
    "driver_sha256": sha(@fs.read_file(driver).binary()),
    "expected_part": "xc7k325t",
    "target": target,
    "device": device,
    "idcode": id,
    "provenance": provenance,
  }
  write(root + "/identity.json", identity.stringify(indent=2))
  write(root + "/hardware.tcl", hardware_tcl + "\n")
  let arguments = ["-mode", "batch", "-notrace"]
  arguments.append(["-source", root + "/hardware.tcl"])
  arguments.append(["-log", root + "/vivado.log"])
  arguments.append(["-journal", root + "/vivado.jou", "-tclargs"])
  arguments.append([mode, server, root + "/inventory.tsv"])
  arguments.append([target, device, id, bit, expected_version])
  let command : Json = {
    "program": launcher,
    "arguments": arguments,
    "cwd": root,
  }
  write(root + "/command.json", command.stringify(indent=2))
  arguments
}

///|
async fn execute(
  vivado : String,
  args : Array[String],
  root : String,
  mode : String,
) -> Unit {
  errdefer write(
    root + "/exception.txt",
    "Vivado invocation failed or timed out; inspect retained logs.\n",
  )
  let status = @shell.Cmd(
    vivado,
    args,
    cwd=root,
    stdout=ToFile(root + "/stdout.log"),
    stderr=ToFile(root + "/stderr.log"),
  ).status(timeout_ms=300000)
  write(root + "/exit.txt", status.to_string() + "\n")
  guard status == 0 &&
    @fs.read_file(root + "/stdout.log")
    .text()
    .replace_all(old="\r\n", new="\n")
    .split("\n")
    .filter(line => line == "PBLAZE3_JTAG_COMPLETE=" + mode)
    .count() ==
    1 else {
    fail("Vivado did not complete " + mode)
  }
  let result : Json = {
    "mode": mode,
    "identity_sha256": sha(@fs.read_file(root + "/identity.json").binary()),
    "inventory_sha256": if mode == "probe" {
      sha(@fs.read_file(root + "/inventory.tsv").binary())
    } else {
      ""
    },
    "version_sha256": sha(@fs.read_file(root + "/version.txt").binary()),
  }
  write(root + "/complete.json", result.stringify(indent=2))
}

///|
async fn program(
  mode : String,
  discovery : String,
  target : String,
  device : String,
  bit : String,
  expected : String,
  output : String,
) -> Unit {
  guard expected.length() == 64 &&
    expected.iter().all(c => c is ('0'..<='9' | 'a'..<='f')) else {
    fail("expected lowercase SHA256 must contain 64 hex digits")
  }
  let probe = @fs.realpath(discovery)
  let identity = @fs.read_file(probe + "/identity.json")
  let pin : Pin = @json.from_json(@json.parse(identity.text()))
  let receipt : Receipt = @json.from_json(
    @json.parse(@fs.read_file(probe + "/complete.json").text()),
  )
  let inventory = @fs.read_file(probe + "/inventory.tsv")
  let version = @fs.read_file(probe + "/version.txt")
  guard receipt.mode == "probe" &&
    sha(identity.binary()) == receipt.identity_sha256 &&
    sha(inventory.binary()) == receipt.inventory_sha256 &&
    sha(version.binary()) == receipt.version_sha256 else {
    fail("discovery is incomplete or evidence changed")
  }
  guard sha(@fs.read_file(pin.vivado).binary()) == pin.launcher_sha256 else {
    fail("Vivado launcher changed since discovery")
  }
  let id = selected(inventory.text(), target, device)
  let source = @fs.realpath(bit)
  let bytes = @fs.read_file(source).binary()
  guard source.has_suffix(".bit") &&
    bytes.length() > 0 &&
    sha(bytes) == expected else {
    fail("bitstream path or SHA256 mismatch")
  }
  let root = fresh(output)
  write(root + "/selected.bit", bytes)
  let provenance : Json = {
    "discovery": probe,
    "inventory_sha256": receipt.inventory_sha256,
    "source_bitstream": source,
    "bitstream_sha256": expected,
  }
  let args = prepare(
    "program",
    pin.vivado,
    pin.server,
    root,
    target,
    device,
    id,
    root + "/selected.bit",
    version.text(),
    provenance,
  )
  if mode == "program" {
    execute(pin.vivado, args, root, "program")
  }
  println(root)
}

///|

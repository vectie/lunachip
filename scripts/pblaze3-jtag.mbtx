  #|source $source

///|
async fn self_test(output : String) -> Unit {
  let root = fresh(output)
  write(root + "/hardware.tcl", hardware_tcl + "\n")
  write(root + "/stub.tcl", stub_tcl + "\n")
  write(root + "/dummy.bit", b"offline-test-only")
  let inventory = "target\tdevice\tpart\tidcode\ncable-A\txc7k325t_0\txc7k325t\t03651093\n"
  assert_eq(selected(inventory, "cable-A", "xc7k325t_0"), "03651093")
  for
    (text, target, device) in [
      (inventory, "cable-*", "xc7k325t_0"),
      (inventory, "cable-A", "xc7k325t_1"),
      (
        inventory + "cable-A\txc7k325t_1\txc7k325t\t03651093\n",
        "cable-A",
        "xc7k325t_0",
      ),
      (
        "target\tdevice\tpart\tidcode\ncable-A\txc7k325t_0\txc7a100t\t03651093\n",
        "cable-A", "xc7k325t_0",
      ),
    ] {
    let rejected = try {
      ignore(selected(text, target, device))
      false
    } catch {
      _ => true
    }
    assert_true(rejected)
  }
  for
    scenario in [
      "good", "no-target", "duplicate-target", "no-device", "multiple-device", "renamed-device",
      "wrong-part", "wrong-id", "bad-done", "crc", "wildcard-target", "wrong-version",
      "missing-bit",
    ] {
    let directory = fresh(root + "/" + scenario)
    let test_bit = root +
      (if scenario == "missing-bit" { "/missing.bit" } else { "/dummy.bit" })
    let target = if scenario == "wildcard-target" {
      "cable-*"
    } else {
      "cable-A"
    }
    let version = if scenario == "wrong-version" {
      "changed"
    } else {
      "stub-2025.2"
    }
    let args = [root + "/stub.tcl", scenario, root + "/hardware.tcl"]
    args.append(["program", "localhost:3121", directory + "/inventory.tsv"])
    args.append([target, "xc7k325t_0", "03651093", test_bit, version])
    let result = @shell.Cmd("/usr/bin/tclsh", args).output(timeout_ms=10000)
    write(directory + "/stdout.log", result.stdout())
    write(directory + "/stderr.log", result.stderr())
    assert_eq(result.exit_code() == 0, scenario == "good")
    assert_eq(
      result.stdout().contains("STUB_PROGRAM_CALLED"),
      scenario == "good" || scenario == "bad-done" || scenario == "crc",
    )
  }
  let probe = fresh(root + "/probe")
  let probe_args = [root + "/stub.tcl", "good", root + "/hardware.tcl"]
  probe_args.append(["probe", "localhost:3121", probe + "/inventory.tsv"])
  probe_args.append(["", "", "", "", ""])
  let result = @shell.Cmd("/usr/bin/tclsh", probe_args).output(timeout_ms=10000)
  result.check()
  write(probe + "/stdout.log", result.stdout())
  write(probe + "/stderr.log", result.stderr())
  assert_false(result.stdout().contains("STUB_PROGRAM_CALLED"))
  assert_eq(
    selected(
      @fs.read_file(probe + "/inventory.tsv").text(),
      "cable-B",
      "xc7k325t_0",
    ),
    "03651093",
  )
  let identity : Json = {
    "vivado": "/usr/bin/tclsh",
    "launcher_sha256": sha(@fs.read_file("/usr/bin/tclsh").binary()),
    "server": "offline-stub:3121",
  }
  write(probe + "/identity.json", identity.stringify())
  let receipt : Json = {
    "mode": "probe",
    "identity_sha256": sha(@fs.read_file(probe + "/identity.json").binary()),
    "inventory_sha256": sha(@fs.read_file(probe + "/inventory.tsv").binary()),
    "version_sha256": sha(@fs.read_file(probe + "/version.txt").binary()),
  }
  write(probe + "/complete.json", receipt.stringify())
  let digest = sha(@fs.read_file(root + "/dummy.bit").binary())
  program(
    "plan-program",
    probe,
    "cable-B",
    "xc7k325t_0",
    root + "/dummy.bit",
    digest,
    root + "/plan",
  )
  assert_eq(sha(@fs.read_file(root + "/plan/selected.bit").binary()), digest)
  assert_false(@fs.exists(root + "/plan/complete.json"))
  for
    (path, expected, destination) in [
      (root + "/dummy.bit", "0".repeat(64), root + "/bad-hash"),
      (root + "/missing.bit", digest, root + "/bad-source"),
      (root + "/dummy.bit", digest, root + "/plan"),
    ] {
    let rejected = try {
      program(
        "plan-program", probe, "cable-B", "xc7k325t_0", path, expected, destination,
      )
      false
    } catch {
      _ => true
    }
    assert_true(rejected)
  }
  write(
    root + "/PASS.txt",
    "Offline only: 4 rejected inventory selections; 13 Tcl program cases; read-only discovery; full plan generation; wrong hash, missing source and existing evidence rejection. No hardware accessed.\n",
  )
  println(root)
}

///|
async fn main {
  match @env.args()[1:] {
    ["self-test", output] => self_test(output)
    ["probe" | "plan-probe" as mode, vivado, server, output] => {
      let root = fresh(output)
      let args = prepare("probe", vivado, server, root, "", "", "", "", "", {})
      if mode == "probe" {
        execute(@fs.realpath(vivado), args, root, "probe")
      }
      println(root)
    }
    [
      "program"
      | "plan-program" as mode,
      discovery,
      target,
      device,
      bit,
      hash,
      output,
    ] => program(mode, discovery, target, device, bit, hash, output)
    _ =>
      fail(
        "Run from repository root. Usage: [plan-]probe VIVADO SERVER NEW_DIR | [plan-]program PROBE_DIR EXACT_TARGET EXACT_DEVICE BIT EXPECTED_SHA256 NEW_DIR | self-test NEW_DIR",
      )
  }
}

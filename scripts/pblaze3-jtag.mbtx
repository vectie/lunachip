///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/io",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
struct Pin {
  vivado : String
  launcher_sha256 : String
  server : String
} derive(FromJson)

///|
struct Receipt {
  mode : String
  identity_sha256 : String
  inventory_sha256 : String
  version_sha256 : String
} derive(FromJson)

///|
fn sha(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
fn clean(value : String) -> Bool {
  !value.is_empty() && value.iter().all(c => c >= ' ' && c != '\u{7f}')
}

///|
fn selected(
  inventory : String,
  target : String,
  device : String,
) -> String raise {
  guard clean(target) && clean(device) else { fail("invalid target/device") }
  let rows = inventory.split("\n").filter(s => !s.is_empty()).to_array()
  guard rows.length() > 1 && rows[0] == "target\tdevice\tpart\tidcode" else {
    fail("invalid or empty discovery inventory")
  }
  let devices : Array[Array[String]] = []
  for row in rows[1:] {
    let fields = row.split("\t").map(s => s.to_owned()).to_array()
    guard fields.length() == 4 && fields.all(clean) else {
      fail("malformed discovery row")
    }
    if fields[0] == target {
      devices.push(fields)
    }
  }
  guard devices is [one] && one[1] == device && one[2] == "xc7k325t" else {
    fail(
      "selection requires exactly one discovered xc7k325t on the exact target",
    )
  }
  let id = one[3]
  guard id.length() == 8 && id.iter().all(c => c is ('0'..<='9' | 'a'..<='f')) else {
    fail("discovered IDCODE must be eight lowercase hex digits")
  }
  id
}


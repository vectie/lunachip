///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args()[1:] is [root] && !@fs.exists(root + "/model-inputs") else {
    fail("OPEN_CAMPAIGN")
  }
  @fs.mkdir(root + "/model-inputs")
  @fs.mkdir(root + "/model-metadata")
  let model = "/Users/kq/Workspace/lunaflux/_build/models/qwen3-0.6b-c1899de"
  for name in ["config.json", "tokenizer.json"] {
    @fs.write_file(
      root + "/model-metadata/" + name,
      @fs.read_file(model + "/" + name).binary(),
      create_mode=CreateNew,
    )
  }
  @fs.write_file(
    root + "/model-inputs/device-contract.json",
    @fs.read_file(model + "/device-contract.json").binary(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/model-inputs/qualification-fixture.json",
    @fs.read_file(
      "artifacts/pblaze3-full-qwen-20261029-a1/qualification-fixture.json",
    ).binary(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/model-inputs/source.txt",
    "Qwen/Qwen3-0.6B revision c1899de289a04d12100db370d81485cdf75e47ca. Supplied association label, not payload checksum. Existing remote checkpoint is read by bounded approved ranges; no copied checkpoint in evidence. Qualification reuses prior sealed full-Qwen campaign's combined34-descriptor fixture.\n",
    create_mode=CreateNew,
  )
}

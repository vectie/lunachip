    #|foreach {file marker} {diagnostic-bd.txt {XVC_AXI_BAR_OFFSET=0x40000 SUBSYSTEM_DEVICE=7a33} diagnostic-routed.txt PBLAZE3_ILA_ROUTED_GUARD_COMPLETE} {

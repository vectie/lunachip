///|
async fn main {
  if @env.args()[1:] is ["program-tcl", path] {
    write_program_script(path)
    return
  }
  if @env.args()[1:] is ["capture-tcl", path] {
    write_capture_script(path)
    return
  }
  guard @env.args()[1:] is [input, out] && !@fs.exists(out) else {
    fail("DDR_XDMA_ILA_INPUTS FRESH_OUTPUT")
  }
  @shell.Cmd("sha256sum", ["--quiet", "-c", "SHA256SUMS"], cwd=input).run()
  guard @json.parse(@fs.read_file(input + "/board.json").text())
    is Object(board) &&
    board.get("mode") == Some("ddr-xdma-ila") &&
    board.get("part") == Some("xc7k325tffg900-2") else {
    fail("expected the PBlaze3 DDR XDMA ILA bundle")
  }
  let fabric =
    #|  ip debug_control xilinx.com:ip:axi_interconnect:2.1 {CONFIG.NUM_SI 1 CONFIG.NUM_MI 2}
    #|  ip debug_axi xilinx.com:ip:debug_bridge:3.0 {CONFIG.C_DEBUG_MODE 2 CONFIG.C_TCK_CLOCK_RATIO 32}
    #|  bus xdma/M_AXI_LITE debug_control/S00_AXI
    #|  bus debug_control/M00_AXI gpio/S_AXI
    #|  bus debug_control/M01_AXI debug_axi/S_AXI
    #|  wire xdma/axi_aclk debug_control/ACLK debug_control/S00_ACLK debug_control/M00_ACLK debug_control/M01_ACLK debug_axi/s_axi_aclk
    #|  wire xdma/axi_aresetn debug_control/ARESETN debug_control/S00_ARESETN debug_control/M00_ARESETN debug_control/M01_ARESETN debug_axi/s_axi_aresetn

  let address =
    #|set debug_space [get_bd_addr_spaces xdma/M_AXI_LITE]
    #|assign_bd_address -offset 0x40040000 -range 4K -target_address_space $debug_space [get_bd_addr_segs debug_axi/S_AXI/Reg0]
    #|set debug_seg [get_bd_addr_segs -of_objects $debug_space -filter {NAME =~ "*debug_axi*"}]
    #|if {[llength $debug_seg]!=1 || [expr {wide([get_property OFFSET $debug_seg])}]!=0x40040000} {error "XVC address mapping"}
    #|if {[get_property CONFIG.C_DEBUG_MODE [get_bd_cells debug_axi]]!=2} {error "XVC bridge mode"}
    #|if {[get_property CONFIG.C_TCK_CLOCK_RATIO [get_bd_cells debug_axi]]!=32} {error "XVC clock divider"}
    #|if {[get_property CONFIG.pf0_subsystem_id [get_bd_cells xdma]] ne "7A33"} {error "XVC subsystem identity"}
    #|puts $diagnostic_report "XVC_AXI_BAR_OFFSET=0x40000 SUBSYSTEM_DEVICE=7a33"
    #|puts $diagnostic_report "XVC_TCK_DIV=32 AXI_HZ=250000000 HUB_HZ=50000000"
    #|close $diagnostic_report
    #|validate_bd_design

  let mut tcl = @fs.read_file(input + "/build.tcl").text()
  tcl = replace_once(tcl, "  bus xdma/M_AXI_LITE gpio/S_AXI", fabric)
  tcl = replace_once(
    tcl, "CONFIG.pf0_device_id 7024", "CONFIG.pf0_device_id 7024 CONFIG.pf0_subsystem_id 7A33",
  )
  tcl = replace_once(
    tcl, "close $diagnostic_report\nvalidate_bd_design", address,
  )
  let rows = StringBuilder()
  let mut peers = 0
  for line in tcl.split("\n") {
    let mut row = line.to_owned()
    if row.trim().has_prefix("{ila_xdma250.ctrl_") {
      row = replace_once(row, " gpio s_axi_", " debug_control S00_AXI_")
      if row.contains("addr ") {
        row = replace_once(row, "32 9}", "32 32}")
      }
      peers += 1
    }
    rows.write_string(row + "\n")
  }
  guard peers == 17 else {
    fail("unexpected AXI-Lite probe count " + peers.to_string())
  }
  // Copy the verified bundle members. The input may also contain tool caches.
  @fs.mkdir(out)
  for line in @fs.read_file(input + "/SHA256SUMS").text().split("\n") {
    if line.trim().is_empty() {
      continue
    }
    guard line.split_once("  ") is Some((_, name)) &&
      !name.contains("/") &&
      !name.contains("..") else {
      fail("invalid input inventory")
    }
    let file = name.to_owned()
    if file != "build.tcl" && file != "board.json" {
      @fs.write_file(
        out + "/" + file,
        @fs.read_file(input + "/" + file).binary(),
        create_mode=CreateNew,
      )
    }
  }
  board["mode"] = "ddr-xdma-ila-xvc"
  board["pcie_subsystem_device"] = "0x7a33"
  board["xvc_bar_offset"] = 262144
  @fs.write_file(out + "/board.json", Json::object(board).stringify(indent=2))
  @fs.write_file(out + "/build.tcl", rows.to_string())
  let manifest = StringBuilder()
  for f in @fs.readdir(out, sort=true) {
    let hash = @crypto.bytes_to_hex_string(
      @crypto.sha256(@fs.read_file(out + "/" + f).binary()),
    )
    manifest.write_string(hash + "  " + f + "\n")
  }
  @fs.write_file(out + "/SHA256SUMS", manifest.to_string())
}

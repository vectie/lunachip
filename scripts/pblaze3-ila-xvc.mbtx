///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.1/crypto",
}

///|
fn replace_once(source : String, old : String, new : String) -> String raise {
  guard source.split(old).count() == 2 else {
    fail("missing or repeated " + old)
  }
  source.replace(old~, new~)
}


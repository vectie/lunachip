{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunachip.dev/schema/verilator-harness-v1.json",
  "title": "LunaChip generated Verilator harness bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "top_module",
    "sources",
    "harness_cpp",
    "stimulus",
    "result",
    "clock",
    "reset",
    "ports"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "lunachip.verilator-harness/v1" },
    "top_module": { "$ref": "#/$defs/identifier" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safePath" }
    },
    "harness_cpp": { "$ref": "#/$defs/safePath" },
    "stimulus": { "$ref": "#/$defs/safePath" },
    "result": { "$ref": "#/$defs/safePath" },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "edge"],
      "properties": {
        "port": { "$ref": "#/$defs/identifier" },
        "edge": { "const": "rising" }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "active", "timing"],
      "properties": {
        "port": { "$ref": "#/$defs/identifier" },
        "active": { "const": "high" },
        "timing": { "const": "synchronous" }
      }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/port" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "width", "signed"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["input", "output"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 64 },
        "signed": { "type": "boolean" }
      }
    }
  }
}

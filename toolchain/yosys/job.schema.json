{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunachip.dev/schema/yosys-job-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "top_module", "sources", "formal_tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "lunachip.yosys-job/v1" },
    "top_module": { "$ref": "#/$defs/identifier" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/source" }
    },
    "formal_tasks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "claim", "bound", "timeout_seconds", "engine", "solver", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$" },
        "mode": { "enum": ["bmc", "prove", "cover"] },
        "claim": { "enum": ["bounded-safety-up-to-bound", "unbounded-safety-if-base-and-induction-pass", "reachability-within-bound"] },
        "bound": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "engine": { "const": "smtbmc" },
        "solver": { "const": "bitwuzla" },
        "expect": { "enum": ["pass", "fail"] }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "bmc" } } }, "then": { "properties": { "claim": { "const": "bounded-safety-up-to-bound" } } } },
        { "if": { "properties": { "mode": { "const": "prove" } } }, "then": { "properties": { "claim": { "const": "unbounded-safety-if-base-and-induction-pass" } } } },
        { "if": { "properties": { "mode": { "const": "cover" } } }, "then": { "properties": { "claim": { "const": "reachability-within-bound" } } } }
      ]
    }
  }
}

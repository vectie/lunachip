  },
  "policy": {
    "synthesis": {
      "yosys_flags": ["-Q", "-T", "-e", ".*"],
      "read_flags": ["-sv", "-noautowire"],
      "commands": [
        "hierarchy -check -top <top>",
        "proc",
        "memory -nomap",
        "check -assert",
        "write_rtlil /out/pre-map.rtlil",
        "stat",
        "synth -top <top> -flatten -latches error",
        "check -assert",
        "write_json /out/netlist.json",
        "write_verilog -noattr -noexpr -nodec /out/netlist.v"
      ]
    },
    "formal": {
      "engine": "smtbmc",
      "solver": "bitwuzla",
      "multiclock": true,
      "yosys_warning_policy": "logger -werror .*",
      "modes": ["bmc", "prove", "cover"],
      "maximum_bound": 100000,
      "maximum_timeout_seconds": 3600
    },
    "isolation": {
      "network": "none",
      "read_only_root": true,
      "drop_capabilities": "ALL",
      "no_new_privileges": true,
      "pids_limit": 512
    },
    "forbidden": ["mutable-image-reference", "provider-fallback", "networked-execution", "warning-waiver", "host-tool-execution"]
  }
}

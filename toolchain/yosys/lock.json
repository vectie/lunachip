    },
    "solver": {
      "name": "bitwuzla",
      "version": "0.9.1",
      "expected_version_fragment": "0.9.1",
      "archive_url": "https://github.com/bitwuzla/bitwuzla/releases/download/0.9.1/Bitwuzla-Linux-x86_64-static.zip",

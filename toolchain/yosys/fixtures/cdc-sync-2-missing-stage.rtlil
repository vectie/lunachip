module \sync2
  wire input 1 \clk
  wire input 2 \source
  wire \stage0
  wire \stage1
  wire output 3 \synchronized
  cell $dff \stage0_cell
    parameter \CLK_POLARITY 1'1
    parameter \WIDTH 1
    connect \CLK \clk
    connect \D \source
    connect \Q \stage0
  end
  connect \synchronized \stage0
end
